    .hero-art:before { content:""; position:absolute; width:230px; height:330px; right:16%; top:8%; border-radius:45% 45% 12% 12%; background:linear-gradient(90deg,#1d1e1a,#77705e 48%,#272821); transform:rotate(8deg); box-shadow:0 15px 45px #0008; }
