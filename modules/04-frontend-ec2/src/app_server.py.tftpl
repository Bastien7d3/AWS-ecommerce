<script>
const CATS = {
  tous: 'Tout',
  visage: 'Visage',
  barbe: 'Barbe',
  corps: 'Corps',
  parfums: 'Parfums'
};

const COLORS = {
  visage: '#FFB4C8',
  barbe: '#FFC857',
  corps: '#9C8CFF',
  parfums: '#7EDCC5'
};

const CFG = window.APP_CONFIG || {};
const $ = id => document.getElementById(id);
const eur = v => Number(v || 0).toLocaleString('fr-FR', {
  style: 'currency', currency: 'EUR'
});
const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({
  '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;'
}[c]));

let products = [];
let cat = 'tous';
let cart = {};
let pool = null;
let token = sessionStorage.getItem('jwt_token');
let authEmail = sessionStorage.getItem('user_email');

try {
  cart = JSON.parse(localStorage.getItem('neolia_cart') || '{}') || {};
} catch (_) {
  cart = {};
}

function notify(message) {
  $('toast').textContent = message;
  $('toast').classList.add('visible');
  window.setTimeout(() => $('toast').classList.remove('visible'), 4500);
}

function bottle(category) {
  const color = COLORS[category] || '#FFB4C8';
  const shape = category === 'parfums'
    ? `<rect x="30" y="43" width="60" height="91" rx="10" fill="$${color}"/>
       <rect x="48" y="24" width="24" height="21" rx="3" fill="#34265F"/>
       <rect x="41" y="15" width="38" height="11" rx="3" fill="#FFD166"/>`
    : category === 'corps'
    ? `<path d="M35 135 L38 39 Q60 29 82 39 L85 135 Z" fill="$${color}"/>
       <rect x="46" y="17" width="28" height="25" rx="4" fill="#34265F"/>`
    : category === 'barbe'
    ? `<rect x="35" y="49" width="50" height="86" rx="8" fill="$${color}"/>
       <rect x="49" y="29" width="22" height="23" rx="3" fill="#34265F"/>
       <ellipse cx="60" cy="20" rx="10" ry="10" fill="#FFD166"/>`
    : `<rect x="30" y="43" width="60" height="92" rx="10" fill="$${color}"/>
       <rect x="49" y="20" width="22" height="25" rx="4" fill="#34265F"/>
       <rect x="43" y="12" width="34" height="10" rx="3" fill="#FFD166"/>`;

  return `<svg viewBox="0 0 120 150" aria-hidden="true">
    <ellipse cx="60" cy="140" rx="39" ry="5" fill="#34265F" opacity=".12"/>
    $${shape}
    <rect x="36" y="76" width="48" height="28" rx="3" fill="#FFF9F5" opacity=".86"/>
    <text x="60" y="88" text-anchor="middle" font-size="6" font-weight="bold" fill="#34265F">NÉOLIA</text>
    <text x="60" y="97" text-anchor="middle" font-size="5" fill="#34265F">ESSENTIEL</text>
  </svg>`;
}

function renderFilters() {
  $('filters').innerHTML = Object.entries(CATS).map(([key, label]) =>
    `<button type="button" data-c="$${key}" aria-pressed="$${key === cat}">$${label}</button>`
  ).join('');

  document.querySelectorAll('#filters button').forEach(button => {
    button.addEventListener('click', () => {
      cat = button.dataset.c;
      renderFilters();
      renderProducts();
    });
  });
}

function renderProducts() {
  const list = products.filter(p =>
    cat === 'tous' || String(p.category || p.categorie || '').toLowerCase() === cat
  );

  $('grid').innerHTML = list.length
    ? list.map(p => {
        const category = String(p.category || p.categorie || '').toLowerCase();
        const available = Number(p.stock || 0) > 0;

        return `<article class="prod">
          <div class="pic" style="--product-color:$${COLORS[category] || '#FFB4C8'}">
            $${bottle(category)}
            <span class="category-tag">$${esc(CATS[category] || 'Collection')}</span>
          </div>
          <div class="prod-body">
            <h3>$${esc(p.name || 'Produit NÉOLIA')}</h3>
            <p class="desc">$${esc(p.description || 'Un essentiel pour votre routine quotidienne.')}</p>
            <p class="stock $${available ? 'available' : 'unavailable'}">
              $${available ? 'En stock' : 'Épuisé'}
            </p>
            <div class="product-bottom">
              <span class="price">$${eur(p.price_eur)}</span>
              <button type="button" data-id="$${esc(p.product_id)}" $${available ? '' : 'disabled'}>
                Ajouter
              </button>
            </div>
          </div>
        </article>`;
      }).join('')
    : '<p class="empty">Aucun produit dans cette catégorie.</p>';

  document.querySelectorAll('#grid button[data-id]').forEach(button => {
    button.addEventListener('click', () => add(button.dataset.id));
  });
}

async function loadProducts() {
  const response = await fetch('/api/products', { cache: 'no-store' });
  if (!response.ok) throw new Error('Impossible de charger le catalogue.');
  products = await response.json();
  renderProducts();
  renderCart();
}

function saveCart() {
  localStorage.setItem('neolia_cart', JSON.stringify(cart));
  renderCart();
}

function add(id) {
  const product = products.find(p => p.product_id === id);
  if (!product) return;

  const quantity = Number(cart[id] || 0);
  if (quantity >= Number(product.stock || 0)) {
    notify('Stock maximal atteint pour ce produit.');
    return;
  }

  cart[id] = quantity + 1;
  saveCart();
  notify(product.name + ' ajouté au panier.');
}

function change(id, delta) {
  const product = products.find(p => p.product_id === id);
  const quantity = Number(cart[id] || 0) + delta;

  if (quantity <= 0) {
    delete cart[id];
  } else if (product && quantity <= Number(product.stock || 0)) {
    cart[id] = quantity;
  } else {
    notify('La quantité demandée dépasse le stock disponible.');
    return;
  }

  saveCart();
}

function renderCart() {
  const rows = Object.entries(cart).filter(([id, quantity]) =>
    Number(quantity) > 0 && products.some(p => p.product_id === id)
  );

  let total = 0;
  let count = 0;

  $('lines').innerHTML = rows.length
    ? rows.map(([id, quantity]) => {
        const p = products.find(x => x.product_id === id);
        const subtotal = Number(p.price_eur || 0) * Number(quantity);
        total += subtotal;
        count += Number(quantity);

        return `<div class="line">
          <div>
            <strong>$${esc(p.name)}</strong>
            <small>$${eur(p.price_eur)} l'unité</small>
          </div>
          <div class="qty">
            <button type="button" class="quantity" data-d="-1" data-id="$${esc(id)}" aria-label="Retirer un">−</button>
            <span>$${quantity}</span>
            <button type="button" class="quantity" data-d="1" data-id="$${esc(id)}" aria-label="Ajouter un">+</button>
          </div>
          <strong class="subtotal">$${eur(subtotal)}</strong>
        </div>`;
      }).join('')
    : '<p class="empty">Votre panier est vide. Découvrez les essentiels NÉOLIA.</p>';

  document.querySelectorAll('#lines button[data-id]').forEach(button => {
    button.addEventListener('click', () =>
      change(button.dataset.id, Number(button.dataset.d))
    );
  });

  $('total').textContent = eur(total);
  $('count').textContent = count;
  $('order').disabled = rows.length === 0;
}

$('clear').addEventListener('click', () => {
  cart = {};
  saveCart();
});

function updateCheckoutAuthState() {
  const status = $('auth-status');
  const link = $('auth-prompt-link') || (document.querySelector('.account-prompt a'));
  if (!status) return;

  const displayName = sessionStorage.getItem('user_name') || localStorage.getItem('neolia_customer_name') || (authEmail && authEmail.includes('@') ? authEmail.split('@')[0] : authEmail);

  if (token && authEmail) {
    const emailDisplay = authEmail.includes('@') ? ' (' + esc(authEmail) + ')' : '';
    status.innerHTML = 'Connecté en tant que <strong>' + esc(displayName) + '</strong>' + emailDisplay + '. Votre panier est conservé.';
    if (link) link.style.display = 'none';
  } else {
    status.textContent = 'Vous pouvez remplir votre panier sans compte. Connectez-vous au moment de commander.';
    if (link) link.style.display = 'inline-block';
  }
}

function clearAppSession() {
  sessionStorage.removeItem('jwt_token');
  sessionStorage.removeItem('user_email');
  sessionStorage.removeItem('user_name');
  sessionStorage.removeItem('user_is_admin');
  token = null;
  authEmail = null;
}

function renderHeaderAuth(isLoggedIn, userName, isAdmin) {
  const nav = $('main-nav');
  if (!nav) return;

  const displayName = userName || authEmail || 'Mon compte';

  let html = '<a href="#collection">Collection</a>' +
             '<a href="#panier">Panier (<span id="count">0</span>)</a>';

  if (isAdmin) {
    html += '<a href="/admin" class="nav-admin-badge" title="Espace Administrateur">👑 Administration</a>';
  }

  if (isLoggedIn) {
    html += '<a href="/account" class="nav-user-badge" title="Connecté : ' + esc(displayName) + '">' +
            '<span class="nav-user-icon">👤</span>' +
            '<strong class="nav-user-name">' + esc(displayName) + '</strong>' +
            '</a>' +
            '<a href="/account">Mon compte</a>' +
            '<a href="#" id="nav-logout">Déconnexion</a>';
  } else {
    html += '<a href="/login">Connexion</a>';
  }

  nav.innerHTML = html;

  const logoutLink = $('nav-logout');
  if (logoutLink) {
    logoutLink.addEventListener('click', logoutAndRedirect);
  }

  const countEl = $('count');
  if (countEl) {
    const totalQty = Object.values(cart).reduce((a, b) => a + b, 0);
    countEl.textContent = totalQty;
  }
}

function logoutAndRedirect(event) {
  if (event) event.preventDefault();

  try {
    if (pool) {
      const currentUser = pool.getCurrentUser();
      if (currentUser) currentUser.signOut();
    }
  } catch (error) {
    console.error('Erreur lors de la déconnexion Cognito :', error);
  }

  clearAppSession();
  window.location.replace('/');
}

function initAuthUI() {
  let storedToken = sessionStorage.getItem('jwt_token');
  let storedEmail = sessionStorage.getItem('user_email');
  let storedName = sessionStorage.getItem('user_name') || localStorage.getItem('neolia_customer_name');
  let storedIsAdmin = sessionStorage.getItem('user_is_admin') === 'true';

  if (storedToken && window.parseJwt) {
    try {
      const p = window.parseJwt(storedToken);
      if (p) {
        if (p.email) {
          storedEmail = p.email;
          sessionStorage.setItem('user_email', p.email);
        }
        if (p.name) {
          storedName = p.name;
          sessionStorage.setItem('user_name', p.name);
        } else if (p.given_name) {
          storedName = (p.given_name + ' ' + (p.family_name || '')).trim();
          sessionStorage.setItem('user_name', storedName);
        }
        const groups = p['cognito:groups'] || [];
        if (Array.isArray(groups) && groups.includes('admin')) {
          storedIsAdmin = true;
          sessionStorage.setItem('user_is_admin', 'true');
        }
      }
    } catch (_) {}
  }

  if (storedToken && storedEmail) {
    token = storedToken;
    authEmail = storedEmail;
    storedName = storedName || (storedEmail.includes('@') ? storedEmail.split('@')[0] : storedEmail);
    renderHeaderAuth(true, storedName, storedIsAdmin);
    updateCheckoutAuthState();
    const nameInput = $('name');
    if (nameInput && (!nameInput.value || nameInput.value.includes('-')) && storedName) {
      nameInput.value = storedName;
    }
  } else {
    renderHeaderAuth(false);
  }

  if (
    !CFG.auth ||
    typeof AmazonCognitoIdentity === 'undefined'
  ) {
    if (!storedToken) {
      clearAppSession();
      updateCheckoutAuthState();
    }
    return;
  }

  try {
    pool = new AmazonCognitoIdentity.CognitoUserPool({
      UserPoolId: CFG.userPoolId,
      ClientId: CFG.userPoolClientId
    });

    const currentUser = pool.getCurrentUser();

    if (!currentUser) {
      if (!storedToken) {
        clearAppSession();
        renderHeaderAuth(false);
        updateCheckoutAuthState();
      }
      return;
    }

    currentUser.getSession((error, session) => {
      if (error || !session || !session.isValid()) {
        currentUser.signOut();
        clearAppSession();
        renderHeaderAuth(false);
        updateCheckoutAuthState();
        return;
      }

      token = session.getIdToken().getJwtToken();
      let realEmail = null;
      let uName = storedName;
      let isAdmin = false;

      try {
        const payload = session.getIdToken().decodePayload();
        if (payload) {
          if (payload.email) realEmail = payload.email;
          if (payload.name) uName = payload.name;
          else if (payload.given_name) uName = (payload.given_name + ' ' + (payload.family_name || '')).trim();
          if (payload.address) localStorage.setItem('neolia_customer_address', payload.address);
          const groups = payload['cognito:groups'] || [];
          if (Array.isArray(groups) && groups.includes('admin')) {
            isAdmin = true;
          }
        }
      } catch (_) {}

      authEmail = realEmail || (storedEmail && storedEmail.includes('@') ? storedEmail : currentUser.getUsername());
      uName = uName || (authEmail.includes('@') ? authEmail.split('@')[0] : authEmail);

      sessionStorage.setItem('jwt_token', token);
      sessionStorage.setItem('user_email', authEmail);
      sessionStorage.setItem('user_name', uName);
      sessionStorage.setItem('user_is_admin', isAdmin ? 'true' : 'false');
      localStorage.setItem('neolia_customer_name', uName);

      renderHeaderAuth(true, uName, isAdmin);
      updateCheckoutAuthState();
      renderCart();

      const nameInput = $('name');
      if (nameInput && (!nameInput.value || nameInput.value.includes('-')) && uName) {
        nameInput.value = uName;
      }
    });
  } catch (err) {
    console.error('Erreur initAuthUI :', err);
  }
}

initAuthUI();


$('order').addEventListener('click', async () => {
  $('err').textContent = '';

  if (!token) {
    window.location.href = '/login?next=checkout';
    return;
  }

  let email = authEmail || sessionStorage.getItem('user_email');
  if (!email || !email.includes('@')) {
    try {
      const p = window.parseJwt ? window.parseJwt(token) : null;
      if (p && p.email) email = p.email;
    } catch (_) {}
  }

  const nameInput = $('name');
  let name = (nameInput ? nameInput.value.trim() : '') ||
             sessionStorage.getItem('user_name') ||
             localStorage.getItem('neolia_customer_name');

  if (!name && email && email.includes('@')) {
    name = email.split('@')[0];
  }

  if (nameInput && !nameInput.value && name) {
    nameInput.value = name;
  }

  if (name) {
    sessionStorage.setItem('user_name', name);
    localStorage.setItem('neolia_customer_name', name);
  }

  if (!name) {
    $('err').textContent = 'Indiquez votre nom pour finaliser la commande.';
    if (nameInput) nameInput.focus();
    return;
  }

  const items = Object.entries(cart)
    .filter(([, quantity]) => Number(quantity) > 0)
    .map(([product_id, qty]) => ({
      product_id,
      qty: Number(qty)
    }));

  if (!items.length) return;

  const button = $('order');
  button.disabled = true;
  button.textContent = 'Envoi…';

  try {
    const response = await fetch('/api/order', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': 'Bearer ' + token
      },
      body: JSON.stringify({
        items,
        customer_name: name,
        customer_email: email,
        shipping_address: localStorage.getItem('neolia_customer_address') || '12 Rue de la Paix, 75002 Paris'
      })
    });

    const data = await response.json();

    if (!response.ok || data.error) {
      throw new Error(data.error || 'Commande impossible.');
    }

    $('t-ref').textContent =
      'Référence : ' + (data.order_ids || []).join(', ');

    $('thanks').classList.add('open');
    cart = {};
    saveCart();
    await loadProducts();
  } catch (error) {
    $('err').textContent = error.message;
  } finally {
    button.textContent = 'Commander';
    renderCart();
  }
});

$('t-close').addEventListener('click', () => {
  $('thanks').classList.remove('open');
});

renderFilters();
renderCart();
$('name').value =
  localStorage.getItem('neolia_customer_name') || '';

loadProducts().then(() => {
  const params = new URLSearchParams(window.location.search);

  if (params.get('next') === 'checkout') {
    $('panier').scrollIntoView({ behavior: 'smooth' });
    notify('Connexion réussie. Votre panier est conservé : cliquez sur Commander pour terminer.');
  }
}).catch(error => {
  $('grid').textContent = error.message;
});
</script>
</body>
</html>
"""
LOGIN_HTML = r"""<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>NÉOLIA — Connexion</title>
<link rel="stylesheet" href="/style.css">
<script src="/config.js"></script>
<script src="https://cdn.jsdelivr.net/npm/amazon-cognito-identity-js@6.3.6/dist/amazon-cognito-identity.min.js"></script>
</head>
<body>
<header class="top">
  <div class="wrap top-inner">
    <a class="logo" href="/">NÉOLIA<span class="logo-dot">.</span></a>
    <nav id="login-nav"><a href="/">Retour à la boutique</a></nav>
  </div>
</header>

<main class="wrap auth-main">
  <p class="section-kicker">Votre espace client</p>
  <h1>Bienvenue chez NÉOLIA.</h1>
  <p class="auth-intro">
    Connectez-vous pour commander ou créez votre compte.
    Votre panier est conservé pendant cette étape.
  </p>

  <div class="auth-layout">
    <section class="auth-card">
      <h2>Connexion</h2>
      <form id="login-form">
        <label for="login-email">E-mail</label>
        <input id="login-email" type="email" autocomplete="username" required>

        <label for="login-password">Mot de passe</label>
        <input id="login-password" type="password" autocomplete="current-password" required>

        <button type="submit" id="login-button">Se connecter</button>
        <p class="err" id="login-err" role="alert" style="display:none;"></p>
        <p class="status" id="login-status" role="status"></p>
      </form>
    </section>

    <section class="auth-card">
      <h2>Créer un compte</h2>
      <form id="register-form">
        <label for="register-prenom">Prénom</label>
        <input id="register-prenom" type="text" autocomplete="given-name" required>

        <label for="register-nom">Nom</label>
        <input id="register-nom" type="text" autocomplete="family-name" required>

        <label for="register-email">Adresse e-mail</label>
        <input id="register-email" type="email" autocomplete="email" required>

        <label for="register-address">Adresse postale</label>
        <input id="register-address" type="text" autocomplete="street-address" placeholder="12 Rue de la Paix, 75002 Paris" required>

        <label for="register-password">Mot de passe</label>
        <input id="register-password" type="password"
               autocomplete="new-password" minlength="8" required>

        <button type="submit" id="register-button">Créer mon compte</button>
        <p class="err" id="register-err" role="alert" style="display:none;"></p>
        <p class="status" id="register-status" role="status"></p>
      </form>

      <div id="confirm-panel" hidden>
        <h3>Confirmer l'inscription</h3>
        <p class="status">
          Saisissez le code reçu par e-mail pour activer votre compte.
        </p>
        <label for="confirm-code">Code de confirmation (6 chiffres)</label>
        <input id="confirm-code" autocomplete="one-time-code" placeholder="123456">
        <div style="display:flex; gap:.6rem; margin-top:.75rem;">
          <button id="confirm-button" type="button" style="flex:1;">Confirmer mon compte</button>
          <button id="resend-button" type="button" class="ghost" style="flex:1;">Renvoyer le code</button>
        </div>
        <p class="err" id="confirm-err" role="alert" style="display:none;"></p>
        <p class="status" id="confirm-status" role="status"></p>
      </div>
    </section>
  </div>
</main>

<script>
(function () {
  const $ = id => document.getElementById(id);
  const CFG = window.APP_CONFIG || {};
  const params = new URLSearchParams(window.location.search);
  const next = params.get('next');
  let pendingEmail = '';

  const pool = new AmazonCognitoIdentity.CognitoUserPool({
    UserPoolId: CFG.userPoolId,
    ClientId: CFG.userPoolClientId
  });

  function translateCognitoError(error) {
    if (!error) return "Une erreur inconnue est survenue.";
    const code = error.code || error.name || "";
    const msg = error.message || String(error);

    if (code === 'UsernameExistsException' || msg.includes('User already exists')) {
      return "Un compte existe déjà avec cette adresse e-mail. Veuillez vous connecter ou réinitialiser votre mot de passe.";
    }
    if (code === 'InvalidPasswordException' || msg.includes('Password did not conform')) {
      return "Le mot de passe doit comporter au moins 8 caractères, dont au moins une majuscule, une minuscule et un chiffre.";
    }
    if (code === 'CodeMismatchException' || msg.includes('Invalid verification code')) {
      return "Le code de confirmation est invalide. Veuillez vérifier vos e-mails et réessayer.";
    }
    if (code === 'ExpiredCodeException' || msg.includes('expired')) {
      return "Le code de confirmation a expiré. Cliquez sur 'Renvoyer le code'.";
    }
    if (code === 'NotAuthorizedException' || msg.includes('Incorrect username or password')) {
      return "Identifiants incorrects (adresse e-mail ou mot de passe erroné).";
    }
    if (code === 'UserNotFoundException') {
      return "Aucun compte n'a été trouvé avec cette adresse e-mail.";
    }
    if (code === 'UserNotConfirmedException') {
      return "Votre compte n'est pas encore confirmé. Saisissez le code reçu par e-mail ci-dessous.";
    }
    if (code === 'TooManyRequestsException' || code === 'LimitExceededException') {
      return "Trop de tentatives. Veuillez patienter un instant avant de réessayer.";
    }
    return msg;
  }

  function setLoginErr(msg) {
    const el = $('login-err');
    if (el) { el.textContent = msg; el.style.display = msg ? 'block' : 'none'; }
    if (msg) $('login-status').textContent = '';
  }
  function setRegisterErr(msg) {
    const el = $('register-err');
    if (el) { el.textContent = msg; el.style.display = msg ? 'block' : 'none'; }
    if (msg) $('register-status').textContent = '';
  }
  function setConfirmErr(msg) {
    const el = $('confirm-err');
    if (el) { el.textContent = msg; el.style.display = msg ? 'block' : 'none'; }
    if (msg) $('confirm-status').textContent = '';
  }

  const currentUser = pool.getCurrentUser();
  if (currentUser) {
    currentUser.getSession((error, session) => {
      if (!error && session && session.isValid()) {
        const idToken = session.getIdToken();
        const token = idToken.getJwtToken();
        let email = currentUser.getUsername();
        let displayName = email;
        let isAdmin = false;

        try {
          const payload = idToken.decodePayload();
          if (payload) {
            if (payload.email) email = payload.email;
            if (payload.name) displayName = payload.name;
            else if (payload.given_name) displayName = (payload.given_name + ' ' + (payload.family_name || '')).trim();
            if (payload.address) localStorage.setItem('neolia_customer_address', payload.address);
            const groups = payload['cognito:groups'] || [];
            if (Array.isArray(groups) && groups.includes('admin')) {
              isAdmin = true;
            }
          }
        } catch (_) {}

        displayName = displayName || localStorage.getItem('neolia_customer_name') || email;
        sessionStorage.setItem('jwt_token', token);
        sessionStorage.setItem('user_email', email);
        sessionStorage.setItem('user_name', displayName);
        sessionStorage.setItem('user_is_admin', isAdmin ? 'true' : 'false');
        if (displayName) localStorage.setItem('neolia_customer_name', displayName);

        const destination = next === 'checkout'
          ? '/?next=checkout#panier'
          : (next === 'admin' ? '/admin' : '/account');

        window.location.replace(destination);
      }
    });
  }

  function afterLogin(result, email) {
    const idToken = result.getIdToken();
    const token = idToken.getJwtToken();
    let displayName = email;
    let isAdmin = false;
    let realEmail = email;

    try {
      const payload = idToken.decodePayload();
      if (payload) {
        if (payload.email) realEmail = payload.email;
        if (payload.name) displayName = payload.name;
        else if (payload.given_name) displayName = (payload.given_name + ' ' + (payload.family_name || '')).trim();
        if (payload.address) localStorage.setItem('neolia_customer_address', payload.address);
        const groups = payload['cognito:groups'] || [];
        if (Array.isArray(groups) && groups.includes('admin')) {
          isAdmin = true;
        }
      }
    } catch (_) {}

    displayName = displayName || localStorage.getItem('neolia_customer_name') || realEmail;

    sessionStorage.setItem('jwt_token', token);
    sessionStorage.setItem('user_email', realEmail);
    sessionStorage.setItem('user_name', displayName);
    sessionStorage.setItem('user_is_admin', isAdmin ? 'true' : 'false');
    if (displayName) localStorage.setItem('neolia_customer_name', displayName);

    let destination = '/account';
    if (next === 'checkout') {
      destination = '/?next=checkout#panier';
    } else if (next === 'admin') {
      destination = '/admin';
    } else if (isAdmin && !next) {
      destination = '/admin';
    }

    window.location.href = destination;
  }

  $('login-form').addEventListener('submit', function (event) {
    event.preventDefault();
    setLoginErr('');

    const email = $('login-email').value.trim();
    const password = $('login-password').value;
    $('login-status').textContent = 'Connexion en cours…';

    const user = new AmazonCognitoIdentity.CognitoUser({
      Username: email,
      Pool: pool
    });

    user.authenticateUser(
      new AmazonCognitoIdentity.AuthenticationDetails({
        Username: email,
        Password: password
      }),
      {
        onSuccess: result => afterLogin(result, email),
        onFailure: error => {
          const frMsg = translateCognitoError(error);
          setLoginErr(frMsg);
          if (error && (error.code === 'UserNotConfirmedException' || (error.message && error.message.includes('not confirmed')))) {
            pendingEmail = email;
            $('confirm-panel').hidden = false;
            $('confirm-status').textContent = 'Votre compte n\'est pas encore confirmé. Saisissez le code reçu par e-mail.';
            $('confirm-code').focus();
          }
        }
      }
    );
  });

  $('register-form').addEventListener('submit', function (event) {
    event.preventDefault();
    setRegisterErr('');

    try {
      if (typeof AmazonCognitoIdentity === 'undefined') {
        throw new Error("Le composant Cognito n'a pas pu être chargé. Veuillez vérifier votre connexion.");
      }

      const prenom = $('register-prenom').value.trim();
      const nom = $('register-nom').value.trim();
      const fullName = `$${prenom} $${nom}`.trim();
      const email = $('register-email').value.trim();
      const address = $('register-address').value.trim();
      const password = $('register-password').value;

      if (!prenom || !nom || !email || !password) {
        setRegisterErr("Veuillez renseigner tous les champs obligatoires.");
        return;
      }

      $('register-status').textContent = 'Création du compte et envoi du code par e-mail…';
      const regBtn = $('register-button');
      if (regBtn) regBtn.disabled = true;

      const attributes = [
        new AmazonCognitoIdentity.CognitoUserAttribute({ Name: 'email', Value: email }),
        new AmazonCognitoIdentity.CognitoUserAttribute({ Name: 'name', Value: fullName }),
        new AmazonCognitoIdentity.CognitoUserAttribute({ Name: 'given_name', Value: prenom }),
        new AmazonCognitoIdentity.CognitoUserAttribute({ Name: 'family_name', Value: nom }),
        new AmazonCognitoIdentity.CognitoUserAttribute({ Name: 'address', Value: address })
      ];

      pool.signUp(email, password, attributes, null, async (error, result) => {
        if (regBtn) regBtn.disabled = false;

        if (error) {
          setRegisterErr(translateCognitoError(error));
          return;
        }

        pendingEmail = email;
        localStorage.setItem('neolia_customer_name', fullName);
        localStorage.setItem('neolia_customer_address', address);
        $('login-email').value = email;

        if (result && result.userConfirmed) {
          $('confirm-panel').hidden = true;
          $('register-status').textContent = 'Compte confirmé ! Vous pouvez vous connecter.';
          $('login-password').focus();
        } else {
          $('confirm-panel').hidden = false;
          $('register-status').textContent = 'Compte créé ! Un e-mail contenant votre code de confirmation vient d\'être envoyé à ' + email + '.';
          $('confirm-code').focus();
        }

        try {
          await fetch('/api/subscribe', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email })
          });
        } catch (_) {}
      });
    } catch (err) {
      const regBtn = $('register-button');
      if (regBtn) regBtn.disabled = false;
      setRegisterErr(err.message || String(err));
    }
  });

  $('confirm-button').addEventListener('click', function () {
    setConfirmErr('');
    const code = $('confirm-code').value.trim();

    if (!pendingEmail || !code) {
      setConfirmErr('Veuillez saisir le code reçu par e-mail.');
      return;
    }

    const user = new AmazonCognitoIdentity.CognitoUser({
      Username: pendingEmail,
      Pool: pool
    });

    $('confirm-status').textContent = 'Confirmation en cours…';

    user.confirmRegistration(code, true, error => {
      if (error) {
        setConfirmErr(translateCognitoError(error));
        return;
      }

      $('login-email').value = pendingEmail;
      $('confirm-status').textContent = 'Compte confirmé avec succès ! Vous pouvez maintenant vous connecter.';
      $('confirm-panel').hidden = true;
      $('login-password').focus();
    });
  });

  $('resend-button').addEventListener('click', function () {
    setConfirmErr('');
    const email = pendingEmail || $('register-email').value.trim() || $('login-email').value.trim();

    if (!email) {
      setConfirmErr('Veuillez renseigner votre adresse e-mail.');
      return;
    }

    const user = new AmazonCognitoIdentity.CognitoUser({
      Username: email,
      Pool: pool
    });

    $('confirm-status').textContent = 'Envoi d\'un nouveau code…';

    user.resendConfirmationCode(function (error, result) {
      if (error) {
        setConfirmErr(translateCognitoError(error));
      } else {
        $('confirm-status').textContent = 'Un nouveau code de confirmation a été envoyé à ' + email + '.';
      }
    });
  });
})();
</script>
</body>
</html>
"""
ACCOUNT_HTML = r"""<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>NÉOLIA — Mon compte</title>
<link rel="stylesheet" href="/style.css">
<script src="/config.js"></script>
<script src="https://cdn.jsdelivr.net/npm/amazon-cognito-identity-js@6.3.6/dist/amazon-cognito-identity.min.js"></script>
</head>
<body>
<header class="top">
  <div class="wrap top-inner">
    <a class="logo" href="/">NÉOLIA<span class="logo-dot">.</span></a>
    <nav id="account-nav">
      <a href="/">Boutique</a>
      <a href="#profile">Mon profil</a>
      <a href="#orders-section">Mes commandes</a>
      <span class="nav-user-badge"><span class="nav-user-icon">👤</span> <strong class="nav-user-name" id="account-nav-name">Mon compte</strong></span>
      <a href="#" id="top-logout">Déconnexion</a>
    </nav>
  </div>
</header>

<main class="wrap auth-main">
  <p class="section-kicker">Votre espace personnel</p>
  <h1>Mon compte</h1>
  <p class="auth-intro">
    Consultez vos informations et mettez à jour votre profil.
  </p>

  <section class="auth-card profile-card" id="profile">
    <h2>Mes informations</h2>
    <form id="profile-form">
      <label for="profile-email">Adresse e-mail du compte</label>
      <input id="profile-email" type="email" readonly>

      <label for="profile-prenom">Prénom</label>
      <input id="profile-prenom" type="text" autocomplete="given-name">

      <label for="profile-nom">Nom de famille</label>
      <input id="profile-nom" type="text" autocomplete="family-name">

      <label for="profile-address">Adresse postale de livraison</label>
      <input id="profile-address" type="text" autocomplete="street-address">

      <label for="profile-phone">Téléphone</label>
      <input id="profile-phone" type="tel" autocomplete="tel">

      <button type="submit" id="save-profile">Enregistrer les modifications</button>
      <p class="status" id="profile-status" role="status"></p>
    </form>

    <div class="profile-actions">
      <a class="profile-link" href="/">Retour à la boutique</a>
      <button type="button" class="ghost" id="logout">Se déconnecter</button>
    </div>
  </section>

  <section class="auth-card profile-card" id="orders-section" style="margin-top:2rem;">
    <h2>Mes commandes & statut</h2>
    <p class="auth-intro" style="margin-bottom:1rem;">Suivez la préparation et l'expédition de vos colis en temps réel.</p>
    <div id="orders-list">
      <p class="status">Chargement de vos commandes en cours…</p>
    </div>
  </section>
</main>

<script>
(function () {
  const $ = id => document.getElementById(id);
  const CFG = window.APP_CONFIG || {};

  const pool = new AmazonCognitoIdentity.CognitoUserPool({
    UserPoolId: CFG.userPoolId,
    ClientId: CFG.userPoolClientId
  });

  const currentUser = pool.getCurrentUser();
  let email = sessionStorage.getItem('user_email');
  let token = sessionStorage.getItem('jwt_token');

  function clearSessionAndRedirect() {
    if (currentUser) {
      try { currentUser.signOut(); } catch (_) {}
    }
    sessionStorage.removeItem('jwt_token');
    sessionStorage.removeItem('user_email');
    sessionStorage.removeItem('user_name');
    sessionStorage.removeItem('user_is_admin');
    window.location.replace('/login');
  }

  // Si pas de session Cognito en local et aucun token/email en sessionStorage
  if (!currentUser && (!email || !token)) {
    clearSessionAndRedirect();
    return;
  }

  if (token && (!email || !email.includes('@')) && window.parseJwt) {
    try {
      const p = window.parseJwt(token);
      if (p && p.email) {
        email = p.email;
        sessionStorage.setItem('user_email', email);
      }
    } catch (_) {}
  }

  let displayName = sessionStorage.getItem('user_name') || localStorage.getItem('neolia_customer_name') || email || 'Mon compte';
  const navNameEl = $('account-nav-name');
  if (navNameEl && displayName) navNameEl.textContent = displayName;

  const isAdminStored = sessionStorage.getItem('user_is_admin') === 'true';
  if (isAdminStored && $('account-nav') && !$('account-nav-admin')) {
    const adminLink = document.createElement('a');
    adminLink.id = 'account-nav-admin';
    adminLink.className = 'nav-admin-badge';
    adminLink.href = '/admin';
    adminLink.textContent = '👑 Administration';
    const navUserEl = navNameEl ? navNameEl.closest('.nav-user-badge') : null;
    if (navUserEl) $('account-nav').insertBefore(adminLink, navUserEl);
  }

  let availableAttributes = {};

  function showError(message) {
    $('profile-status').textContent = message;
  }

  if (currentUser) {
    currentUser.getSession((error, session) => {
      if (error || !session || !session.isValid()) {
        clearSessionAndRedirect();
        return;
      }

      token = session.getIdToken().getJwtToken();
      sessionStorage.setItem('jwt_token', token);

      try {
        const payload = session.getIdToken().decodePayload();
        if (payload) {
          if (payload.email) {
            email = payload.email;
            sessionStorage.setItem('user_email', email);
          }
          if (payload.name) {
            displayName = payload.name;
            sessionStorage.setItem('user_name', displayName);
          } else if (payload.given_name) {
            displayName = (payload.given_name + ' ' + (payload.family_name || '')).trim();
            sessionStorage.setItem('user_name', displayName);
          }
          if (payload.address) {
            localStorage.setItem('neolia_customer_address', payload.address);
          }
          const groups = payload['cognito:groups'] || [];
          if (Array.isArray(groups) && groups.includes('admin')) {
            sessionStorage.setItem('user_is_admin', 'true');
            if ($('account-nav') && !$('account-nav-admin')) {
              const adminLink = document.createElement('a');
              adminLink.id = 'account-nav-admin';
              adminLink.className = 'nav-admin-badge';
              adminLink.href = '/admin';
              adminLink.textContent = '👑 Administration';
              const navUserEl = navNameEl ? navNameEl.closest('.nav-user-badge') : null;
              if (navUserEl) $('account-nav').insertBefore(adminLink, navUserEl);
            }
          }
        }
      } catch (_) {}

      displayName = displayName || email;
      if (displayName && navNameEl) {
        navNameEl.textContent = displayName;
      }

      currentUser.getUserAttributes((attributeError, attributes) => {
        if (attributeError) {
          showError(attributeError.message);
          return;
        }

        availableAttributes = {};
        (attributes || []).forEach(attribute => {
          availableAttributes[attribute.getName()] = attribute.getValue();
        });

        $('profile-email').value = availableAttributes.email || email || '';
        $('profile-prenom').value = availableAttributes.given_name || '';
        $('profile-nom').value = availableAttributes.family_name || '';
        $('profile-address').value = availableAttributes.address || '';
        $('profile-phone').value = availableAttributes.phone_number || '';

        if (availableAttributes.email) {
          email = availableAttributes.email;
          sessionStorage.setItem('user_email', email);
        }
        if (availableAttributes.address) {
          localStorage.setItem('neolia_customer_address', availableAttributes.address);
        }

        const fullName = (availableAttributes.given_name ? (availableAttributes.given_name + ' ' + (availableAttributes.family_name || '')) : availableAttributes.name) || '';
        if (fullName) {
          const cleanName = fullName.trim();
          localStorage.setItem('neolia_customer_name', cleanName);
          sessionStorage.setItem('user_name', cleanName);
          if (navNameEl) navNameEl.textContent = cleanName;
        }
      });

      loadUserOrders();
    });
  } else {
    if (email) $('profile-email').value = email;
    loadUserOrders();
  }

  $('profile-form').addEventListener('submit', event => {
    event.preventDefault();

    if (!currentUser) {
      showError('Session expirée. Veuillez vous reconnecter.');
      return;
    }

    const prenom = $('profile-prenom').value.trim();
    const nom = $('profile-nom').value.trim();
    const address = $('profile-address').value.trim();
    const phone = $('profile-phone').value.trim();
    const fullName = `$${prenom} $${nom}`.trim();

    const attributes = [];
    if (fullName) attributes.push(new AmazonCognitoIdentity.CognitoUserAttribute({ Name: 'name', Value: fullName }));
    if (prenom) attributes.push(new AmazonCognitoIdentity.CognitoUserAttribute({ Name: 'given_name', Value: prenom }));
    if (nom) attributes.push(new AmazonCognitoIdentity.CognitoUserAttribute({ Name: 'family_name', Value: nom }));
    if (address) attributes.push(new AmazonCognitoIdentity.CognitoUserAttribute({ Name: 'address', Value: address }));
    if (phone) attributes.push(new AmazonCognitoIdentity.CognitoUserAttribute({ Name: 'phone_number', Value: phone }));

    $('save-profile').disabled = true;
    showError('Enregistrement en cours…');

    currentUser.updateAttributes(attributes, error => {
      $('save-profile').disabled = false;

      if (error) {
        showError(
          'Impossible de modifier le profil : ' + error.message +
          '. Vérifiez que ces attributs sont modifiables dans Cognito.'
        );
        return;
      }

      localStorage.setItem('neolia_customer_name', fullName);
      availableAttributes.name = fullName;

      if (phone) {
        availableAttributes.phone_number = phone;
      }

      showError('Vos informations ont bien été mises à jour.');
    });
  });

  function doSignOut() {
    clearSessionAndRedirect();
  }

  $('logout').addEventListener('click', doSignOut);
  const topLogoutBtn = $('top-logout');
  if (topLogoutBtn) topLogoutBtn.addEventListener('click', e => { e.preventDefault(); doSignOut(); });

  const eur = v => Number(v || 0).toLocaleString('fr-FR', {style:'currency', currency:'EUR'});
  const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));

  async function loadUserOrders() {
    try {
      const emailToUse = email || sessionStorage.getItem('user_email') || '';
      const tokenToUse = token || sessionStorage.getItem('jwt_token') || '';
      const headers = {};
      if (tokenToUse) headers['Authorization'] = 'Bearer ' + tokenToUse;

      const resp = await fetch('/api/user/orders?email=' + encodeURIComponent(emailToUse), {
        headers: headers,
        cache: 'no-store'
      });
      if (!resp.ok) {
        $('orders-list').innerHTML = '<p class="status">Impossible de charger l\'historique des commandes.</p>';
        return;
      }
      const data = await resp.json();
      const orders = data.orders || (Array.isArray(data) ? data : []);
      if (!orders.length) {
        $('orders-list').innerHTML = '<p class="status">Vous n\'avez pas encore passé de commande sur NÉOLIA.</p>';
        return;
      }
      $('orders-list').innerHTML = orders.map(o => {
        const isShipped = o.status === 'SHIPPED';
        const tagClass = isShipped ? 'shipped' : 'pending';
        const tagLabel = isShipped ? 'Expédiée' : 'En attente du batch Spot';
        return `<div class="order-item" style="border:1px solid rgba(255,255,255,0.08); border-radius:10px; padding:1.2rem; margin-bottom:1rem; background:rgba(255,255,255,0.02);">
          <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.5rem;">
            <strong>Commande $${esc(o.order_id)}</strong>
            <span class="tag $${tagClass}">$${tagLabel}</span>
          </div>
          <p style="margin:0.4rem 0; font-size:0.88rem; color:#a5a5b5;">Enregistrée le : $${esc(o.created_at || '-')}</p>
          <p style="margin:0.4rem 0;">$${esc(o.product_summary || '-')} $${o.total_eur !== undefined ? '— <strong>'+eur(o.total_eur)+'</strong>' : ''}</p>
          $${o.tracking_number ? '<p style="margin:0.3rem 0; font-size:0.85rem; color:#7EDCC5;">📦 Colis expédié : <strong>'+esc(o.tracking_number)+'</strong> (Carton '+esc(o.box_size || 'M')+')</p>' : ''}
          $${o.pdf_url ? '<p style="margin-top:0.6rem;"><a href="'+esc(o.pdf_url)+'" target="_blank" rel="noopener" style="color:#FFB4C8; text-decoration:underline; font-weight:600;">📄 Télécharger la facture PDF</a></p>' : ''}
        </div>`;
      }).join('');
    } catch (_) {
      $('orders-list').innerHTML = '<p class="status">Erreur de connexion lors du chargement des commandes.</p>';
    }
  }

  loadUserOrders();

  window.goToCart = function (event) {
    event.preventDefault();
    window.location.href = '/#panier';
    return false;
  };
})();
</script>
</body>
</html>
"""
# ----------------------------------------------------------------------
# ADMINISTRATION NÉOLIA
# ----------------------------------------------------------------------

ADMIN_HTML = r"""<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>NÉOLIA — Administration</title>
<link rel="stylesheet" href="/style.css">
<script src="/config.js"></script>
<script src="https://cdn.jsdelivr.net/npm/amazon-cognito-identity-js@6.3.6/dist/amazon-cognito-identity.min.js"></script>
</head>
<body>
<header class="top">
  <div class="wrap top-inner">
    <a class="logo" href="/">NÉOLIA<span class="logo-dot">.</span> <span class="admin-mark">ADMIN</span></a>
    <nav id="admin-nav"><a href="/">Voir la boutique</a></nav>
  </div>
</header>

<div id="admin-gate-loading" style="text-align:center; padding:5rem 1.5rem;">
  <p class="status">Vérification de vos droits d'accès administrateur en cours…</p>
</div>

<div id="admin-gate-denied" class="wrap" hidden style="max-width:540px; margin:4rem auto; text-align:center;">
  <div class="auth-card" style="padding:2.5rem 2rem; box-shadow:0 12px 35px #25213b10;">
    <div style="font-size:3.5rem; margin-bottom:1rem;">⛔</div>
    <h2 style="margin-bottom:.75rem; color:var(--ink);">Accès Administrateur Restreint</h2>
    <p id="denied-reason" style="margin-bottom:1.5rem; color:var(--muted); font-size:.95rem; line-height:1.6;">
      Cette page est strictement réservée aux utilisateurs connectés et appartenant au groupe Cognito <code>admin</code>.
    </p>
    <div style="display:flex; gap:.75rem; justify-content:center; flex-wrap:wrap;">
      <a href="/" class="cta" style="text-decoration:none;">Retourner à la boutique</a>
      <a href="/login?next=admin" id="btn-login-admin" class="ghost" style="display:inline-flex; align-items:center; text-decoration:none; padding:.75rem 1.25rem; border-radius:999px;">Se connecter</a>
    </div>
  </div>
</div>

<main class="wrap admin-main" id="admin-dashboard" hidden>
  <div class="section-head">
    <div><p class="section-kicker">Pilotage</p><h1>Tableau de bord</h1></div>
    <button type="button" class="ghost" id="refresh">Actualiser</button>
  </div>

  <section class="stats">
    <article class="stat"><b id="s-total">0</b><span>Commandes</span></article>
    <article class="stat"><b id="s-pending">0</b><span>À expédier</span></article>
    <article class="stat"><b id="s-shipped">0</b><span>Expédiées</span></article>
    <article class="stat" id="revenue-box"><b id="s-revenue">0 €</b><span>Chiffre d'affaires</span></article>
  </section>

  <section class="panel" id="spot" hidden>
    <div class="section-head">
      <div><p class="section-kicker">Infrastructure</p><h2>Traitement par lot EC2 Spot</h2></div>
      <button id="spot-btn" type="button">Lancer une instance</button>
    </div>
    <p id="spot-status">Chargement de l'état de la file…</p>
    <p id="infra" class="status"></p>
  </section>

  <section class="panel">
    <div class="section-head">
      <div><p class="section-kicker">Suivi des ventes</p><h2>Toutes les commandes</h2></div>
    </div>
    <div class="table-wrap">
      <table>
        <thead><tr>
          <th>Commande</th><th>Client</th><th>Articles</th>
          <th>Statut</th><th>Expédition</th><th>Facture</th>
        </tr></thead>
        <tbody id="body"><tr><td colspan="6">Chargement…</td></tr></tbody>
      </table>
    </div>
  </section>
</main>

<div class="toast" id="toast" role="status"></div>

<script>
const CFG = window.APP_CONFIG || {};
const $ = id => document.getElementById(id);
const eur = v => Number(v || 0).toLocaleString('fr-FR', {
  style:'currency', currency:'EUR'
});
const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({
  '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;'
}[c]));

let adminUserToken = '';
let adminUserEmail = '';

function notify(message) {
  $('toast').textContent = message;
  $('toast').classList.add('visible');
  window.setTimeout(() => $('toast').classList.remove('visible'), 4500);
}

function logoutAndRedirect() {
  try {
    if (typeof AmazonCognitoIdentity !== 'undefined' && CFG.userPoolId && CFG.userPoolClientId) {
      const p = new AmazonCognitoIdentity.CognitoUserPool({
        UserPoolId: CFG.userPoolId,
        ClientId: CFG.userPoolClientId
      });
      const cu = p.getCurrentUser();
      if (cu) cu.signOut();
    }
  } catch (_) {}
  sessionStorage.removeItem('jwt_token');
  sessionStorage.removeItem('user_email');
  sessionStorage.removeItem('user_name');
  sessionStorage.removeItem('user_is_admin');
  window.location.replace('/login?next=admin');
}

async function verifyAdminAccess() {
  const token = sessionStorage.getItem('jwt_token');
  const email = sessionStorage.getItem('user_email');
  let displayName = sessionStorage.getItem('user_name') || email;

  function showDenied(htmlReason, isNotLoggedIn) {
    $('admin-gate-loading').hidden = true;
    $('admin-dashboard').hidden = true;
    $('admin-gate-denied').hidden = false;
    $('denied-reason').innerHTML = htmlReason;
    const btn = $('btn-login-admin');
    if (btn) {
      if (isNotLoggedIn) {
        btn.textContent = 'Se connecter';
        btn.href = '/login?next=admin';
        btn.onclick = null;
      } else {
        btn.textContent = 'Changer de compte';
        btn.href = '#';
        btn.onclick = (e) => {
          e.preventDefault();
          logoutAndRedirect();
        };
      }
    }
  }

  if (!token || !email) {
    showDenied("Vous n'êtes pas connecté. Vous devez vous identifier avec un compte membre du groupe Cognito <code>admin</code>.", true);
    return false;
  }

  let isAdmin = false;
  if (window.parseJwt) {
    try {
      const payload = window.parseJwt(token);
      if (payload) {
        if (payload.name) displayName = payload.name;
        else if (payload.given_name) displayName = (payload.given_name + ' ' + (payload.family_name || '')).trim();
        const groups = payload['cognito:groups'] || [];
        if (Array.isArray(groups) && groups.includes('admin')) {
          isAdmin = true;
        }
      }
    } catch (_) {}
  }

  try {
    const res = await fetch('/api/admin/check?email=' + encodeURIComponent(email), {
      headers: { 'Authorization': 'Bearer ' + token },
      cache: 'no-store'
    });
    if (res.ok) {
      const data = await res.json();
      if (data && data.status === 'SUCCESS') {
        isAdmin = !!data.is_admin;
      }
    }
  } catch (e) {
    console.warn('Vérification serveur admin :', e);
  }

  displayName = displayName || email;

  if (!isAdmin) {
    showDenied("Le compte <strong>" + esc(displayName) + "</strong> (" + esc(email) + ") est connecté mais n'appartient pas au groupe Cognito <code>admin</code>.", false);
    return false;
  }

  adminUserEmail = email;
  adminUserToken = token;
  sessionStorage.setItem('user_name', displayName);
  sessionStorage.setItem('user_is_admin', 'true');

  $('admin-gate-loading').hidden = true;
  $('admin-gate-denied').hidden = true;
  $('admin-dashboard').hidden = false;

  const nav = $('admin-nav');
  if (nav) {
    nav.innerHTML =
      '<span class="nav-user-badge nav-admin-badge" title="Connecté en tant qu\'administrateur">' +
      '<span class="nav-user-icon">👑</span> <strong class="nav-user-name">' + esc(displayName) + '</strong> <small>(Admin)</small></span> ' +
      '<a href="/">Voir la boutique</a> ' +
      '<a href="#" id="admin-logout">Déconnexion</a>';

    const logoutBtn = $('admin-logout');
    if (logoutBtn) {
      logoutBtn.addEventListener('click', (e) => {
        e.preventDefault();
        logoutAndRedirect();
      });
    }
  }

  return true;
}

async function load() {
  const headers = {};
  if (adminUserToken) {
    headers['Authorization'] = 'Bearer ' + adminUserToken;
  }

  const response = await fetch('/api/orders', { headers, cache: 'no-store' });
  if (response.status === 403) {
    throw new Error('Accès interdit : privilèges administrateur requis.');
  }
  if (!response.ok) throw new Error('Impossible de charger les commandes.');

  const orders = await response.json();
  const shipped = orders.filter(o => o.status === 'SHIPPED').length;
  const hasTotal = orders.some(o => o.total_eur !== undefined);

  $('s-total').textContent = orders.length;
  $('s-shipped').textContent = shipped;
  $('s-pending').textContent = orders.length - shipped;
  $('revenue-box').hidden = !hasTotal;
  $('s-revenue').textContent = eur(
    orders.reduce((sum, o) => sum + Number(o.total_eur || 0), 0)
  );

  $('body').innerHTML = orders.length
    ? orders.map(o => `<tr>
        <td><strong>$${esc(o.order_id)}</strong><br>
          <small>$${esc((o.created_at || '').replace('T',' ').slice(0,16))}</small></td>
        <td>$${esc(o.customer_name || '-')}<br>
          <small>$${esc(o.customer_email || '')}</small></td>
        <td>$${esc(o.product_summary || '-')}
          $${o.total_eur !== undefined ? '<br><small>'+eur(o.total_eur)+'</small>' : ''}</td>
        <td><span class="tag $${o.status === 'SHIPPED' ? 'shipped' : 'pending'}">
          $${o.status === 'SHIPPED' ? 'Expédiée' : 'En attente'}
        </span></td>
        <td>$${o.carrier_box ? esc(o.carrier_box) : 'Traitement en attente'}
          $${o.tracking_number ? '<br><small>Suivi : '+esc(o.tracking_number)+'</small>' : ''}
        </td>
        <td>$${o.pdf_url
          ? '<a href="'+esc(o.pdf_url)+'" target="_blank" rel="noopener">Ouvrir la facture</a>'
          : '—'}
        </td>
      </tr>`).join('')
    : '<tr><td colspan="6">Aucune commande pour le moment.</td></tr>';
}

async function loadSpot() {
  const headers = {};
  if (adminUserToken) {
    headers['Authorization'] = 'Bearer ' + adminUserToken;
  }
  const response = await fetch('/api/spot-status', { headers, cache: 'no-store' });
  if (!response.ok) throw new Error('Impossible de lire le statut Spot.');

  const data = await response.json();
  $('spot-status').textContent =
    'Messages SQS en attente : ' + data.sqs_pending +
    '. Instances Spot : ' +
    (data.spot_instances.length
      ? data.spot_instances.map(i => i.id + ' (' + i.state + ')').join(', ')
      : 'aucune instance active');
}

verifyAdminAccess().then(isAuthorized => {
  if (!isAuthorized) return;

  load().catch(error => notify(error.message));
  window.setInterval(() => load().catch(() => {}), 10000);

  if (CFG.spot) {
    $('spot').hidden = false;

    fetch('/api/info', {cache:'no-store'})
      .then(response => response.json())
      .then(data => {
        $('infra').textContent =
          'Serveur : ' + data.instance + ' — région ' + data.region +
          ' — Launch Template ' + data.launch_template;
      })
      .catch(() => {});

    $('spot-btn').addEventListener('click', async () => {
      const button = $('spot-btn');
      button.disabled = true;

      try {
        const response = await fetch('/api/launch-spot', {
          method:'POST',
          headers:{
            'Content-Type':'application/json',
            'Authorization':'Bearer ' + adminUserToken
          },
          body:'{}'
        });
        const data = await response.json();

        if (!response.ok || data.error) throw new Error(data.error || 'Échec du lancement.');

        notify('Instance ' + data.instance_id + ' lancée (' + data.mode + ').');
        await loadSpot();
      } catch (error) {
        notify(error.message);
      } finally {
        button.disabled = false;
      }
    });

    loadSpot().catch(error => notify(error.message));
    window.setInterval(() => loadSpot().catch(() => {}), 5000);
  }

  $('refresh').addEventListener('click', () => {
    load().catch(error => notify(error.message));
  });
});
</script>
</body>
</html>
"""


# ----------------------------------------------------------------------
# STYLE NÉOLIA
# ----------------------------------------------------------------------

STYLE_CSS = r"""
:root {
  --ink:#25213B;
  --muted:#716B83;
  --paper:#FFF9F5;
  --white:#FFFFFF;
  --line:#F0E5E8;
  --pink:#FF6F91;
  --pink-light:#FFE0E8;
  --orange:#FF9F68;
  --yellow:#FFD166;
  --purple:#8C78FF;
  --mint:#7EDCC5;
  --blue:#8ED8F8;
  --green:#267B65;
  --red:#C83F60;
}
* { box-sizing:border-box; margin:0; padding:0; }
html { scroll-behavior:smooth; scroll-padding-top:90px; }
body {
  font-family:'DM Sans',system-ui,sans-serif;
  background:var(--paper);
  color:var(--ink);
  line-height:1.6;
}
h1,h2,h3,.logo,.stat b {
  font-family:'Manrope',system-ui,sans-serif;
  letter-spacing:-.045em;
}
a { color:inherit; }
button,input { font:inherit; }
button {
  border:0; border-radius:999px; padding:.75rem 1.1rem;
  background:var(--ink); color:#fff; font-weight:700;
  cursor:pointer; transition:transform .2s,background .2s,box-shadow .2s;
}
button:hover { background:var(--purple); transform:translateY(-1px); box-shadow:0 7px 20px #8c78ff33; }
button:disabled { opacity:.45; cursor:not-allowed; transform:none; box-shadow:none; }
button.ghost {
  background:#fff; color:var(--ink); border:1px solid var(--line);
}
button.ghost:hover { background:var(--pink-light); border-color:var(--pink); }
input {
  width:100%; padding:.75rem .85rem; border:1px solid var(--line);
  background:#fff; border-radius:12px; color:var(--ink);
}
input:focus { outline:3px solid #8c78ff30; border-color:var(--purple); }
label { display:block; font-size:.82rem; font-weight:700; color:var(--muted); margin:.8rem 0 .25rem; }
.wrap { max-width:1240px; margin:0 auto; padding:0 1.5rem; }

.top {
  position:sticky; top:0; z-index:5;
  background:#fff9f5ed; backdrop-filter:blur(16px);
  border-bottom:1px solid var(--line);
}
.top-inner { display:flex; justify-content:space-between; align-items:center; gap:1rem; padding-top:1rem; padding-bottom:1rem; }
.logo { font-size:1.65rem; font-weight:800; letter-spacing:-.075em; text-decoration:none; white-space:nowrap; }
.logo-dot { color:var(--pink); }
.admin-mark { font:700 .65rem 'DM Sans',sans-serif; color:var(--purple); letter-spacing:.13em; }
nav { display:flex; align-items:center; gap:1.3rem; flex-wrap:wrap; }
nav a { color:var(--muted); text-decoration:none; font-size:.9rem; font-weight:700; }
nav a:hover { color:var(--pink); }

.hero {
  overflow:hidden; color:#fff;
  background:linear-gradient(125deg,#34265F 0%,#6D4AE8 55%,#A77CFF 100%);
  border-radius:0 0 34px 34px; position:relative; isolation:isolate;
}
.hero:before {
  content:""; position:absolute; z-index:-1; width:350px; height:350px;
  border-radius:50%; background:var(--pink); opacity:.75;
  right:4%; top:-230px;
}
.hero:after {
  content:""; position:absolute; z-index:-1; width:220px; height:220px;
  border-radius:50%; background:var(--yellow); opacity:.8;
  right:32%; bottom:-170px;
}
.hero-inner { display:grid; grid-template-columns:1.2fr .8fr; align-items:center; gap:2rem; padding-top:4.7rem; padding-bottom:4.7rem; }
.eyebrow,.section-kicker {
  color:var(--pink); font-weight:800; text-transform:uppercase;
  letter-spacing:.18em; font-size:.73rem;
}
.hero .eyebrow { color:#FFD8E2; margin-bottom:1rem; }
.hero h1 { font-size:clamp(2.8rem,6vw,5.2rem); line-height:1.02; font-weight:800; max-width:11ch; }
.hero-intro { color:#F2ECFF; max-width:44ch; margin:1.35rem 0 1.7rem; font-size:1.05rem; }
.cta {
  display:inline-flex; gap:.8rem; align-items:center; text-decoration:none;
  background:var(--yellow); color:#34265F; padding:.95rem 1.35rem;
  border-radius:999px; font-weight:800; box-shadow:0 8px 24px #271c4e40;
}
.cta:hover { transform:translateY(-2px); }
.hero-art { min-width:0; }
.hero-art svg { display:block; width:100%; max-height:340px; filter:drop-shadow(0 15px 15px #21134033); }
.art-caption { display:block; text-align:center; color:#F2ECFF; font-size:.78rem; margin-top:.8rem; letter-spacing:.08em; }

.main-layout { display:grid; grid-template-columns:minmax(0,1fr) 340px; gap:2rem; align-items:start; padding-top:3rem; padding-bottom:4rem; }
.section-head { display:flex; justify-content:space-between; align-items:end; gap:1rem; margin-bottom:1.4rem; }
.section-head h1,.section-head h2 { font-size:2rem; line-height:1.2; }
.section-kicker { margin-bottom:.35rem; color:var(--purple); }
.collection-note { color:var(--muted); font-size:.9rem; }
.filters { display:flex; gap:.55rem; flex-wrap:wrap; margin-bottom:1.4rem; }
.filters button { background:#fff; color:var(--muted); border:1px solid var(--line); }
.filters button[aria-pressed="true"] { background:var(--ink); color:white; border-color:var(--ink); }
.grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(205px,1fr)); gap:1rem; }
.prod {
  overflow:hidden; display:flex; flex-direction:column;
  background:#fff; border:1px solid var(--line); border-radius:22px;
  box-shadow:0 5px 20px #32234b07; transition:transform .22s,box-shadow .22s;
}
.prod:hover { transform:translateY(-4px); box-shadow:0 14px 30px #32234b12; }
.pic {
  height:180px; display:flex; align-items:center; justify-content:center;
  position:relative; overflow:hidden; background:var(--product-color,#FFB4C8);
}
.pic:before { content:""; position:absolute; width:150px; height:150px; border-radius:50%; background:#ffffff69; top:14px; }
.pic svg { position:relative; z-index:1; height:150px; width:120px; filter:drop-shadow(0 8px 8px #32234b15); }
.category-tag { position:absolute; bottom:10px; left:10px; background:#fffdf0dd; padding:.2rem .6rem; border-radius:999px; font-size:.68rem; font-weight:800; }
.prod-body { padding:1.1rem; display:flex; flex:1; flex-direction:column; gap:.45rem; }
.prod h3 { font-size:1.1rem; line-height:1.3; }
.desc { color:var(--muted); font-size:.88rem; flex:1; }
.stock { font-size:.78rem; font-weight:700; }
.available { color:var(--green); }
.unavailable { color:var(--red); }
.product-bottom { display:flex; align-items:center; justify-content:space-between; gap:.5rem; margin-top:.65rem; }
.price { font-size:1.05rem; font-weight:800; white-space:nowrap; }
.product-bottom button { font-size:.82rem; padding:.62rem .85rem; }

.cart {
  position:sticky; top:92px; background:white; border:1px solid var(--line);
  border-radius:24px; padding:1.3rem; box-shadow:0 12px 35px #32234b09;
}
.cart h2 { font-size:1.55rem; margin-bottom:.85rem; }
.line { display:grid; grid-template-columns:minmax(0,1fr) auto; gap:.45rem; padding:.85rem 0; border-bottom:1px solid var(--line); font-size:.88rem; }
.line small { display:block; color:var(--muted); }
.qty { display:flex; align-items:center; justify-content:flex-end; gap:.45rem; }
.quantity { padding:.12rem .55rem; min-width:30px; }
.subtotal { grid-column:2; text-align:right; }
.total { display:flex; justify-content:space-between; gap:.5rem; align-items:center; margin:1rem 0; padding-top:.25rem; }
.total strong { font-size:1.15rem; }
.account { background:#FFF9F5; border:1px solid var(--line); border-radius:16px; padding:1rem; margin:1rem 0; }
.account-actions,.cart-actions { display:flex; gap:.5rem; margin-top:.65rem; }
.account-actions button,.cart-actions button { flex:1; padding:.68rem .55rem; font-size:.81rem; }
.status,.fine-print,.empty { color:var(--muted); font-size:.83rem; margin-top:.6rem; overflow-wrap:anywhere; }
.err { color:var(--red); font-size:.88rem; margin-top:.5rem; min-height:1.2em; font-weight:600; line-height:1.4; }
.nav-user-badge {
  display:inline-flex; align-items:center; gap:.45rem;
  background:#fff; border:1px solid var(--line);
  padding:.35rem .85rem; border-radius:999px;
  font-size:.86rem; font-weight:700; color:var(--ink);
  box-shadow:0 2px 8px #25213b0a;
  text-decoration:none;
  transition:all .2s;
}
.nav-user-badge:hover {
  border-color:var(--purple); color:var(--purple);
}
.nav-user-badge .nav-user-icon { font-size:1.05rem; line-height:1; }
.nav-user-badge .nav-user-name {
  max-width:180px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;
}
.nav-admin-badge {
  background:#FFF3D6 !important; border-color:#FFD166 !important; color:#7A4F00 !important;
  font-weight:800;
}
.nav-admin-badge:hover {
  background:#FFE7A5 !important; border-color:#FFC857 !important; color:#523300 !important;
}
.fine-print { margin-top:1rem; line-height:1.5; }
footer { border-top:1px solid var(--line); padding:1.5rem 0; }
.footer-inner { display:flex; justify-content:space-between; align-items:center; gap:1rem; color:var(--muted); font-size:.85rem; }
.footer-inner .logo { color:var(--ink); }

.toast {
  position:fixed; z-index:20; right:20px; bottom:20px;
  max-width:min(420px,calc(100vw - 40px)); background:var(--ink); color:white;
  border-radius:14px; padding:1rem 1.2rem; opacity:0; transform:translateY(12px);
  pointer-events:none; transition:opacity .2s,transform .2s;
}
.toast.visible { opacity:1; transform:translateY(0); }
.thanks {
  display:none; position:fixed; inset:0; z-index:15; padding:1.5rem;
  align-items:center; justify-content:center; background:#25213bbb; backdrop-filter:blur(7px);
}
.thanks.open { display:flex; }
.thanks-card { background:white; padding:2rem; border-radius:26px; max-width:450px; width:100%; }
.thanks-card h2 { font-size:2rem; line-height:1.15; margin:.8rem 0; }
.thanks-card p { color:var(--muted); }
.success-mark { display:grid; place-items:center; width:48px; height:48px; border-radius:50%; background:#D7F7EB; color:#17674F; font-size:1.5rem; }
.ref { margin:1rem 0; background:var(--pink-light); padding:.8rem; border-radius:12px; font-weight:800; overflow-wrap:anywhere; }
.admin-main { padding-top:2.5rem; padding-bottom:3rem; }
.stats { display:grid; grid-template-columns:repeat(auto-fit,minmax(155px,1fr)); gap:1rem; margin:1.5rem 0; }
.stat { background:#fff; border:1px solid var(--line); border-radius:20px; padding:1.2rem; }
.stat b { display:block; font-size:2.1rem; line-height:1.2; color:var(--purple); overflow-wrap:anywhere; }
.stat span { color:var(--muted); font-size:.86rem; }
.panel { background:#fff; border:1px solid var(--line); border-radius:22px; padding:1.3rem; margin-bottom:1.5rem; }
.table-wrap { overflow-x:auto; }
table { width:100%; border-collapse:collapse; font-size:.85rem; }
th,td { text-align:left; vertical-align:top; border-bottom:1px solid var(--line); padding:.8rem .6rem; }
th { color:var(--muted); font-size:.75rem; }
td small { color:var(--muted); }
.tag { display:inline-block; border-radius:99px; padding:.2rem .6rem; font-size:.78rem; font-weight:800; white-space:nowrap; }
.tag.pending { background:#FFF0C7; color:#805700; }
.tag.shipped { background:#D7F7EB; color:#17674F; }
td a { color:#6D4AE8; font-weight:700; }
[hidden] { display:none !important; }
:focus-visible { outline:3px solid var(--purple); outline-offset:3px; }

@media(max-width:900px) {
  .main-layout {
    grid-template-columns:1fr;
  }

  .cart {
    position:static;
  }

  .hero-inner {
    grid-template-columns:1fr .8fr;
    gap:1rem;
  }
}

@media(max-width:650px) {
  .wrap {
    padding-left:1rem;
    padding-right:1rem;
  }

  .top-inner {
    align-items:flex-start;
    flex-direction:column;
  }

  nav {
    gap:.7rem;
  }

  nav a {
    font-size:.82rem;
  }

  .hero-inner {
    grid-template-columns:1fr;
    padding-top:3rem;
    padding-bottom:3rem;
  }

  .hero h1 {
    font-size:2.8rem;
  }

  .hero-art svg {
    max-height:245px;
  }

  .main-layout {
    padding-top:2rem;
  }

  .section-head {
    align-items:flex-start;
    flex-direction:column;
  }

  .collection-note {
    display:none;
  }

  .grid {
    grid-template-columns:repeat(auto-fill,minmax(160px,1fr));
  }

  .footer-inner {
    flex-wrap:wrap;
  }

  .panel {
    padding:.8rem;
  }
}

/* Pages Connexion, Inscription et Mon compte */
.auth-main {
  max-width:1040px;
  padding-top:3rem;
  padding-bottom:4rem;
}

.auth-main > h1 {
  font-size:clamp(2.2rem,5vw,3.8rem);
  line-height:1.1;
}

.auth-intro {
  color:var(--muted);
  max-width:620px;
  margin:.9rem 0 2rem;
}

.auth-layout {
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:1.25rem;
  align-items:start;
}

.auth-card {
  min-width:0;
  padding:1.5rem;
  background:white;
  border:1px solid var(--line);
  border-radius:24px;
  box-shadow:0 12px 32px #32234b08;
}

.auth-card h2 {
  margin-bottom:1rem;
}

.auth-card form > button {
  margin-top:1rem;
}

.auth-card input[readonly] {
  color:var(--muted);
  background:#FFF9F5;
}

.profile-card {
  max-width:650px;
}

.account-prompt {
  padding:1rem;
  margin:1rem 0;
  border-radius:16px;
  background:#FFF9F5;
  border:1px solid var(--line);
  font-size:.86rem;
}

.account-prompt a,
.profile-link {
  display:inline-block;
  margin-top:.55rem;
  color:#6D4AE8;
  font-weight:800;
  text-decoration:none;
}

.profile-actions {
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:1rem;
  flex-wrap:wrap;
  margin-top:1.5rem;
  padding-top:1rem;
  border-top:1px solid var(--line);
}

#confirm-panel {
  margin-top:1.5rem;
  padding-top:1rem;
  border-top:1px solid var(--line);
}

@media(max-width:700px) {
  .auth-layout {
    grid-template-columns:1fr;
  }

  .auth-main {
    padding-top:2rem;
  }

  .auth-card {
    padding:1.1rem;
  }
}
"""


PAGES = {
    # Boutique
    "/": ("text/html; charset=utf-8", SHOP_HTML),
    "/index.html": ("text/html; charset=utf-8", SHOP_HTML),

    # Authentification et profil client
    "/login": ("text/html; charset=utf-8", LOGIN_HTML),
    "/login/": ("text/html; charset=utf-8", LOGIN_HTML),
    "/account": ("text/html; charset=utf-8", ACCOUNT_HTML),
    "/account/": ("text/html; charset=utf-8", ACCOUNT_HTML),

    # Administration
    "/admin": ("text/html; charset=utf-8", ADMIN_HTML),
    "/admin/": ("text/html; charset=utf-8", ADMIN_HTML),

    # Fichiers statiques
    "/style.css": ("text/css; charset=utf-8", STYLE_CSS),
    "/config.js": ("application/javascript; charset=utf-8", CONFIG_JS),
}

# ----------------------------------------------------------------------
# ROUTES HTTP / API AWS
# ----------------------------------------------------------------------

class ShopHandler(BaseHTTPRequestHandler):
    def _send_json(self, code, payload):
        data = json.dumps(payload, cls=DecimalEncoder).encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        # Support CORS pour le développement front-end
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Methods", "GET, POST, PUT, DELETE, OPTIONS")
        self.send_header("Access-Control-Allow-Headers", "Content-Type, Authorization, X-Amz-Date, X-Api-Key, X-Amz-Security-Token")
        self.end_headers()
        self.wfile.write(data)

    def _read_json(self):
        length = int(self.headers.get("Content-Length", 0))
        raw = self.rfile.read(length).decode("utf-8") if length > 0 else ""
        return json.loads(raw) if raw.strip() else {}

    def do_OPTIONS(self):
        """Pre-flight CORS pour les requêtes modernes du front-end."""
        self.send_response(200)
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Methods", "GET, POST, PUT, DELETE, OPTIONS")
        self.send_header("Access-Control-Allow-Headers", "Content-Type, Authorization, X-Amz-Date, X-Api-Key, X-Amz-Security-Token")
        self.send_header("Content-Length", "0")
        self.end_headers()

    def _invoke_lambda(self, payload):
        """Appelle la Lambda de backend centralisée et décode la réponse."""
        lambda_client = boto3.client("lambda", region_name=REGION)
        try:
            result = lambda_client.invoke(
                FunctionName=LAMBDA_NAME,
                InvocationType="RequestResponse",
                Payload=json.dumps(payload, cls=DecimalEncoder).encode("utf-8"),
            )
            if result.get("FunctionError"):
                err_detail = result["Payload"].read().decode("utf-8", errors="replace")
                return 502, {"error": "Échec de la fonction Lambda backend.", "detail": err_detail}

            response_raw = result["Payload"].read().decode("utf-8", errors="replace")
            res_obj = json.loads(response_raw)

            # Support si la Lambda retourne une réponse au format HTTP Proxy
            if isinstance(res_obj, dict) and "statusCode" in res_obj and "body" in res_obj:
                body_parsed = json.loads(res_obj["body"]) if isinstance(res_obj["body"], str) else res_obj["body"]
                return int(res_obj["statusCode"]), body_parsed

            code = 200
            if isinstance(res_obj, dict):
                if res_obj.get("statusCode"):
                    code = int(res_obj["statusCode"])
                elif res_obj.get("status") == "ERROR" or res_obj.get("error"):
                    code = 400

            return code, res_obj
        except Exception as exc:
            return 500, {"error": f"Erreur lors de l'appel Lambda : {str(exc)}"}

    def _is_admin(self):
        """Vérifie si la requête appelante possède les droits administrateur (groupe Cognito admin)."""
        auth_header = self.headers.get("Authorization", "")
        token = ""
        if auth_header.startswith("Bearer "):
            token = auth_header.split(" ", 1)[1].strip()

        parsed = urllib.parse.urlparse(self.path)
        query = urllib.parse.parse_qs(parsed.query)
        email = query.get("email", [""])[0]

        if token:
            claims = decode_jwt_payload(token)
            groups = claims.get("cognito:groups", [])
            if isinstance(groups, list) and "admin" in groups:
                return True
            if not email and claims.get("email"):
                email = claims.get("email")

        if not token and not email:
            return False

        try:
            code, res = self._invoke_lambda({
                "action": "admin_check",
                "email": email,
                "access_token": token,
                "headers": dict(self.headers),
            })
            if code == 200 and isinstance(res, dict) and res.get("is_admin") is True:
                return True
        except Exception:
            pass
        return False

    def do_GET(self):
        parsed = urllib.parse.urlparse(self.path)
        path = parsed.path
        query = urllib.parse.parse_qs(parsed.query)

        try:
            # 1. Pages statiques NÉOLIA & fichiers CSS/JS
            if path in PAGES:
                content_type, content = PAGES[path]
                data = content.encode("utf-8")
                self.send_response(200)
                self.send_header("Content-Type", content_type)
                self.send_header("Content-Length", str(len(data)))
                self.send_header("Cache-Control", "no-store, no-cache, must-revalidate, max-age=0")
                self.send_header("Pragma", "no-cache")
                self.send_header("Expires", "0")
                self.end_headers()
                self.wfile.write(data)
                return

            if path == "/health":
                self._send_json(200, {"status": "healthy", "instance": INSTANCE_ID})
                return

            # 2. Facture PDF officielle (streaming S3)
            if path == "/api/invoice":
                key = query.get("key", [""])[0]
                if not key:
                    self._send_json(400, {"error": "Clé de facture manquante."})
                    return

                s3 = boto3.client(
                    "s3",
                    region_name=REGION,
                    endpoint_url=f"https://s3.{REGION}.amazonaws.com",
                    config=Config(signature_version="s3v4"),
                )
                obj = s3.get_object(Bucket=INVOICES_BUCKET, Key=key)
                pdf_bytes = obj["Body"].read()
                filename = key.split("/")[-1]

                self.send_response(200)
                self.send_header("Content-Type", "application/pdf")
                self.send_header("Content-Disposition", f'inline; filename="{filename}"')
                self.send_header("Content-Length", str(len(pdf_bytes)))
                self.send_header("Cache-Control", "no-store")
                self.end_headers()
                self.wfile.write(pdf_bytes)
                return

            # 3. Suivi Worker Spot & SQS
            if path == "/api/spot-status":
                sqs = boto3.client("sqs", region_name=REGION)
                ec2 = boto3.client("ec2", region_name=REGION)
                attrs = sqs.get_queue_attributes(
                    QueueUrl=SQS_QUEUE_URL,
                    AttributeNames=["ApproximateNumberOfMessages", "ApproximateNumberOfMessagesNotVisible"],
                ).get("Attributes", {})
                pending = int(attrs.get("ApproximateNumberOfMessages", 0)) + int(attrs.get("ApproximateNumberOfMessagesNotVisible", 0))
                result = ec2.describe_instances(
                    Filters=[{"Name": "tag:Role", "Values": ["spot-batch-worker"]}]
                )
                instances = [
                    {"id": instance["InstanceId"], "state": instance["State"]["Name"]}
                    for reservation in result.get("Reservations", [])
                    for instance in reservation.get("Instances", [])
                ]
                self._send_json(200, {"sqs_pending": pending, "spot_instances": instances})
                return

            if path == "/api/info":
                self._send_json(200, {"instance": INSTANCE_ID, "region": REGION, "launch_template": SPOT_LT_ID})
                return

            # Stress test CPU pour valider l'Auto Scaling (Scale-Out)
            if path == "/api/stress":
                try:
                    duration = int(query.get("seconds", ["120"])[0])
                except (TypeError, ValueError):
                    duration = 120
                duration = min(max(duration, 5), 600)

                # Processus OS independants pour saturer les 2 vCPUs a 100% sans bloquer le serveur HTTP ni les health checks
                burn_code = "import time\nend = time.time() + " + str(duration) + "\nwhile time.time() < end:\n    _ = sum(i*i for i in range(50000))\n"
                for _ in range(2):
                    subprocess.Popen([sys.executable, "-c", burn_code])

                self._send_json(200, {
                    "status": "STRESS_ACTIVE",
                    "instance": INSTANCE_ID,
                    "target_cpu": "100%",
                    "duration_seconds": duration,
                    "message": f"Stress CPU 100% active sur {INSTANCE_ID} pendant {duration}s pour tester l'Auto Scaling !"
                })
                return

            # 4. Catalogue : Tous les produits (Délégué à la Lambda backend)
            if path == "/api/products":
                code, res = self._invoke_lambda({"action": "list_products"})
                # Rétrocompatibilité : l'ancien front attend directement un tableau JS d'articles
                if code == 200 and isinstance(res, dict) and "products" in res:
                    # Si le client a demandé explicitement le format structuré via ?format=full
                    if query.get("format", [""])[0] == "full":
                        self._send_json(200, res)
                    else:
                        self._send_json(200, res["products"])
                else:
                    self._send_json(code, res)
                return

            # 5. Catalogue : Fiche détaillée d'un produit
            if path == "/api/product" or re.match(r"^/api/products/[^/]+$", path):
                product_id = query.get("id", [""])[0] or query.get("product_id", [""])[0]
                if not product_id and "/" in path:
                    product_id = path.split("/")[-1]
                code, res = self._invoke_lambda({"action": "get_product", "product_id": product_id})
                self._send_json(code, res)
                return

            # 6. Compte utilisateur : Profil Cognito
            if path in ["/api/user/profile", "/api/me"]:
                email = query.get("email", [""])[0]
                code, res = self._invoke_lambda({
                    "action": "get_user_profile",
                    "email": email,
                    "headers": dict(self.headers),
                })
                self._send_json(code, res)
                return

            # 7. Compte utilisateur : Commandes & statut
            if path in ["/api/user/orders", "/api/orders"]:
                email = query.get("email", [""])[0] or query.get("customer_email", [""])[0]
                auth_header = self.headers.get("Authorization", "")
                if (not email or not re.match(r"^\S+@\S+\.\S+$", email)) and auth_header.startswith("Bearer "):
                    jwt_token = auth_header.split(" ", 1)[1].strip()
                    jwt_claims = decode_jwt_payload(jwt_token)
                    if jwt_claims.get("email"):
                        email = jwt_claims.get("email")

                # Si aucune adresse email n'est précisée, c'est une consultation globale réservée à l'administrateur
                if not email and not self._is_admin():
                    self._send_json(403, {"status": "ERROR", "statusCode": 403, "error": "Accès réservé aux administrateurs."})
                    return

                code, res = self._invoke_lambda({
                    "action": "get_user_orders",
                    "customer_email": email,
                })
                # Rétrocompatibilité avec l'ancien front admin
                if code == 200 and isinstance(res, dict) and "orders" in res and not email:
                    self._send_json(200, res["orders"])
                else:
                    self._send_json(code, res)
                return

            # 8. Détail d'une commande spécifique
            if path == "/api/order" or re.match(r"^/api/orders/[^/]+$", path):
                order_id = query.get("order_id", [""])[0] or query.get("id", [""])[0]
                if not order_id and "/" in path:
                    order_id = path.split("/")[-1]
                code, res = self._invoke_lambda({"action": "get_order_details", "order_id": order_id})
                self._send_json(code, res)
                return

            # 9. Admin : Vérification des privilèges
            if path == "/api/admin/check":
                email = query.get("email", [""])[0]
                code, res = self._invoke_lambda({
                    "action": "admin_check",
                    "email": email,
                    "headers": dict(self.headers),
                })
                self._send_json(code, res)
                return

            # 10. Admin : Vision des stocks & métriques
            if path == "/api/admin/stocks":
                if not self._is_admin():
                    self._send_json(403, {"status": "ERROR", "statusCode": 403, "error": "Accès réservé aux administrateurs."})
                    return
                code, res = self._invoke_lambda({"action": "admin_list_stocks"})
                self._send_json(code, res)
                return

            # 11. Admin : Liste des membres du groupe admin
            if path == "/api/admin/admins":
                if not self._is_admin():
                    self._send_json(403, {"status": "ERROR", "statusCode": 403, "error": "Accès réservé aux administrateurs."})
                    return
                code, res = self._invoke_lambda({"action": "admin_list_admins"})
                self._send_json(code, res)
                return

            # 12. Admin : Liste de tous les utilisateurs Cognito
            if path == "/api/admin/users":
                if not self._is_admin():
                    self._send_json(403, {"status": "ERROR", "statusCode": 403, "error": "Accès réservé aux administrateurs."})
                    return
                code, res = self._invoke_lambda({"action": "admin_list_users"})
                self._send_json(code, res)
                return

            self._send_json(404, {"error": "Route GET introuvable."})

        except Exception as exc:
            self._send_json(500, {"error": str(exc)})

    def do_POST(self):
        parsed = urllib.parse.urlparse(self.path)
        path = parsed.path
        query = urllib.parse.parse_qs(parsed.query)

        try:
            body = self._read_json()

            # 1. Validation de commande (multi-articles ou unitaire)
            if path in ["/api/order", "/api/orders"]:
                customer_name = str(body.get("customer_name", "")).strip()[:80]
                customer_email = str(body.get("customer_email", "")).strip()[:120]
                items = body.get("items")

                if not items and body.get("product_id"):
                    items = [{"product_id": body.get("product_id"), "qty": body.get("qty", 1)}]

                auth_header = self.headers.get("Authorization", "")
                jwt_claims = {}
                if auth_header.startswith("Bearer "):
                    jwt_token = auth_header.split(" ", 1)[1].strip()
                    jwt_claims = decode_jwt_payload(jwt_token)

                jwt_email = jwt_claims.get("email") or ""
                jwt_name = jwt_claims.get("name") or (
                    jwt_claims.get("given_name", "") + " " + jwt_claims.get("family_name", "")
                ).strip()

                # Si l'email reçu n'est pas un email valide (ex: UUID Cognito sans @), on utilise l'email du JWT
                if (not customer_email or not re.match(r"^\S+@\S+\.\S+$", customer_email)) and jwt_email:
                    customer_email = jwt_email

                # Si le nom est manquant, on utilise le nom extrait de Cognito ou le préfixe de l'email
                if not customer_name:
                    if jwt_name:
                        customer_name = jwt_name
                    elif customer_email and "@" in customer_email:
                        customer_name = customer_email.split("@")[0]

                if not customer_name or not re.match(r"^\S+@\S+\.\S+$", customer_email) or not isinstance(items, list) or not items:
                    self._send_json(400, {"error": "Nom, e-mail et au moins un article sont requis."})
                    return

                code, res = self._invoke_lambda({
                    "action": "create_order",
                    "customer_name": customer_name,
                    "customer_email": customer_email,
                    "shipping_address": body.get("shipping_address", "12 Rue de la Paix, 75002 Paris"),
                    "items": items,
                })

                # Rétrocompatibilité avec l'ancien front qui attend { status: 'ok', order_ids: [...] }
                if code == 200 and isinstance(res, dict):
                    order_id = res.get("order_id")
                    res["status"] = "ok"
                    res["order_ids"] = [str(order_id)] if order_id else []

                self._send_json(code, res)
                return

            # 2. Inscription Cognito avec Nom, Prénom, adresse_postale et e-mail
            if path in ["/api/auth/register", "/api/auth/signup"]:
                code, res = self._invoke_lambda({
                    "action": "register_user",
                    **body,
                })
                self._send_json(code, res)
                return

            # 3. Confirmation du compte par code
            if path in ["/api/auth/confirm", "/api/auth/verify"]:
                code, res = self._invoke_lambda({
                    "action": "confirm_user",
                    **body,
                })
                self._send_json(code, res)
                return

            # 3 bis. Renvoi du code de confirmation par e-mail
            if path in ["/api/auth/resend-code", "/api/auth/resend"]:
                code, res = self._invoke_lambda({
                    "action": "resend_confirmation_code",
                    **body,
                })
                self._send_json(code, res)
                return

            # 4. Abonnement SNS direct (conservé pour rétrocompatibilité)
            if path == "/api/subscribe":
                email = str(body.get("email", "")).strip()
                if not re.match(r"^\S+@\S+\.\S+$", email):
                    self._send_json(400, {"error": "Adresse e-mail invalide."})
                    return
                sns = boto3.client("sns", region_name=REGION)
                subscription = sns.subscribe(
                    TopicArn=SNS_CONFIRM_ARN,
                    Protocol="email",
                    Endpoint=email,
                    Attributes={"FilterPolicy": json.dumps({"customer_email": [email]})},
                )
                self._send_json(200, {
                    "status": "SUBSCRIBED",
                    "subscription_arn": subscription.get("SubscriptionArn"),
                })
                return

            # 5. Démarrage Worker Spot manuel (réservé aux administrateurs)
            if path == "/api/launch-spot":
                if not self._is_admin():
                    self._send_json(403, {"status": "ERROR", "statusCode": 403, "error": "Accès réservé aux administrateurs."})
                    return

                ec2 = boto3.client("ec2", region_name=REGION)
                instance_id = None
                mode = "EC2 Spot"
                for instance_type in ("t3.micro", "t3.small"):
                    try:
                        response = ec2.run_instances(
                            LaunchTemplate={"LaunchTemplateId": SPOT_LT_ID, "Version": "$Latest"},
                            InstanceType=instance_type,
                            InstanceMarketOptions={"MarketType": "spot", "SpotOptions": {"SpotInstanceType": "one-time"}},
                            MinCount=1,
                            MaxCount=1,
                        )
                        instance_id = response["Instances"][0]["InstanceId"]
                        mode = f"EC2 Spot ({instance_type})"
                        break
                    except Exception:
                        continue

                if not instance_id:
                    response = ec2.run_instances(
                        LaunchTemplate={"LaunchTemplateId": SPOT_LT_ID, "Version": "$Latest"},
                        InstanceType="t3.micro",
                        MinCount=1,
                        MaxCount=1,
                    )
                    instance_id = response["Instances"][0]["InstanceId"]
                    mode = "EC2 éphémère (repli sans Spot)"

                self._send_json(200, {"status": "LAUNCHED", "instance_id": instance_id, "mode": mode})
                return

            # 6. Compte utilisateur : Modification des infos
            if path in ["/api/user/profile", "/api/user/update"]:
                code, res = self._invoke_lambda({
                    "action": "update_user_profile",
                    "headers": dict(self.headers),
                    **body,
                })
                self._send_json(code, res)
                return

            # 7. Admin : Ajustement des stocks
            if path in ["/api/admin/stock", "/api/admin/stocks"]:
                code, res = self._invoke_lambda({
                    "action": "admin_update_stock",
                    **body,
                })
                self._send_json(code, res)
                return

            # 8. Admin : Ajouter un administrateur
            if path in ["/api/admin/admins", "/api/admin/admins/add"]:
                code, res = self._invoke_lambda({
                    "action": "admin_add_admin",
                    **body,
                })
                self._send_json(code, res)
                return

            # 9. Admin : Retirer un administrateur (via POST)
            if path in ["/api/admin/admins/remove", "/api/admin/admins/delete"]:
                code, res = self._invoke_lambda({
                    "action": "admin_remove_admin",
                    **body,
                })
                self._send_json(code, res)
                return

            self._send_json(404, {"error": "Route POST introuvable."})

        except Exception as exc:
            self._send_json(500, {"error": str(exc)})

    def do_PUT(self):
        parsed = urllib.parse.urlparse(self.path)
        path = parsed.path

        try:
            body = self._read_json()

            # 1. Compte utilisateur : Modification des infos
            if path in ["/api/user/profile", "/api/user/update"]:
                code, res = self._invoke_lambda({
                    "action": "update_user_profile",
                    "headers": dict(self.headers),
                    **body,
                })
                self._send_json(code, res)
                return

            # 2. Admin : Mise à jour du stock
            if path in ["/api/admin/stock", "/api/admin/stocks"]:
                code, res = self._invoke_lambda({
                    "action": "admin_update_stock",
                    **body,
                })
                self._send_json(code, res)
                return

            self._send_json(404, {"error": "Route PUT introuvable."})
        except Exception as exc:
            self._send_json(500, {"error": str(exc)})

    def do_DELETE(self):
        parsed = urllib.parse.urlparse(self.path)
        path = parsed.path
        query = urllib.parse.parse_qs(parsed.query)

        try:
            body = self._read_json()
            username = body.get("username") or body.get("email") or query.get("username", [""])[0] or query.get("email", [""])[0]

            # 1. Admin : Retirer un membre du groupe admin
            if path == "/api/admin/admins":
                code, res = self._invoke_lambda({
                    "action": "admin_remove_admin",
                    "username": username,
                })
                self._send_json(code, res)
                return

            self._send_json(404, {"error": "Route DELETE introuvable."})
        except Exception as exc:
            self._send_json(500, {"error": str(exc)})

    def log_message(self, fmt, *args):
        super().log_message(fmt, *args)


if __name__ == "__main__":
    print(
        f"NÉOLIA — serveur web sur 0.0.0.0:80 "
        f"| {INSTANCE_ID} | région {REGION}",
        flush=True,
    )
    ThreadingHTTPServer(("0.0.0.0", 80), ShopHandler).serve_forever()