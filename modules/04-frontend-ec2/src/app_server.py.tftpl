#!/usr/bin/env python3
# -*- coding: utf-8 -*-
# NÉOLIA - Front-end AWS
# Template destiné à Terraform templatefile().
# Les expressions JavaScript $${...} sont volontairement échappées
# pour que Terraform produise correctement les interpolations JavaScript.

import json
import re
import urllib.parse
import urllib.request
from decimal import Decimal
from http.server import HTTPServer, BaseHTTPRequestHandler

import boto3
from botocore.config import Config


USER_POOL_ID = "${user_pool_id}"
USER_POOL_CLIENT_ID = "${user_pool_client_id}"
REGION = "${region}"
PRODUCTS_TABLE = "${products_table}"
ORDERS_TABLE = "${orders_table}"
INVOICES_BUCKET = "${invoices_bucket}"
LAMBDA_NAME = "${lambda_name}"
SNS_CONFIRM_ARN = "${sns_confirm_arn}"
SNS_SHIP_ARN = "${sns_ship_arn}"
SQS_QUEUE_URL = "${sqs_queue_url}"
SPOT_LT_ID = "${spot_lt_id}"


class DecimalEncoder(json.JSONEncoder):
    def default(self, obj):
        if isinstance(obj, Decimal):
            return float(obj) if obj % 1 != 0 else int(obj)
        return super().default(obj)


def get_instance_info():
    try:
        req = urllib.request.Request(
            "http://169.254.169.254/latest/api/token",
            headers={"X-aws-ec2-metadata-token-ttl-seconds": "60"},
            method="PUT",
        )
        token = urllib.request.urlopen(req, timeout=1).read().decode()

        headers = {"X-aws-ec2-metadata-token": token}
        values = []

        for path in (
            "instance-id",
            "placement/availability-zone",
        ):
            req = urllib.request.Request(
                "http://169.254.169.254/latest/meta-data/" + path,
                headers=headers,
            )
            values.append(
                urllib.request.urlopen(req, timeout=1).read().decode()
            )

        return f"{values[0]} ({values[1]})"
    except Exception:
        return "ec2-front-local"


INSTANCE_ID = get_instance_info()

CONFIG_JS = (
    "window.APP_CONFIG={auth:true,spot:true,userPoolId:%s,"
    "userPoolClientId:%s,region:%s};"
    % (
        json.dumps(USER_POOL_ID),
        json.dumps(USER_POOL_CLIENT_ID),
        json.dumps(REGION),
    )
)


