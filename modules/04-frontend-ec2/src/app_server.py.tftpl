  <div class="container">
    <div id="toast"></div>

    <!-- 1. IDENTIFICATION CLIENT & AUTHENTIFICATION COGNITO -->
    <div class="card" id="account">
      <h2><span>Compte client & Authentification (Amazon Cognito)</span></h2>
      <p style="font-size: 0.88rem; color: var(--muted); margin-bottom: 0.8rem;">
        S'inscrire créera automatiquement votre compte Cognito et votre abonnement aux notifications SNS.
      </p>
      <div style="display:flex; gap:0.7rem; align-items:center; flex-wrap:wrap; margin-bottom: 0.8rem;">
        <input type="text" id="customer-name" value="Bastien" placeholder="Votre nom" style="width:160px;">
        <input type="email" id="cognito-email" placeholder="votre.email@domaine.fr">
        <input type="password" id="cognito-password" placeholder="Mot de passe" style="width:180px;">
        <button class="btn-secondary" onclick="registerCognito()">S'inscrire (Cognito + SNS)</button>
        <button class="btn-secondary" onclick="loginCognito()">Se connecter</button>
      </div>
      <p style="font-size:0.86rem; color:var(--muted);" id="cognito-status">Statut : <strong style="color:var(--red)">Non connecté (Achats bloqués)</strong></p>
    </div>

    <!-- Catalogue ATELIER NOIR : pages de catégories -->
    <section class="card" id="collection">
      <p class="section-kicker">La collection</p>
      <h2><span id="category-title">Tous les essentiels</span><button class="btn-secondary" onclick="loadProducts()">Rafraîchir</button></h2>
      <p id="category-copy" style="color:var(--muted);margin:-.4rem 0 1.3rem;">Des formules essentielles, des textures sensorielles et une routine sans superflu.</p>
      <div class="category-tabs" aria-label="Catégories">
        <a href="#visage">Visage</a><a href="#barbe">Barbe</a><a href="#corps">Corps</a><a href="#parfums">Parfums</a><a href="#collection">Tout voir</a>
      </div>
      <div id="products-list" class="products-grid">Chargement de la collection...</div>
    </section>

    <!-- Panier client -->
    <section class="card" id="panier">
      <p class="section-kicker">Votre sélection</p><h2>Le panier <span id="cart-subtitle" style="font: .8rem Arial;color:var(--muted);">0 article</span></h2>
      <div id="cart-items">Votre panier est encore vide.</div>
      <div class="cart-total"><span>Sous-total estimé</span><strong id="cart-total">0,00 €</strong></div>
      <p style="color:var(--muted);font-size:.82rem;margin:.7rem 0 1rem;">Les commandes sont confirmées après connexion. Les articles sont envoyés au service de commande AWS existant.</p>
      <button id="checkout-btn" onclick="checkoutCart()" disabled>Valider la commande</button>
      <button class="btn-secondary" onclick="clearCart()" style="margin-left:.4rem;">Vider le panier</button>
    </section>

    <!-- 3. PANNEAU ADMIN : LANCEMENT MANUEL / PERIODIQUE DU WORKER EC2 SPOT -->
    <div class="card card-spot">
      <h2>
        <span>3. Console Administrateur : Worker Batch EC2 Spot (Périodique 02h00 ou Lancement Manuel)</span>
        <button class="btn-spot" id="btn-launch-spot" onclick="launchSpotWorker(this)">
          🚀 Créer & Lancer une Instance EC2 Spot maintenant
        </button>
      </h2>
      <p style="font-size: 0.88rem; color: #0c4a6e; margin-bottom: 0.8rem;">
        Au repos, <strong>0 instance EC2 Spot ne tourne (0,00 €)</strong> : les commandes s'accumulent dans la file SQS au statut <code>PENDING</code>. Le batch se lance soit automatiquement la nuit à <strong>02h00 UTC</strong>, soit à la demande en cliquant sur le bouton bleu ci-dessus.
      </p>
      <div id="spot-status-bar" style="font-size:0.92rem; background:white; padding:0.75rem 1rem; border-radius:6px; border:1px solid #bae6fd;">
        Chargement de l'état de la file SQS et des instances Spot...
      </div>
    </div>

    <!-- 4. TABLEAU DE SUIVI DES COMMANDES & FACTURES PDF -->
    <div class="card" id="orders">
      <h2>
        <span>Suivi des commandes, Colisage & Factures PDF (DynamoDB + S3)</span>
        <button class="btn-secondary" onclick="loadAll()">Actualiser</button>
      </h2>
      <table>
        <thead>
          <tr>
            <th>N° Commande</th>
            <th>Client & E-mail</th>
            <th>Article commandé</th>
            <th>Statut</th>
            <th>Colis Transporteur (EC2 Spot)</th>
            <th>N° de Suivi (SNS)</th>
            <th>Facture PDF (Amazon S3)</th>
          </tr>
        </thead>
        <tbody id="orders-body">
          <tr><td colspan="7">Chargement des commandes...</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <script>
    window.APP_CONFIG = {
      userPoolId: '""" + USER_POOL_ID + """',
      userPoolClientId: '""" + USER_POOL_CLIENT_ID + """',
      region: '""" + REGION + """'
    };

    var userPool = null;
    if (typeof AmazonCognitoIdentity !== 'undefined') {
      const poolData = {
        UserPoolId: window.APP_CONFIG.userPoolId,
        ClientId: window.APP_CONFIG.userPoolClientId
      };
      userPool = new AmazonCognitoIdentity.CognitoUserPool(poolData);
    }

    async function registerCognito() {
      if (!userPool) { alert('Erreur: SDK Cognito non disponible.'); return; }
      const email = document.getElementById('cognito-email').value.trim();
      const password = document.getElementById('cognito-password').value;
      if (!email || !password) { alert('Veuillez saisir un e-mail et un mot de passe.'); return; }

      const attributeList = [
        new AmazonCognitoIdentity.CognitoUserAttribute({ Name: 'email', Value: email })
      ];

      // 1. Inscription Cognito
      userPool.signUp(email, password, attributeList, null, async (err, result) => {
        if (err) { alert('Erreur Cognito : ' + err.message); return; }

        // 2. Abonnement automatique SNS dans la foulée
        try {
          await fetch('/api/subscribe', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({ email })
          });
          showToast('✅ Compte créé ! Un e-mail d activation Cognito et une confirmation SNS vous ont été envoyés sur ' + email);
        } catch (e) {
          showToast('✅ Compte Cognito créé ! Cliquez sur le lien d activation dans votre boîte mail.');
        }
      });
    }

    function loginCognito() {
      if (!userPool) { alert('Erreur: SDK Cognito non disponible.'); return; }
      const email = document.getElementById('cognito-email').value.trim();
      const password = document.getElementById('cognito-password').value;
      if (!email || !password) { alert('Veuillez saisir votre e-mail et mot de passe.'); return; }

      const authDetails = new AmazonCognitoIdentity.AuthenticationDetails({ Username: email, Password: password });
      const cognitoUser = new AmazonCognitoIdentity.CognitoUser({ Username: email, Pool: userPool });

      cognitoUser.authenticateUser(authDetails, {
        onSuccess: (result) => {
          const jwtToken = result.getIdToken().getJwtToken();
          sessionStorage.setItem('jwt_token', jwtToken);
          sessionStorage.setItem('user_email', email);
          document.getElementById('cognito-status').innerHTML = 'Statut : <strong style="color:var(--green)">Connecté avec ' + email + ' (Token JWT actif - Achats autorisés)</strong>';
          showToast('✅ Session Cognito active ! Vous pouvez désormais passer commande.');
        },
        onFailure: (err) => { alert('Erreur de connexion : ' + err.message); }
      });
    }

    function showToast(msg) {
      const toast = document.getElementById('toast');
      toast.style.display = 'block';
      toast.textContent = msg;
    }

    async function launchSpotWorker(btn) {
      btn.disabled = true;
      const oldText = btn.textContent;
      btn.textContent = '⏳ Création de l instance EC2 Spot...';
      try {
        const res = await fetch('/api/launch-spot', {
          method: 'POST',
          headers: {'Content-Type': 'application/json'},
          body: '{}'
        });
        const data = await res.json();
        if (data.error) {
          showToast(`❌ Erreur : $${data.error}`);
        } else {
          showToast(`🚀 Instance Worker $${data.instance_id} ($${data.mode}) créée à la demande !`);
        }
        await loadSpotStatus();
      } finally {
        btn.disabled = false;
        btn.textContent = oldText;
      }
    }

    async function loadSpotStatus() {
      const res = await fetch('/api/spot-status');
      const data = await res.json();
      const bar = document.getElementById('spot-status-bar');
      const instancesHtml = data.spot_instances.length
        ? data.spot_instances.map(i => `<code>$${i.id}</code> (<strong>$${i.state}</strong>)`).join(' · ')
        : '<strong>Aucune instance active (0,00 €/h au repos)</strong>';
      bar.innerHTML = `📦 <strong>Commandes en attente dans SQS :</strong> <strong>$${data.sqs_pending}</strong> &nbsp;|&nbsp; 🖥️ <strong>Instances EC2 Spot récentes :</strong> $${instancesHtml}`;
    }

    const CATEGORY_INFO = {
      visage: { title: 'Les soins du visage', copy: 'Nettoyants, sérums et hydratants pour une routine précise et équilibrée.' },
      barbe: { title: 'Le rituel de la barbe', copy: 'Huiles nourrissantes, baumes disciplinants et soins pour une barbe impeccable.' },
      corps: { title: 'Les soins du corps', copy: 'Des essentiels quotidiens aux textures sobres et aux parfums subtils.' },
      parfums: { title: 'Les signatures olfactives', copy: 'Des accords boisés, ambrés et frais pour laisser une empreinte discrète.' },
      collection: { title: 'Tous les essentiels', copy: 'Découvrez toute la collection ATELIER NOIR.' }
    };
    let allProducts = [];
    let cart = {};
    try { cart = JSON.parse(localStorage.getItem('atelier_noir_cart') || '{}') || {}; } catch (_) { cart = {}; }

    function currentCategory() {
      const value = (location.hash || '#collection').slice(1).toLowerCase();
      return CATEGORY_INFO[value] ? value : 'collection';
    }
    function money(value) { return Number(value || 0).toLocaleString('fr-FR', {style:'currency',currency:'EUR'}); }
    function productCategory(p) {
      const raw = String(p.category || p.categorie || '').toLowerCase();
      if (['visage','barbe','corps','parfums'].includes(raw)) return raw;
      return 'autres';
    }
    async function loadProducts() {
      const res = await fetch('/api/products');
      if (!res.ok) throw new Error('Impossible de charger le catalogue.');
      allProducts = await res.json();
      renderProducts();
    }
    function renderProducts() {
      const category = currentCategory();
      const info = CATEGORY_INFO[category];
      document.getElementById('category-title').textContent = info.title;
      document.getElementById('category-copy').textContent = info.copy;
      const products = allProducts.filter(p => category === 'collection' ? productCategory(p) !== 'autres' : productCategory(p) === category);
      const container = document.getElementById('products-list');
      if (!products.length) {
        container.innerHTML = '<p style="color:var(--muted);padding:1rem 0;">Aucun produit dans cette catégorie. Vérifiez que le catalogue ATELIER NOIR a été chargé dans DynamoDB.</p>';
        return;
      }
      container.innerHTML = products.map(p => `
        <article class="prod-box">
          <div>
            <div class="product-visual"><span>ATELIER<br>NOIR</span></div>
            <p class="section-kicker">$${productCategory(p)}</p>
            <div class="prod-title">$${p.name}</div>
            <div class="prod-meta">$${p.description || 'Un essentiel soigneusement sélectionné pour votre rituel quotidien.'}<br>Réf. <code>$${p.product_id}</code><br>Disponibilité : <strong>$${Number(p.stock || 0) > 0 ? 'En stock' : 'Épuisé'}</strong></div>
          </div>
          <div style="display:flex;justify-content:space-between;align-items:center;gap:.6rem;margin-top:.6rem;">
            <span class="price">$${money(p.price_eur)}</span>
            <button onclick="addToCart('$${p.product_id}')" $${Number(p.stock || 0) <= 0 ? 'disabled' : ''}>Ajouter au panier</button>
          </div>
        </article>`).join('');
    }
    function saveCart() { localStorage.setItem('atelier_noir_cart', JSON.stringify(cart)); renderCart(); }
    function addToCart(id) {
      const p = allProducts.find(x => x.product_id === id);
      if (!p) return;
      const current = Number(cart[id] || 0);
      if (current >= Number(p.stock || 0)) { showToast('Stock maximal atteint pour ce produit.'); return; }
      cart[id] = current + 1; saveCart(); showToast(p.name + ' ajouté au panier.');
    }
    function changeQty(id, delta) {
      const p = allProducts.find(x => x.product_id === id);
      const next = Number(cart[id] || 0) + delta;
      if (next <= 0) delete cart[id];
      else if (p && next <= Number(p.stock || 0)) cart[id] = next;
      else { showToast('La quantité dépasse le stock disponible.'); return; }
      saveCart();
    }
    function removeFromCart(id) { delete cart[id]; saveCart(); }
    function clearCart() { cart = {}; saveCart(); }
    function renderCart() {
      const entries = Object.entries(cart).filter(([id, qty]) => qty > 0 && allProducts.some(p => p.product_id === id));
      const count = entries.reduce((sum, [,qty]) => sum + Number(qty), 0);
      const total = entries.reduce((sum, [id,qty]) => { const p = allProducts.find(x => x.product_id === id); return sum + Number(p.price_eur || 0) * Number(qty); }, 0);
      document.getElementById('cart-count').textContent = count;
      document.getElementById('cart-subtitle').textContent = count + (count > 1 ? ' articles' : ' article');
      document.getElementById('cart-total').textContent = money(total);
      document.getElementById('checkout-btn').disabled = entries.length === 0;
      const box = document.getElementById('cart-items');
      if (!entries.length) { box.innerHTML = '<p style="color:var(--muted);padding:.8rem 0;">Votre panier est encore vide. Ajoutez un essentiel depuis la collection.</p>'; return; }
      box.innerHTML = entries.map(([id,qty]) => {
        const p = allProducts.find(x => x.product_id === id);
        return `<div class="cart-row"><div><strong>$${p.name}</strong><small>$${money(p.price_eur)} l’unité</small></div><div class="qty-control"><button class="btn-secondary" onclick="changeQty('$${id}',-1)" aria-label="Diminuer">−</button><strong>$${qty}</strong><button class="btn-secondary" onclick="changeQty('$${id}',1)" aria-label="Augmenter">+</button></div><strong>$${money(Number(p.price_eur)*Number(qty))}</strong><button class="btn-secondary" onclick="removeFromCart('$${id}')">Retirer</button></div>`;
      }).join('');
    }
    async function checkoutCart() {
      const jwtToken = sessionStorage.getItem('jwt_token');
      const userEmail = sessionStorage.getItem('user_email');
      if (!jwtToken || !userEmail) { alert('Connectez-vous avec votre compte client avant de valider votre panier.'); location.hash = '#account'; return; }
      const btn = document.getElementById('checkout-btn');
      const entries = Object.entries(cart).filter(([id,qty]) => qty > 0 && allProducts.some(p => p.product_id === id));
      if (!entries.length) return;
      btn.disabled = true; btn.textContent = 'Envoi des commandes…';
      const customerName = document.getElementById('customer-name').value.trim() || 'Client ATELIER NOIR';
      const completed = [];
      try {
        for (const [productId, qty] of entries) {
          const res = await fetch('/api/order', {
            method:'POST', headers:{'Content-Type':'application/json','Authorization':'Bearer '+jwtToken},
            body:JSON.stringify({product_id:productId,qty:Number(qty),customer_name:customerName,customer_email:userEmail})
          });
          const data = await res.json();
          if (!res.ok || data.error) throw new Error(data.error || 'Erreur pendant la commande de '+productId);
          completed.push(productId);
        }
        completed.forEach(id => delete cart[id]); saveCart();
        showToast('Commande transmise au service AWS pour '+completed.length+' ligne(s). Consultez le suivi ci-dessous.');
        await loadAll(); location.hash = '#orders';
      } catch (e) {
        completed.forEach(id => delete cart[id]); saveCart();
        showToast('Une partie du panier a été envoyée. Vérifiez le suivi des commandes avant de réessayer. Détail : '+e.message);
        await loadAll();
      } finally { btn.disabled = false; btn.textContent = 'Valider la commande'; }
    }
    window.addEventListener('hashchange', renderProducts);
    async function loadOrders() {
      const res = await fetch('/api/orders');
      const orders = await res.json();
      const tbody = document.getElementById('orders-body');
      if (!orders.length) {
        tbody.innerHTML = '<tr><td colspan="7" style="text-align:center;color:#64748b;">Aucune commande pour le moment.</td></tr>';
        return;
      }
      tbody.innerHTML = orders.map(o => `
        <tr>
          <td><strong>$${o.order_id}</strong><br><span style="font-size:0.78rem;color:#64748b;">$${o.created_at || ''}</span></td>
          <td>$${o.customer_name || '-'}<br><small style="color:#64748b;">$${o.customer_email || ''}</small></td>
          <td>$${o.product_summary || '-'}</td>
          <td><span class="$${o.status === 'SHIPPED' ? 'tag-shipped' : 'tag-pending'}">$${o.status}</span></td>
          <td>$${o.carrier_box ? `$${o.carrier_box}<br><small>$${o.box_dimensions || ''} ($${o.fill_rate_percent || 0}% rempli)</small>` : '<em>En attente du lancement Spot...</em>'}</td>
          <td><code>$${o.tracking_number || 'En attente...'}</code></td>
          <td>$${o.pdf_url ? `<a class="pdf-link" href="$${o.pdf_url}" target="_blank">📄 Ouvrir la Facture PDF</a>` : '<em>En attente du batch Spot...</em>'}</td>
        </tr>
      `).join('');
    }

    async function orderProduct(productId, btn) {
      // VERIFICATION OBLIGATOIRE DU TOKEN JWT
      const jwtToken = sessionStorage.getItem('jwt_token');
      const userEmail = sessionStorage.getItem('user_email');

      if (!jwtToken || !userEmail) {
        alert('⛔ Accès refusé : Vous devez créer un compte et vous connecter via Amazon Cognito pour pouvoir passer une commande !');
        return;
      }

      btn.disabled = true;
      const oldText = btn.textContent;
      btn.textContent = 'Appel Lambda...';
      try {
        const customer_name = document.getElementById('customer-name').value.trim() || 'Client CloudShop';
        const res = await fetch('/api/order', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': 'Bearer ' + jwtToken
          },
          body: JSON.stringify({ product_id: productId, qty: 1, customer_name, customer_email: userEmail })
        });
        const data = await res.json();
        showToast(`✅ Commande $${data.order_id} enregistrée pour $${userEmail} !`);
        await loadAll();
      } finally {
        btn.disabled = false;
        btn.textContent = oldText;
      }
    }

    async function loadAll() {
      await Promise.all([loadProducts(), loadOrders(), loadSpotStatus()]);
      renderCart();
    }
    window.addToCart = addToCart;
    window.changeQty = changeQty;
    window.removeFromCart = removeFromCart;
    window.clearCart = clearCart;
    window.checkoutCart = checkoutCart;
    window.loadProducts = loadProducts;

    loadAll().catch(e => showToast('Erreur de chargement : ' + e.message));
    setInterval(() => { loadOrders(); loadSpotStatus(); }, 5000);
  </script>
</body>
</html>
"""


class ShopHandler(BaseHTTPRequestHandler):
    def _send_json(self, code, payload):
        self.send_response(code)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.end_headers()
        self.wfile.write(json.dumps(payload, cls=DecimalEncoder).encode("utf-8"))

    def do_GET(self):
        if self.path in ("/", "/index.html"):
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.end_headers()
            self.wfile.write(HTML_PAGE.encode("utf-8"))
        elif self.path == "/api/products":
            ddb = boto3.resource("dynamodb", region_name=REGION)
            items = ddb.Table(PRODUCTS_TABLE).scan().get("Items", [])
            items.sort(key=lambda x: x.get("product_id", ""))
            self._send_json(200, items)
        elif self.path == "/api/orders":
            ddb = boto3.resource("dynamodb", region_name=REGION)
            orders = ddb.Table(ORDERS_TABLE).scan().get("Items", [])
            orders.sort(key=lambda x: x.get("created_at", ""), reverse=True)
            for o in orders:
                if o.get("invoice_s3_key"):
                    o["pdf_url"] = f"/api/invoice?key={urllib.parse.quote(o['invoice_s3_key'])}"
            self._send_json(200, orders)
        elif self.path.startswith("/api/invoice"):
            parsed = urllib.parse.urlparse(self.path)
            params = urllib.parse.parse_qs(parsed.query)
            key = params.get("key", [""])[0]
            if not key:
                self.send_response(400)
                self.end_headers()
                return
            s3 = boto3.client(
                "s3",
                region_name=REGION,
                endpoint_url=f"https://s3.{REGION}.amazonaws.com",
                config=Config(signature_version="s3v4"),
            )
            obj = s3.get_object(Bucket=INVOICES_BUCKET, Key=key)
            pdf_bytes = obj["Body"].read()
            filename = key.split("/")[-1]
            self.send_response(200)
            self.send_header("Content-Type", "application/pdf")
            self.send_header("Content-Disposition", f'inline; filename="{filename}"')
            self.send_header("Content-Length", str(len(pdf_bytes)))
            self.end_headers()
            self.wfile.write(pdf_bytes)
        elif self.path == "/api/spot-status":
            sqs = boto3.client("sqs", region_name=REGION)
            ec2 = boto3.client("ec2", region_name=REGION)
            attrs = sqs.get_queue_attributes(
                QueueUrl=SQS_QUEUE_URL,
                AttributeNames=["ApproximateNumberOfMessages", "ApproximateNumberOfMessagesNotVisible"],
            ).get("Attributes", {})
            pending = int(attrs.get("ApproximateNumberOfMessages", 0)) + int(attrs.get("ApproximateNumberOfMessagesNotVisible", 0))

            res = ec2.describe_instances(
                Filters=[{"Name": "tag:Role", "Values": ["spot-batch-worker"]}]
            )
            instances = []
            for r in res.get("Reservations", []):
                for inst in r.get("Instances", []):
                    instances.append({
                        "id": inst["InstanceId"],
                        "state": inst["State"]["Name"],
                    })
            self._send_json(200, {"sqs_pending": pending, "spot_instances": instances})
        elif self.path == "/health":
            self._send_json(200, {"status": "healthy", "instance": INSTANCE_ID})
        else:
            self.send_response(404)
            self.end_headers()

    def do_POST(self):
        try:
            length = int(self.headers.get("Content-Length", 0))
            raw = self.rfile.read(length).decode("utf-8") if length > 0 else ""
            body = json.loads(raw) if raw.strip() else {}

            if self.path == "/api/order":
                lmb = boto3.client("lambda", region_name=REGION)
                resp = lmb.invoke(
                    FunctionName=LAMBDA_NAME,
                    InvocationType="RequestResponse",
                    Payload=json.dumps(body),
                )
                result = json.loads(resp["Payload"].read().decode("utf-8"))
                self._send_json(200, result)
            elif self.path == "/api/subscribe":
                email = body.get("email", "").strip()
                sns = boto3.client("sns", region_name=REGION)
                filter_policy = json.dumps({"customer_email": [email]})
                sns.subscribe(
                    TopicArn=SNS_CONFIRM_ARN,
                    Protocol="email",
                    Endpoint=email,
                    Attributes={"FilterPolicy": filter_policy},
                )
                self._send_json(200, {
                    "status": "SUBSCRIBED",
                    "message": f"Abonnement SNS créé pour {email}.",
                })
            elif self.path == "/api/launch-spot":
                ec2 = boto3.client("ec2", region_name=REGION)
                inst_id = None
                mode_used = "EC2 Spot"
                for itype in ("t3.micro", "t3.small"):
                    try:
                        run_resp = ec2.run_instances(
                            LaunchTemplate={"LaunchTemplateId": SPOT_LT_ID, "Version": "$Latest"},
                            InstanceType=itype,
                            InstanceMarketOptions={
                                "MarketType": "spot",
                                "SpotOptions": {"SpotInstanceType": "one-time"},
                            },
                            MinCount=1,
                            MaxCount=1,
                        )
                        inst_id = run_resp["Instances"][0]["InstanceId"]
                        mode_used = f"EC2 Spot ({itype})"
                        break
                    except Exception:
                        continue
                if not inst_id:
                    run_resp = ec2.run_instances(
                        LaunchTemplate={"LaunchTemplateId": SPOT_LT_ID, "Version": "$Latest"},
                        InstanceType="t3.micro",
                        MinCount=1,
                        MaxCount=1,
                    )
                    inst_id = run_resp["Instances"][0]["InstanceId"]
                    mode_used = "EC2 Éphémère (Fallback Capacité Spot AWS -> Free Tier t3.micro)"
                self._send_json(200, {"status": "LAUNCHED", "instance_id": inst_id, "mode": mode_used})
            else:
                self.send_response(404)
                self.end_headers()
        except Exception as e:
            self._send_json(500, {"error": str(e)})


if __name__ == "__main__":
    HTTPServer(("0.0.0.0", 80), ShopHandler).serve_forever()
