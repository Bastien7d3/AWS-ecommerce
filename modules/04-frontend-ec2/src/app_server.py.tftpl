.art-caption { display:block; text-align:center; color:#F2ECFF; font-size:.78rem; margin-top:.8rem; letter-spacing:.08em; }

.main-layout { display:grid; grid-template-columns:minmax(0,1fr) 340px; gap:2rem; align-items:start; padding-top:3rem; padding-bottom:4rem; }
.section-head { display:flex; justify-content:space-between; align-items:end; gap:1rem; margin-bottom:1.4rem; }
.section-head h1,.section-head h2 { font-size:2rem; line-height:1.2; }
.section-kicker { margin-bottom:.35rem; color:var(--purple); }
.collection-note { color:var(--muted); font-size:.9rem; }
.filters { display:flex; gap:.55rem; flex-wrap:wrap; margin-bottom:1.4rem; }
.filters button { background:#fff; color:var(--muted); border:1px solid var(--line); }
.filters button[aria-pressed="true"] { background:var(--ink); color:white; border-color:var(--ink); }
.grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(205px,1fr)); gap:1rem; }
.prod {
  overflow:hidden; display:flex; flex-direction:column;
  background:#fff; border:1px solid var(--line); border-radius:22px;
  box-shadow:0 5px 20px #32234b07; transition:transform .22s,box-shadow .22s;
}
.prod:hover { transform:translateY(-4px); box-shadow:0 14px 30px #32234b12; }
.pic {
  height:180px; display:flex; align-items:center; justify-content:center;
  position:relative; overflow:hidden; background:var(--product-color,#FFB4C8);
}
.pic:before { content:""; position:absolute; width:150px; height:150px; border-radius:50%; background:#ffffff69; top:14px; }
.pic svg { position:relative; z-index:1; height:150px; width:120px; filter:drop-shadow(0 8px 8px #32234b15); }
.category-tag { position:absolute; bottom:10px; left:10px; background:#fffdf0dd; padding:.2rem .6rem; border-radius:999px; font-size:.68rem; font-weight:800; }
.prod-body { padding:1.1rem; display:flex; flex:1; flex-direction:column; gap:.45rem; }
.prod h3 { font-size:1.1rem; line-height:1.3; }
.desc { color:var(--muted); font-size:.88rem; flex:1; }
.stock { font-size:.78rem; font-weight:700; }
.available { color:var(--green); }
.unavailable { color:var(--red); }
.product-bottom { display:flex; align-items:center; justify-content:space-between; gap:.5rem; margin-top:.65rem; }
.price { font-size:1.05rem; font-weight:800; white-space:nowrap; }
.product-bottom button { font-size:.82rem; padding:.62rem .85rem; }

.cart {
  position:sticky; top:92px; background:white; border:1px solid var(--line);
  border-radius:24px; padding:1.3rem; box-shadow:0 12px 35px #32234b09;
}
.cart h2 { font-size:1.55rem; margin-bottom:.85rem; }
.line { display:grid; grid-template-columns:minmax(0,1fr) auto; gap:.45rem; padding:.85rem 0; border-bottom:1px solid var(--line); font-size:.88rem; }
.line small { display:block; color:var(--muted); }
.qty { display:flex; align-items:center; justify-content:flex-end; gap:.45rem; }
.quantity { padding:.12rem .55rem; min-width:30px; }
.subtotal { grid-column:2; text-align:right; }
.total { display:flex; justify-content:space-between; gap:.5rem; align-items:center; margin:1rem 0; padding-top:.25rem; }
.total strong { font-size:1.15rem; }
.account { background:#FFF9F5; border:1px solid var(--line); border-radius:16px; padding:1rem; margin:1rem 0; }
.account-actions,.cart-actions { display:flex; gap:.5rem; margin-top:.65rem; }
.account-actions button,.cart-actions button { flex:1; padding:.68rem .55rem; font-size:.81rem; }
.status,.fine-print,.empty { color:var(--muted); font-size:.83rem; margin-top:.6rem; overflow-wrap:anywhere; }
.err { color:var(--red); font-size:.85rem; margin-top:.5rem; min-height:1.2em; }
.fine-print { margin-top:1rem; line-height:1.5; }
footer { border-top:1px solid var(--line); padding:1.5rem 0; }
.footer-inner { display:flex; justify-content:space-between; align-items:center; gap:1rem; color:var(--muted); font-size:.85rem; }
.footer-inner .logo { color:var(--ink); }

.toast {
  position:fixed; z-index:20; right:20px; bottom:20px;
  max-width:min(420px,calc(100vw - 40px)); background:var(--ink); color:white;
  border-radius:14px; padding:1rem 1.2rem; opacity:0; transform:translateY(12px);
  pointer-events:none; transition:opacity .2s,transform .2s;
}
.toast.visible { opacity:1; transform:translateY(0); }
.thanks {
  display:none; position:fixed; inset:0; z-index:15; padding:1.5rem;
  align-items:center; justify-content:center; background:#25213bbb; backdrop-filter:blur(7px);
}
.thanks.open { display:flex; }
.thanks-card { background:white; padding:2rem; border-radius:26px; max-width:450px; width:100%; }
.thanks-card h2 { font-size:2rem; line-height:1.15; margin:.8rem 0; }
.thanks-card p { color:var(--muted); }
.success-mark { display:grid; place-items:center; width:48px; height:48px; border-radius:50%; background:#D7F7EB; color:#17674F; font-size:1.5rem; }
.ref { margin:1rem 0; background:var(--pink-light); padding:.8rem; border-radius:12px; font-weight:800; overflow-wrap:anywhere; }
.admin-main { padding-top:2.5rem; padding-bottom:3rem; }
.stats { display:grid; grid-template-columns:repeat(auto-fit,minmax(155px,1fr)); gap:1rem; margin:1.5rem 0; }
.stat { background:#fff; border:1px solid var(--line); border-radius:20px; padding:1.2rem; }
.stat b { display:block; font-size:2.1rem; line-height:1.2; color:var(--purple); overflow-wrap:anywhere; }
.stat span { color:var(--muted); font-size:.86rem; }
.panel { background:#fff; border:1px solid var(--line); border-radius:22px; padding:1.3rem; margin-bottom:1.5rem; }
.table-wrap { overflow-x:auto; }
table { width:100%; border-collapse:collapse; font-size:.85rem; }
th,td { text-align:left; vertical-align:top; border-bottom:1px solid var(--line); padding:.8rem .6rem; }
th { color:var(--muted); font-size:.75rem; }
td small { color:var(--muted); }
.tag { display:inline-block; border-radius:99px; padding:.2rem .6rem; font-size:.78rem; font-weight:800; white-space:nowrap; }
.tag.pending { background:#FFF0C7; color:#805700; }
.tag.shipped { background:#D7F7EB; color:#17674F; }
td a { color:#6D4AE8; font-weight:700; }
[hidden] { display:none !important; }
:focus-visible { outline:3px solid var(--purple); outline-offset:3px; }

@media(max-width:900px) {
  .main-layout { grid-template-columns:1fr; }
  .cart { position:static; }
  .hero-inner { grid-template-columns:1fr .8fr; gap:1rem; }
}
@media(max-width:650px) {
  .wrap { padding-left:1rem; padding-right:1rem; }
  .top-inner { align-items:flex-start; flex-direction:column; }
  nav { gap:.7rem; }
  nav a { font-size:.82rem; }
  .hero-inner { grid-template-columns:1fr; padding-top:3rem; padding-bottom:3rem; }
  .hero h1 { font-size:2.8rem; }
  .hero-art svg { max-height:245px; }
  .main-layout { padding-top:2rem; }
  .section-head { align-items:flex-start; flex-direction:column; }
  .collection-note { display:none; }
  .grid { grid-template-columns:repeat(auto-fill,minmax(160px,1fr)); }
  .footer-inner { flex-wrap:wrap; }
  .panel { padding:.8rem; }
}
"""


PAGES = {
    "/": ("text/html; charset=utf-8", SHOP_HTML),
    "/index.html": ("text/html; charset=utf-8", SHOP_HTML),
    "/admin": ("text/html; charset=utf-8", ADMIN_HTML),
    "/admin/": ("text/html; charset=utf-8", ADMIN_HTML),
    "/style.css": ("text/css; charset=utf-8", STYLE_CSS),
    "/config.js": ("application/javascript; charset=utf-8", CONFIG_JS),
}


# ----------------------------------------------------------------------
# ROUTES HTTP / API AWS
# ----------------------------------------------------------------------

class ShopHandler(BaseHTTPRequestHandler):
    def _send_json(self, code, payload):
        data = json.dumps(payload, cls=DecimalEncoder).encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(data)

    def _read_json(self):
        length = int(self.headers.get("Content-Length", 0))
        raw = self.rfile.read(length).decode("utf-8") if length > 0 else ""
        return json.loads(raw) if raw.strip() else {}

    def do_GET(self):
        parsed = urllib.parse.urlparse(self.path)
        path = parsed.path

        try:
            if path in PAGES:
                content_type, content = PAGES[path]
                data = content.encode("utf-8")

                self.send_response(200)
                self.send_header("Content-Type", content_type)
                self.send_header("Content-Length", str(len(data)))
                self.send_header(
                    "Cache-Control",
                    "no-store, no-cache, must-revalidate, max-age=0",
                )
                self.send_header("Pragma", "no-cache")
                self.send_header("Expires", "0")
                self.end_headers()
                self.wfile.write(data)
                return

            if path == "/health":
                self._send_json(200, {
                    "status": "healthy",
                    "instance": INSTANCE_ID,
                })
                return

            if path == "/api/products":
                ddb = boto3.resource("dynamodb", region_name=REGION)
                items = ddb.Table(PRODUCTS_TABLE).scan().get("Items", [])

                for product in items:
                    product["category"] = str(
                        product.get("category")
                        or product.get("categorie")
                        or ""
                    ).lower()

                items.sort(key=lambda item: item.get("product_id", ""))
                self._send_json(200, items)
                return

            if path == "/api/orders":
                ddb = boto3.resource("dynamodb", region_name=REGION)
                orders = ddb.Table(ORDERS_TABLE).scan().get("Items", [])
                orders.sort(
                    key=lambda item: item.get("created_at", ""),
                    reverse=True,
                )

                for order in orders:
                    if order.get("invoice_s3_key"):
                        order["pdf_url"] = (
                            "/api/invoice?key="
                            + urllib.parse.quote(order["invoice_s3_key"])
                        )

                self._send_json(200, orders)
                return

            if path == "/api/invoice":
                key = urllib.parse.parse_qs(parsed.query).get("key", [""])[0]

                if not key:
                    self._send_json(400, {"error": "Clé de facture manquante."})
                    return

                s3 = boto3.client(
                    "s3",
                    region_name=REGION,
                    endpoint_url=f"https://s3.{REGION}.amazonaws.com",
                    config=Config(signature_version="s3v4"),
                )

                obj = s3.get_object(Bucket=INVOICES_BUCKET, Key=key)
                pdf_bytes = obj["Body"].read()
                filename = key.split("/")[-1]

                self.send_response(200)
                self.send_header("Content-Type", "application/pdf")
                self.send_header(
                    "Content-Disposition",
                    f'inline; filename="{filename}"',
                )
                self.send_header("Content-Length", str(len(pdf_bytes)))
                self.send_header("Cache-Control", "no-store")
                self.end_headers()
                self.wfile.write(pdf_bytes)
                return

            if path == "/api/spot-status":
                sqs = boto3.client("sqs", region_name=REGION)
                ec2 = boto3.client("ec2", region_name=REGION)

                attrs = sqs.get_queue_attributes(
                    QueueUrl=SQS_QUEUE_URL,
                    AttributeNames=[
                        "ApproximateNumberOfMessages",
                        "ApproximateNumberOfMessagesNotVisible",
                    ],
                ).get("Attributes", {})

                pending = (
                    int(attrs.get("ApproximateNumberOfMessages", 0))
                    + int(attrs.get("ApproximateNumberOfMessagesNotVisible", 0))
                )

                result = ec2.describe_instances(
                    Filters=[
                        {
                            "Name": "tag:Role",
                            "Values": ["spot-batch-worker"],
                        }
                    ]
                )

                instances = [
                    {
                        "id": instance["InstanceId"],
                        "state": instance["State"]["Name"],
                    }
                    for reservation in result.get("Reservations", [])
                    for instance in reservation.get("Instances", [])
                ]

                self._send_json(200, {
                    "sqs_pending": pending,
                    "spot_instances": instances,
                })
                return

            if path == "/api/info":
                self._send_json(200, {
                    "instance": INSTANCE_ID,
                    "region": REGION,
                    "launch_template": SPOT_LT_ID,
                })
                return

            self._send_json(404, {"error": "Route introuvable."})

        except Exception as exc:
            self._send_json(500, {"error": str(exc)})

    def do_POST(self):
        path = urllib.parse.urlparse(self.path).path

        try:
            body = self._read_json()

            if path == "/api/order":
                customer_name = str(
                    body.get("customer_name", "")
                ).strip()[:80]
                customer_email = str(
                    body.get("customer_email", "")
                ).strip()[:120]

                # Accepte le format NÉOLIA (liste items) et le format
                # précédent (un seul product_id / qty).
                items = body.get("items")

                if not items and body.get("product_id"):
                    items = [{
                        "product_id": body.get("product_id"),
                        "qty": body.get("qty", 1),
                    }]

                if (
                    not customer_name
                    or not re.match(r"^\S+@\S+\.\S+$", customer_email)
                    or not isinstance(items, list)
                    or not items
                ):
                    self._send_json(400, {
                        "error": "Nom, e-mail et au moins un article sont requis."
                    })
                    return

                lambda_client = boto3.client("lambda", region_name=REGION)
                order_ids = []

                for item in items:
                    product_id = str(item.get("product_id", "")).strip()
                    try:
                        quantity = int(item.get("qty", 0))
                    except (TypeError, ValueError):
                        quantity = 0

                    if not product_id or quantity < 1:
                        self._send_json(400, {
                            "error": "Article ou quantité invalide."
                        })
                        return

                    payload = {
                        "product_id": product_id,
                        "qty": quantity,
                        "customer_name": customer_name,
                        "customer_email": customer_email,
                    }

                    result = lambda_client.invoke(
                        FunctionName=LAMBDA_NAME,
                        InvocationType="RequestResponse",
                        Payload=json.dumps(payload).encode("utf-8"),
                    )

                    if result.get("FunctionError"):
                        message = result["Payload"].read().decode("utf-8")
                        self._send_json(502, {
                            "error": "La fonction de commande a échoué.",
                            "detail": message,
                        })
                        return

                    response_text = result["Payload"].read().decode("utf-8")

                    try:
                        order_result = json.loads(response_text)
                    except json.JSONDecodeError:
                        self._send_json(502, {
                            "error": "Réponse invalide du service de commande."
                        })
                        return

                    if order_result.get("error"):
                        self._send_json(400, {
                            "error": order_result["error"]
                        })
                        return

                    order_id = order_result.get("order_id")
                    if order_id is not None:
                        order_ids.append(str(order_id))

                self._send_json(200, {
                    "status": "ok",
                    "order_ids": order_ids,
                })
                return

            if path == "/api/subscribe":
                email = str(body.get("email", "")).strip()

                if not re.match(r"^\S+@\S+\.\S+$", email):
                    self._send_json(400, {"error": "Adresse e-mail invalide."})
                    return

                sns = boto3.client("sns", region_name=REGION)
                subscription = sns.subscribe(
                    TopicArn=SNS_CONFIRM_ARN,
                    Protocol="email",
                    Endpoint=email,
                    Attributes={
                        "FilterPolicy": json.dumps({
                            "customer_email": [email]
                        })
                    },
                )

                self._send_json(200, {
                    "status": "SUBSCRIBED",
                    "subscription_arn": subscription.get("SubscriptionArn"),
                })
                return

            if path == "/api/launch-spot":
                ec2 = boto3.client("ec2", region_name=REGION)
                instance_id = None
                mode = "EC2 Spot"

                for instance_type in ("t3.micro", "t3.small"):
                    try:
                        response = ec2.run_instances(
                            LaunchTemplate={
                                "LaunchTemplateId": SPOT_LT_ID,
                                "Version": "$Latest",
                            },
                            InstanceType=instance_type,
                            InstanceMarketOptions={
                                "MarketType": "spot",
                                "SpotOptions": {
                                    "SpotInstanceType": "one-time"
                                },
                            },
                            MinCount=1,
                            MaxCount=1,
                        )

                        instance_id = response["Instances"][0]["InstanceId"]
                        mode = f"EC2 Spot ({instance_type})"
                        break
                    except Exception:
                        continue

                if not instance_id:
                    response = ec2.run_instances(
                        LaunchTemplate={
                            "LaunchTemplateId": SPOT_LT_ID,
                            "Version": "$Latest",
                        },
                        InstanceType="t3.micro",
                        MinCount=1,
                        MaxCount=1,
                    )

                    instance_id = response["Instances"][0]["InstanceId"]
                    mode = "EC2 éphémère (repli sans Spot)"

                self._send_json(200, {
                    "status": "LAUNCHED",
                    "instance_id": instance_id,
                    "mode": mode,
                })
                return

            self._send_json(404, {"error": "Route introuvable."})

        except Exception as exc:
            self._send_json(500, {"error": str(exc)})

    def log_message(self, fmt, *args):
        # Conserve des logs HTTP standards dans la sortie du service.
        super().log_message(fmt, *args)


if __name__ == "__main__":
    print(
        f"NÉOLIA — serveur web sur 0.0.0.0:80 "
        f"| {INSTANCE_ID} | région {REGION}",
        flush=True,
    )
    HTTPServer(("0.0.0.0", 80), ShopHandler).serve_forever()