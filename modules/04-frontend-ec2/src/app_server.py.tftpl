<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#34265F">
<title>NÉOLIA — La couleur du soin</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/style.css">
<script src="/config.js"></script>
<script src="https://cdn.jsdelivr.net/npm/amazon-cognito-identity-js@6.3.6/dist/amazon-cognito-identity.min.js"></script>
</head>
<body>
<header class="top">
  <div class="wrap top-inner">
    <a class="logo" href="/">NÉOLIA<span class="logo-dot">.</span></a>
    <nav>
      <a href="#collection">Collection</a>
      <a href="#account">Mon compte</a>
      <a href="#panier">Panier (<span id="count">0</span>)</a>
