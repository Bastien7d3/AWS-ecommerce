      <input id="a-pass" type="password" placeholder="Mot de passe" autocomplete="current-password">
      <div class="account-actions">
        <button class="ghost" type="button" id="a-reg">Créer un compte</button>
        <button class="ghost" type="button" id="a-log">Connexion</button>
      </div>
      <p class="status" id="a-status">Connectez-vous pour commander.</p>
    </section>

    <label for="name">Nom du client</label>
    <input id="name" type="text" autocomplete="name" placeholder="Votre nom">
    <p id="err" class="err" role="alert"></p>
    <div class="cart-actions">
      <button id="order" type="button" disabled>Commander</button>
      <button class="ghost" id="clear" type="button">Vider</button>
    </div>
    <p class="fine-print">Commande transmise au service AWS existant. Paiement simulé, aucun débit réel.</p>
  </aside>
</main>

<footer>
  <div class="wrap footer-inner">
    <a class="logo" href="/">NÉOLIA<span class="logo-dot">.</span></a>
    <span>La beauté en couleurs.</span>
    <a href="/admin">Espace administration</a>
  </div>
</footer>

<div class="toast" id="toast" role="status"></div>
<div class="thanks" id="thanks" role="dialog" aria-modal="true" aria-labelledby="t-title">
  <div class="thanks-card">
    <span class="success-mark">✓</span>
    <h2 id="t-title">Merci pour votre commande !</h2>
    <p>Votre commande a été transmise au service de traitement.</p>
    <p class="ref" id="t-ref"></p>
    <button id="t-close" type="button">Continuer mes achats</button>
  </div>
</div>

<script>
const CATS = {
  tous: 'Tout',
  visage: 'Visage',
  barbe: 'Barbe',
  corps: 'Corps',
  parfums: 'Parfums'
};

const COLORS = {
  visage: '#FFB4C8',
  barbe: '#FFC857',
  corps: '#9C8CFF',
  parfums: '#7EDCC5'
};

const CFG = window.APP_CONFIG || {};
const $ = id => document.getElementById(id);
const eur = v => Number(v || 0).toLocaleString('fr-FR', {
  style: 'currency', currency: 'EUR'
});
const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({
  '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;'
}[c]));

let products = [];
let cat = 'tous';
let cart = {};
let pool = null;
let token = sessionStorage.getItem('jwt_token');
let authEmail = sessionStorage.getItem('user_email');

try {
  cart = JSON.parse(localStorage.getItem('neolia_cart') || '{}') || {};
} catch (_) {
  cart = {};
}

function notify(message) {
  $('toast').textContent = message;
  $('toast').classList.add('visible');
  window.setTimeout(() => $('toast').classList.remove('visible'), 4500);
}

function bottle(category) {
  const color = COLORS[category] || '#FFB4C8';
  const shape = category === 'parfums'
    ? `<rect x="30" y="43" width="60" height="91" rx="10" fill="$${color}"/>
       <rect x="48" y="24" width="24" height="21" rx="3" fill="#34265F"/>
       <rect x="41" y="15" width="38" height="11" rx="3" fill="#FFD166"/>`
    : category === 'corps'
    ? `<path d="M35 135 L38 39 Q60 29 82 39 L85 135 Z" fill="$${color}"/>
       <rect x="46" y="17" width="28" height="25" rx="4" fill="#34265F"/>`
    : category === 'barbe'
    ? `<rect x="35" y="49" width="50" height="86" rx="8" fill="$${color}"/>
       <rect x="49" y="29" width="22" height="23" rx="3" fill="#34265F"/>
       <ellipse cx="60" cy="20" rx="10" ry="10" fill="#FFD166"/>`
    : `<rect x="30" y="43" width="60" height="92" rx="10" fill="$${color}"/>
       <rect x="49" y="20" width="22" height="25" rx="4" fill="#34265F"/>
       <rect x="43" y="12" width="34" height="10" rx="3" fill="#FFD166"/>`;

  return `<svg viewBox="0 0 120 150" aria-hidden="true">
    <ellipse cx="60" cy="140" rx="39" ry="5" fill="#34265F" opacity=".12"/>
    $${shape}
    <rect x="36" y="76" width="48" height="28" rx="3" fill="#FFF9F5" opacity=".86"/>
    <text x="60" y="88" text-anchor="middle" font-size="6" font-weight="bold" fill="#34265F">NÉOLIA</text>
    <text x="60" y="97" text-anchor="middle" font-size="5" fill="#34265F">ESSENTIEL</text>
  </svg>`;
}

function renderFilters() {
  $('filters').innerHTML = Object.entries(CATS).map(([key, label]) =>
    `<button type="button" data-c="$${key}" aria-pressed="$${key === cat}">$${label}</button>`
  ).join('');

  document.querySelectorAll('#filters button').forEach(button => {
    button.addEventListener('click', () => {
      cat = button.dataset.c;
      renderFilters();
      renderProducts();
    });
  });
}

function renderProducts() {
  const list = products.filter(p =>
    cat === 'tous' || String(p.category || p.categorie || '').toLowerCase() === cat
  );

  $('grid').innerHTML = list.length
    ? list.map(p => {
        const category = String(p.category || p.categorie || '').toLowerCase();
        const available = Number(p.stock || 0) > 0;

        return `<article class="prod">
          <div class="pic" style="--product-color:$${COLORS[category] || '#FFB4C8'}">
            $${bottle(category)}
            <span class="category-tag">$${esc(CATS[category] || 'Collection')}</span>
          </div>
          <div class="prod-body">
            <h3>$${esc(p.name || 'Produit NÉOLIA')}</h3>
            <p class="desc">$${esc(p.description || 'Un essentiel pour votre routine quotidienne.')}</p>
            <p class="stock $${available ? 'available' : 'unavailable'}">
              $${available ? 'En stock' : 'Épuisé'}
            </p>
            <div class="product-bottom">
              <span class="price">$${eur(p.price_eur)}</span>
              <button type="button" data-id="$${esc(p.product_id)}" $${available ? '' : 'disabled'}>
                Ajouter
              </button>
            </div>
          </div>
        </article>`;
      }).join('')
    : '<p class="empty">Aucun produit dans cette catégorie.</p>';

  document.querySelectorAll('#grid button[data-id]').forEach(button => {
    button.addEventListener('click', () => add(button.dataset.id));
  });
}

async function loadProducts() {
  const response = await fetch('/api/products', { cache: 'no-store' });
  if (!response.ok) throw new Error('Impossible de charger le catalogue.');
  products = await response.json();
  renderProducts();
  renderCart();
}

function saveCart() {
  localStorage.setItem('neolia_cart', JSON.stringify(cart));
  renderCart();
}

function add(id) {
  const product = products.find(p => p.product_id === id);
  if (!product) return;

  const quantity = Number(cart[id] || 0);
  if (quantity >= Number(product.stock || 0)) {
    notify('Stock maximal atteint pour ce produit.');
    return;
  }

  cart[id] = quantity + 1;
  saveCart();
  notify(product.name + ' ajouté au panier.');
}

function change(id, delta) {
  const product = products.find(p => p.product_id === id);
  const quantity = Number(cart[id] || 0) + delta;

  if (quantity <= 0) {
    delete cart[id];
  } else if (product && quantity <= Number(product.stock || 0)) {
    cart[id] = quantity;
  } else {
    notify('La quantité demandée dépasse le stock disponible.');
    return;
  }

  saveCart();
}

function renderCart() {
  const rows = Object.entries(cart).filter(([id, quantity]) =>
    Number(quantity) > 0 && products.some(p => p.product_id === id)
  );

  let total = 0;
  let count = 0;

  $('lines').innerHTML = rows.length
    ? rows.map(([id, quantity]) => {
        const p = products.find(x => x.product_id === id);
        const subtotal = Number(p.price_eur || 0) * Number(quantity);
        total += subtotal;
        count += Number(quantity);

        return `<div class="line">
          <div>
            <strong>$${esc(p.name)}</strong>
            <small>$${eur(p.price_eur)} l'unité</small>
          </div>
          <div class="qty">
            <button type="button" class="quantity" data-d="-1" data-id="$${esc(id)}" aria-label="Retirer un">−</button>
            <span>$${quantity}</span>
            <button type="button" class="quantity" data-d="1" data-id="$${esc(id)}" aria-label="Ajouter un">+</button>
          </div>
          <strong class="subtotal">$${eur(subtotal)}</strong>
        </div>`;
      }).join('')
    : '<p class="empty">Votre panier est vide. Découvrez les essentiels NÉOLIA.</p>';

  document.querySelectorAll('#lines button[data-id]').forEach(button => {
    button.addEventListener('click', () =>
      change(button.dataset.id, Number(button.dataset.d))
    );
  });

  $('total').textContent = eur(total);
  $('count').textContent = count;
  $('order').disabled = rows.length === 0;
}

$('clear').addEventListener('click', () => {
  cart = {};
  saveCart();
});

function updateAuthUI() {
  if (token && authEmail) {
    $('a-status').textContent = 'Connecté : ' + authEmail;
    $('a-email').value = authEmail;
    $('a-email').readOnly = true;
  }
}

if (CFG.auth && typeof AmazonCognitoIdentity !== 'undefined') {
  pool = new AmazonCognitoIdentity.CognitoUserPool({
    UserPoolId: CFG.userPoolId,
    ClientId: CFG.userPoolClientId
  });

  updateAuthUI();

  $('a-reg').addEventListener('click', () => {
    const email = $('a-email').value.trim();
    const password = $('a-pass').value;

    if (!email || !password) {
      $('a-status').textContent = 'Saisissez un e-mail et un mot de passe.';
      return;
    }

    const attributes = [
      new AmazonCognitoIdentity.CognitoUserAttribute({
        Name: 'email', Value: email
      })
    ];

    pool.signUp(email, password, attributes, null, async error => {
      if (error) {
        $('a-status').textContent = error.message;
        return;
      }

      try {
        await fetch('/api/subscribe', {
          method: 'POST',
          headers: {'Content-Type': 'application/json'},
          body: JSON.stringify({email})
        });
      } catch (_) {}

      $('a-status').textContent =
        'Compte créé. Vérifiez votre e-mail pour confirmer votre inscription.';
    });
  });

  $('a-log').addEventListener('click', () => {
    const email = $('a-email').value.trim();
    const password = $('a-pass').value;

    if (!email || !password) {
      $('a-status').textContent = 'Saisissez un e-mail et un mot de passe.';
      return;
    }

    const user = new AmazonCognitoIdentity.CognitoUser({
      Username: email,
      Pool: pool
    });

    user.authenticateUser(
      new AmazonCognitoIdentity.AuthenticationDetails({
        Username: email,
        Password: password
      }),
      {
        onSuccess: result => {
          token = result.getIdToken().getJwtToken();
          authEmail = email;

          sessionStorage.setItem('jwt_token', token);
          sessionStorage.setItem('user_email', email);

          updateAuthUI();
          $('a-status').textContent = 'Connexion réussie : ' + email;
          notify('Connexion réussie. Vous pouvez commander.');
        },
        onFailure: error => {
          $('a-status').textContent = error.message;
        }
      }
    );
  });
}

$('order').addEventListener('click', async () => {
  $('err').textContent = '';

  const name = $('name').value.trim();
  const email = authEmail || '';

  if (CFG.auth && !token) {
    $('err').textContent = 'Connectez-vous à votre compte avant de commander.';
    $('account').scrollIntoView({behavior: 'smooth'});
    return;
  }

  if (!name || !email) {
    $('err').textContent = 'Indiquez votre nom et connectez-vous avec votre compte client.';
    return;
  }

  const items = Object.entries(cart)
    .filter(([, quantity]) => Number(quantity) > 0)
    .map(([product_id, qty]) => ({product_id, qty: Number(qty)}));

  if (!items.length) return;

  const button = $('order');
  button.disabled = true;
  button.textContent = 'Envoi…';

  try {
    const response = await fetch('/api/order', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': 'Bearer ' + token
      },
      body: JSON.stringify({
        items,
        customer_name: name,
        customer_email: email
      })
    });

    const data = await response.json();

    if (!response.ok || data.error) {
      throw new Error(data.error || 'Commande impossible.');
    }

    $('t-ref').textContent =
      'Référence : ' + (data.order_ids || []).join(', ');

    $('thanks').classList.add('open');
    cart = {};
    saveCart();
    await loadProducts();
  } catch (error) {
    $('err').textContent = error.message;
  } finally {
    button.textContent = 'Commander';
    renderCart();
  }
});

$('t-close').addEventListener('click', () => {
  $('thanks').classList.remove('open');
});

renderFilters();
renderCart();
loadProducts().catch(error => {
  $('grid').textContent = error.message;
});
</script>
</body>
</html>
"""


# ----------------------------------------------------------------------
# ADMINISTRATION NÉOLIA
# ----------------------------------------------------------------------

ADMIN_HTML = r"""<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>NÉOLIA — Administration</title>
<link rel="stylesheet" href="/style.css">
<script src="/config.js"></script>
</head>
<body>
<header class="top">
  <div class="wrap top-inner">
    <a class="logo" href="/">NÉOLIA<span class="logo-dot">.</span> <span class="admin-mark">ADMIN</span></a>
    <nav><a href="/">Voir la boutique</a></nav>
  </div>
</header>

<main class="wrap admin-main">
  <div class="section-head">
    <div><p class="section-kicker">Pilotage</p><h1>Tableau de bord</h1></div>
    <button type="button" class="ghost" id="refresh">Actualiser</button>
  </div>

  <section class="stats">
    <article class="stat"><b id="s-total">0</b><span>Commandes</span></article>
    <article class="stat"><b id="s-pending">0</b><span>À expédier</span></article>
    <article class="stat"><b id="s-shipped">0</b><span>Expédiées</span></article>
    <article class="stat" id="revenue-box"><b id="s-revenue">0 €</b><span>Chiffre d'affaires</span></article>
  </section>

  <section class="panel" id="spot" hidden>
    <div class="section-head">
      <div><p class="section-kicker">Infrastructure</p><h2>Traitement par lot EC2 Spot</h2></div>
      <button id="spot-btn" type="button">Lancer une instance</button>
    </div>
    <p id="spot-status">Chargement de l'état de la file…</p>
    <p id="infra" class="status"></p>
  </section>

  <section class="panel">
    <div class="section-head">
      <div><p class="section-kicker">Suivi des ventes</p><h2>Toutes les commandes</h2></div>
    </div>
    <div class="table-wrap">
      <table>
        <thead><tr>
          <th>Commande</th><th>Client</th><th>Articles</th>
          <th>Statut</th><th>Expédition</th><th>Facture</th>
        </tr></thead>
        <tbody id="body"><tr><td colspan="6">Chargement…</td></tr></tbody>
      </table>
    </div>
  </section>
</main>

<div class="toast" id="toast" role="status"></div>

<script>
const CFG = window.APP_CONFIG || {};
const $ = id => document.getElementById(id);
const eur = v => Number(v || 0).toLocaleString('fr-FR', {
  style:'currency', currency:'EUR'
});
const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({
  '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;'
}[c]));

function notify(message) {
  $('toast').textContent = message;
  $('toast').classList.add('visible');
  window.setTimeout(() => $('toast').classList.remove('visible'), 4500);
}

async function load() {
  const response = await fetch('/api/orders', {cache:'no-store'});
  if (!response.ok) throw new Error('Impossible de charger les commandes.');

  const orders = await response.json();
  const shipped = orders.filter(o => o.status === 'SHIPPED').length;
  const hasTotal = orders.some(o => o.total_eur !== undefined);

  $('s-total').textContent = orders.length;
  $('s-shipped').textContent = shipped;
  $('s-pending').textContent = orders.length - shipped;
  $('revenue-box').hidden = !hasTotal;
  $('s-revenue').textContent = eur(
    orders.reduce((sum, o) => sum + Number(o.total_eur || 0), 0)
  );

  $('body').innerHTML = orders.length
    ? orders.map(o => `<tr>
        <td><strong>$${esc(o.order_id)}</strong><br>
          <small>$${esc((o.created_at || '').replace('T',' ').slice(0,16))}</small></td>
        <td>$${esc(o.customer_name || '-')}<br>
          <small>$${esc(o.customer_email || '')}</small></td>
        <td>$${esc(o.product_summary || '-')}
          $${o.total_eur !== undefined ? '<br><small>'+eur(o.total_eur)+'</small>' : ''}</td>
        <td><span class="tag $${o.status === 'SHIPPED' ? 'shipped' : 'pending'}">
          $${o.status === 'SHIPPED' ? 'Expédiée' : 'En attente'}
        </span></td>
        <td>$${o.carrier_box ? esc(o.carrier_box) : 'Traitement en attente'}
          $${o.tracking_number ? '<br><small>Suivi : '+esc(o.tracking_number)+'</small>' : ''}
        </td>
        <td>$${o.pdf_url
          ? '<a href="'+esc(o.pdf_url)+'" target="_blank" rel="noopener">Ouvrir la facture</a>'
          : '—'}
        </td>
      </tr>`).join('')
    : '<tr><td colspan="6">Aucune commande pour le moment.</td></tr>';
}

async function loadSpot() {
  const response = await fetch('/api/spot-status', {cache:'no-store'});
  if (!response.ok) throw new Error('Impossible de lire le statut Spot.');

  const data = await response.json();
  $('spot-status').textContent =
    'Messages SQS en attente : ' + data.sqs_pending +
    '. Instances Spot : ' +
    (data.spot_instances.length
      ? data.spot_instances.map(i => i.id + ' (' + i.state + ')').join(', ')
      : 'aucune instance active');
}

if (CFG.spot) {
  $('spot').hidden = false;

  fetch('/api/info', {cache:'no-store'})
    .then(response => response.json())
    .then(data => {
      $('infra').textContent =
        'Serveur : ' + data.instance + ' — région ' + data.region +
        ' — Launch Template ' + data.launch_template;
    })
    .catch(() => {});

  $('spot-btn').addEventListener('click', async () => {
    const button = $('spot-btn');
    button.disabled = true;

    try {
      const response = await fetch('/api/launch-spot', {
        method:'POST',
        headers:{'Content-Type':'application/json'},
        body:'{}'
      });
      const data = await response.json();

      if (!response.ok || data.error) throw new Error(data.error || 'Échec du lancement.');

      notify('Instance ' + data.instance_id + ' lancée (' + data.mode + ').');
      await loadSpot();
    } catch (error) {
      notify(error.message);
    } finally {
      button.disabled = false;
    }
  });

  loadSpot().catch(error => notify(error.message));
  window.setInterval(() => loadSpot().catch(() => {}), 5000);
}

$('refresh').addEventListener('click', () => {
  load().catch(error => notify(error.message));
});

load().catch(error => notify(error.message));
window.setInterval(() => load().catch(() => {}), 10000);
</script>
</body>
</html>
"""


# ----------------------------------------------------------------------
# STYLE NÉOLIA
# ----------------------------------------------------------------------

STYLE_CSS = r"""
:root {
  --ink:#25213B;
  --muted:#716B83;
  --paper:#FFF9F5;
  --white:#FFFFFF;
  --line:#F0E5E8;
  --pink:#FF6F91;
  --pink-light:#FFE0E8;
  --orange:#FF9F68;
  --yellow:#FFD166;
  --purple:#8C78FF;
  --mint:#7EDCC5;
  --blue:#8ED8F8;
  --green:#267B65;
  --red:#C83F60;
}
* { box-sizing:border-box; margin:0; padding:0; }
html { scroll-behavior:smooth; scroll-padding-top:90px; }
body {
  font-family:'DM Sans',system-ui,sans-serif;
  background:var(--paper);
  color:var(--ink);
  line-height:1.6;
}
h1,h2,h3,.logo,.stat b {
  font-family:'Manrope',system-ui,sans-serif;
  letter-spacing:-.045em;
}
a { color:inherit; }
button,input { font:inherit; }
button {
  border:0; border-radius:999px; padding:.75rem 1.1rem;
  background:var(--ink); color:#fff; font-weight:700;
  cursor:pointer; transition:transform .2s,background .2s,box-shadow .2s;
}
button:hover { background:var(--purple); transform:translateY(-1px); box-shadow:0 7px 20px #8c78ff33; }
button:disabled { opacity:.45; cursor:not-allowed; transform:none; box-shadow:none; }
button.ghost {
  background:#fff; color:var(--ink); border:1px solid var(--line);
}
button.ghost:hover { background:var(--pink-light); border-color:var(--pink); }
input {
  width:100%; padding:.75rem .85rem; border:1px solid var(--line);
  background:#fff; border-radius:12px; color:var(--ink);
}
input:focus { outline:3px solid #8c78ff30; border-color:var(--purple); }
label { display:block; font-size:.82rem; font-weight:700; color:var(--muted); margin:.8rem 0 .25rem; }
.wrap { max-width:1240px; margin:0 auto; padding:0 1.5rem; }

.top {
  position:sticky; top:0; z-index:5;
  background:#fff9f5ed; backdrop-filter:blur(16px);
  border-bottom:1px solid var(--line);
}
.top-inner { display:flex; justify-content:space-between; align-items:center; gap:1rem; padding-top:1rem; padding-bottom:1rem; }
.logo { font-size:1.65rem; font-weight:800; letter-spacing:-.075em; text-decoration:none; white-space:nowrap; }
.logo-dot { color:var(--pink); }
.admin-mark { font:700 .65rem 'DM Sans',sans-serif; color:var(--purple); letter-spacing:.13em; }
nav { display:flex; align-items:center; gap:1.3rem; flex-wrap:wrap; }
nav a { color:var(--muted); text-decoration:none; font-size:.9rem; font-weight:700; }
nav a:hover { color:var(--pink); }

.hero {
  overflow:hidden; color:#fff;
  background:linear-gradient(125deg,#34265F 0%,#6D4AE8 55%,#A77CFF 100%);
  border-radius:0 0 34px 34px; position:relative; isolation:isolate;
}
.hero:before {
  content:""; position:absolute; z-index:-1; width:350px; height:350px;
  border-radius:50%; background:var(--pink); opacity:.75;
  right:4%; top:-230px;
}
.hero:after {
  content:""; position:absolute; z-index:-1; width:220px; height:220px;
  border-radius:50%; background:var(--yellow); opacity:.8;
  right:32%; bottom:-170px;
}
.hero-inner { display:grid; grid-template-columns:1.2fr .8fr; align-items:center; gap:2rem; padding-top:4.7rem; padding-bottom:4.7rem; }
.eyebrow,.section-kicker {
  color:var(--pink); font-weight:800; text-transform:uppercase;
  letter-spacing:.18em; font-size:.73rem;
}
.hero .eyebrow { color:#FFD8E2; margin-bottom:1rem; }
.hero h1 { font-size:clamp(2.8rem,6vw,5.2rem); line-height:1.02; font-weight:800; max-width:11ch; }
.hero-intro { color:#F2ECFF; max-width:44ch; margin:1.35rem 0 1.7rem; font-size:1.05rem; }
.cta {
  display:inline-flex; gap:.8rem; align-items:center; text-decoration:none;
