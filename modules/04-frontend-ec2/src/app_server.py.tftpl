    .hero h1 { font-family:Georgia, "Times New Roman", serif; font-weight:normal; font-size:clamp(2.5rem, 5vw, 4.8rem); line-height:1.03; letter-spacing:-.035em; max-width:650px; }
    .hero-copy { color:#c9c5bb; max-width:460px; margin:1.3rem 0 1.6rem; font-size:1rem; }
