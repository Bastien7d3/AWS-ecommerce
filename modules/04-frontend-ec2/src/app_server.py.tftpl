      </p>
      <a class="cta" href="#collection">Explorer la collection <span>↗</span></a>
    </div>
    <div class="hero-art" aria-label="Illustration de flacons de soin" role="img">
      <svg viewBox="0 0 320 300" aria-hidden="true">
        <ellipse cx="160" cy="266" rx="142" ry="14" fill="#271C4E" opacity=".35"/>
        <g transform="rotate(-8 60 150)">
          <rect x="20" y="66" width="70" height="178" rx="14" fill="#FFB4C8"/>
          <rect x="40" y="39" width="30" height="31" rx="5" fill="#FFD166"/>
          <rect x="29" y="112" width="52" height="65" rx="5" fill="#FFE0E8"/>
          <text x="55" y="140" text-anchor="middle" fill="#34265F" font-size="8" font-weight="bold">NEOLIA</text>
          <text x="55" y="154" text-anchor="middle" fill="#34265F" font-size="6">SOIN</text>
        </g>
        <g>
          <rect x="112" y="104" width="89" height="142" rx="13" fill="#FFC857"/>
          <rect x="139" y="77" width="35" height="29" rx="4" fill="#34265F"/>
          <rect x="121" y="145" width="71" height="57" rx="5" fill="#FFE7A5"/>
          <text x="156" y="171" text-anchor="middle" fill="#34265F" font-size="9" font-weight="bold">NÉOLIA</text>
          <text x="156" y="184" text-anchor="middle" fill="#34265F" font-size="7">ÉQUILIBRE</text>
        </g>
        <g transform="rotate(8 255 155)">
          <rect x="222" y="78" width="64" height="166" rx="28" fill="#7EDCC5"/>
          <rect x="239" y="49" width="30" height="32" rx="4" fill="#8C78FF"/>
          <rect x="231" y="132" width="46" height="49" rx="5" fill="#D1F5EA"/>
          <text x="254" y="153" text-anchor="middle" fill="#34265F" font-size="8" font-weight="bold">NÉOLIA</text>
          <text x="254" y="165" text-anchor="middle" fill="#34265F" font-size="6">PARFUM</text>
        </g>
      </svg>
      <span class="art-caption">Des essentiels hauts en couleur</span>
    </div>
  </div>
</section>

<main class="wrap main-layout">
  <section id="collection" class="catalogue">
    <div class="section-head">
      <div>
        <p class="section-kicker">Notre univers</p>
        <h2>La collection</h2>
      </div>
      <span class="collection-note">Le soin, en couleurs.</span>
    </div>
    <div class="filters" id="filters" role="group" aria-label="Catégories"></div>
    <div class="grid" id="grid">Chargement de la collection…</div>
  </section>

  <aside class="cart" id="panier">
    <p class="section-kicker">Votre sélection</p>
    <h2>Votre panier</h2>
    <div id="lines"></div>
    <div class="total"><span>Total estimé</span><strong id="total">0,00 €</strong></div>

    <section id="account" class="account">
      <label for="a-email">E-mail du compte</label>
