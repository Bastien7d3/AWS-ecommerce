    pdf.set_x(18)
    pdf.set_font("Helvetica", "", 8.5)
    pdf.set_text_color(80, 75, 95)
    pdf.cell(42, 4.5, "N de suivi :")
    pdf.set_font("Helvetica", "B", 8.5)
    pdf.set_text_color(109, 74, 232)
    pdf.cell(47, 4.5, tracking_number)
    pdf.ln(4.5)
    
    pdf.set_x(18)
    pdf.set_font("Helvetica", "", 8.5)
    pdf.set_text_color(80, 75, 95)
    pdf.cell(42, 4.5, "Statut colis :")
    pdf.set_font("Helvetica", "B", 8.5)
    pdf.set_text_color(46, 125, 50)
