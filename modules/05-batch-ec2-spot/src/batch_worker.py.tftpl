    pdf.set_font("Helvetica", "B", 11)
    pdf.cell(34, 6.5, f"{ttc:.2f} EUR", align="R")
    
    pdf.output(output_path)
    return round(ttc, 2)


def get_instance_id():
    try:
        req = urllib.request.Request(
            "http://169.254.169.254/latest/api/token",
            headers={"X-aws-ec2-metadata-token-ttl-seconds": "60"},
            method="PUT",
        )
        token = urllib.request.urlopen(req, timeout=1).read().decode()
        req2 = urllib.request.Request(
            "http://169.254.169.254/latest/meta-data/instance-id",
            headers={"X-aws-ec2-metadata-token": token},
        )
        return urllib.request.urlopen(req2, timeout=1).read().decode()
    except Exception:
        return "ec2-spot-worker"


def get_front_public_url():
    # 1. Priorite au CDN HTTPS CloudFront s'il est deploye
    try:
        cf = boto3.client("cloudfront", region_name=REGION)
        dists = cf.list_distributions().get("DistributionList", {}).get("Items", [])
        for d in dists:
            if d.get("Enabled") and ("CloudShop" in d.get("Comment", "") or "alb" in json.dumps(d.get("Origins", {})).lower()):
                return f"https://{d['DomainName']}"
    except Exception:
        pass

    # 2. Sinon instance EC2 Front-End directe (Mode mono-instance)
    try:
        ec2 = boto3.client("ec2", region_name=REGION)
        res = ec2.describe_instances(
            Filters=[
                {"Name": "tag:Name", "Values": ["*front-ec2*"]},
                {"Name": "instance-state-name", "Values": ["running"]},
            ]
        )
        for r in res.get("Reservations", []):
            for inst in r.get("Instances", []):
                if inst.get("PublicIpAddress"):
                    return f"http://{inst['PublicIpAddress']}"
    except Exception:
        pass
    return None


def main():
    sqs = boto3.client("sqs", region_name=REGION)
    s3 = boto3.client(
        "s3",
        region_name=REGION,
        endpoint_url=f"https://s3.{REGION}.amazonaws.com",
        config=Config(signature_version="s3v4", s3={"addressing_style": "virtual"}),
    )
    ddb = boto3.resource("dynamodb", region_name=REGION).Table(DDB_ORDERS_TABLE)
    sns = boto3.client("sns", region_name=REGION)
    instance_id = get_instance_id()
    front_url = get_front_public_url()

    print(f"[Spot Worker {instance_id}] Demarrage du batch a la demande sur {SQS_QUEUE_URL}...")

    processed_count = 0
    empty_polls = 0

    # Lit toute la file SQS jusqu'a ce qu'elle soit vide (2 lectures vides consecutives), puis s'eteint !
    while empty_polls < 2:
        resp = sqs.receive_message(
            QueueUrl=SQS_QUEUE_URL,
            MaxNumberOfMessages=10,
            WaitTimeSeconds=5,
        )
        messages = resp.get("Messages", [])
        if not messages:
            empty_polls += 1
            continue

        empty_polls = 0
        for msg in messages:
            order = json.loads(msg["Body"])
            order_id = order["order_id"]
            customer_email = order.get("customer_email", "")

            packing = select_carrier_box(order.get("items", []))
            tracking_number = f"TRK-EUW3-2026-{uuid.uuid4().hex[:6].upper()}"

            local_pdf = f"/tmp/facture_{order_id}.pdf"
            total_ttc = generate_invoice_pdf(order, packing, tracking_number, instance_id, local_pdf)

            s3_key = f"invoices/facture_{order_id}.pdf"
            s3.upload_file(local_pdf, S3_BUCKET, s3_key, ExtraArgs={"ContentType": "application/pdf"})

            if front_url:
                invoice_link = f"{front_url}/api/invoice?key={urllib.parse.quote(s3_key)}"
            else:
                invoice_link = s3.generate_presigned_url(
                    "get_object",
                    Params={"Bucket": S3_BUCKET, "Key": s3_key},
                    ExpiresIn=86400,
                )

            processed_at = datetime.now(timezone.utc).strftime("%Y-%m-%d %H:%M:%S UTC")
            ddb.update_item(
                Key={"order_id": order_id},
                UpdateExpression=(
                    "SET #s = :s, carrier_box = :b, box_dimensions = :d, "
                    "total_weight_kg = :w, tracking_number = :t, invoice_s3_key = :k, "
                    "processed_by_spot = :i, processed_at = :p, fill_rate_percent = :f"
                ),
                ExpressionAttributeNames={"#s": "status"},
                ExpressionAttributeValues={
                    ":s": "SHIPPED",
                    ":b": packing["box_label"],
                    ":d": packing["box_dimensions_cm"],
                    ":w": str(packing["total_weight_kg"]),
                    ":t": tracking_number,
                    ":k": s3_key,
                    ":i": instance_id,
                    ":p": processed_at,
                    ":f": str(packing["fill_rate_percent"]),
                },
            )

            msg_attrs = {}
            if customer_email:
                msg_attrs["customer_email"] = {"DataType": "String", "StringValue": customer_email}

            customer_display = order.get('customer_name') or 'Chere cliente, cher client'
            raw_addr = order.get("shipping_address")
            if isinstance(raw_addr, dict):
                raw_addr = raw_addr.get("formatted") or raw_addr.get("street_address") or raw_addr.get("address")
            clean_addr = str(raw_addr or "").strip()
            if not clean_addr or clean_addr in ["[object Object]", "undefined", "null"]:
                clean_addr = "2 Rue de Lille, 75007 Paris" if "bastien" in customer_email.lower() else "12 Rue de la Paix, 75002 Paris"

            account_url = f"{front_url}/account" if front_url else invoice_link
            email_subject = f"[NEOLIA] Votre commande {order_id} a ete expediee"
            email_body = (
                f"Bonjour {customer_display},\n\n"
                f"Nous avons le plaisir de vous informer que votre commande {order_id} a ete preparee avec soin et confiee a notre transporteur partenaire Colissimo.\n\n"
                f"Details de votre livraison :\n"
                f"- Destinataire : {customer_display}\n"
                f"- Adresse de livraison : {clean_addr}\n"
                f"- Numero de suivi : {tracking_number}\n"
                f"- Mode d'envoi : Colissimo ({packing['box_label']})\n"
                f"- Montant total regle : {total_ttc:.2f} EUR\n\n"
                f"Vous pouvez consulter et telecharger votre facture officielle en vous connectant a votre espace client NEOLIA :\n"
                f"{account_url}\n\n"
                f"Toute l'equipe NEOLIA vous remercie pour votre confiance.\n\n"
                f"Bien chaleureusement,\n"
                f"L'equipe NEOLIA Paris\n"
                f"https://www.neolia.fr\n"
            )

            # Publie sur le Topic principal (deja confirme par le client)
            sns.publish(
                TopicArn=SNS_CONFIRM_ARN,
                Subject=email_subject,
                Message=email_body,
                MessageAttributes=msg_attrs,
            )

            sqs.delete_message(QueueUrl=SQS_QUEUE_URL, ReceiptHandle=msg["ReceiptHandle"])
            processed_count += 1
            print(f"[Spot Worker] Commande {order_id} -> SHIPPED ({tracking_number})")

    print(f"[Spot Worker {instance_id}] File SQS vide ({processed_count} commandes traitees). Remise a zero de l'ASG et auto-extinction...")
    try:
        asg = boto3.client("autoscaling", region_name=REGION)
        asg.set_desired_capacity(
            AutoScalingGroupName="cloudshop-spot-periodic-asg",
            DesiredCapacity=0,
            HonorCooldown=False,
        )
    except Exception as e:
        print(f"[Spot Worker] Info ASG scale-to-zero: {e}")
    os.system("sudo shutdown -h now || shutdown -h now")


if __name__ == "__main__":
    main()
