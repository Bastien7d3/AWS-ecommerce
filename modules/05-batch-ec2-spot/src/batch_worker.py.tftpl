    pdf.set_text_color(37, 33, 59)
    pdf.cell(35, 5, f"{shipping_ht:.2f} EUR", align="R")
    pdf.ln(5)
    
    pdf.set_x(right_x)
    pdf.set_text_color(90, 85, 105)
    pdf.cell(45, 5, "TVA legale (20,0 %) :", align="R")
