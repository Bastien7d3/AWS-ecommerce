    pdf.set_xy(128, 14)
    pdf.set_font("Helvetica", "B", 13)
    pdf.set_text_color(37, 33, 59)
    pdf.cell(64, 6, "FACTURE OFFICIELLE", align="R")
    pdf.ln(6)
    
    pdf.set_font("Helvetica", "", 8.5)
    pdf.set_text_color(80, 75, 95)
    
    now_str = datetime.now(timezone.utc).strftime("%d/%m/%Y")
    order_id = order.get("order_id", "CMD-000")
    
    pdf.set_x(128)
    pdf.cell(32, 5, "N de Facture :", align="L")
    pdf.set_font("Helvetica", "B", 8.5)
    pdf.cell(32, 5, f"FACT-{order_id}", align="R")
    pdf.ln(5)
    
    pdf.set_x(128)
    pdf.set_font("Helvetica", "", 8.5)
    pdf.cell(32, 5, "Date d'emission :", align="L")
    pdf.cell(32, 5, now_str, align="R")
    pdf.ln(5)
    
    pdf.set_x(128)
    pdf.cell(32, 5, "Reglement :", align="L")
    pdf.set_font("Helvetica", "B", 8.5)
    pdf.set_text_color(46, 125, 50) # Vert regle
    pdf.cell(32, 5, "Carte Bancaire (Paye)", align="R")
    
    # Ligne de separation
    pdf.set_draw_color(226, 222, 236)
    pdf.set_line_width(0.3)
    pdf.line(15, 49, 195, 49)
    
    # 2. CARTES EMETTEUR & DESTINATAIRE / LIVRAISON
    customer_name = order.get("customer_name") or "Client Neolia"
    customer_email = order.get("customer_email") or "client@neolia-paris.com"
    
    raw_addr = order.get("shipping_address")
    if isinstance(raw_addr, dict):
        raw_addr = raw_addr.get("formatted") or raw_addr.get("street_address") or raw_addr.get("address")
    shipping_address = str(raw_addr or "").strip()
    if not shipping_address or shipping_address in ["[object Object]", "undefined", "null"]:
        if "bastien" in customer_email.lower():
            shipping_address = "2 Rue de Lille, 75007 Paris"
        else:
            shipping_address = "12 Rue de la Paix, 75002 Paris"
    
    # Carte Gauche : Emetteur
    pdf.set_xy(15, 54)
    pdf.set_fill_color(252, 251, 254)
    pdf.set_draw_color(230, 227, 237)
    pdf.rect(15, 54, 85, 30, "FD")
    
    pdf.set_xy(18, 56)
    pdf.set_font("Helvetica", "B", 8)
    pdf.set_text_color(140, 132, 160)
    pdf.cell(79, 4, "EMETTEUR & SIEGE SOCIAL")
    pdf.ln(4)
    
    pdf.set_x(18)
    pdf.set_font("Helvetica", "B", 9.5)
    pdf.set_text_color(37, 33, 59)
    pdf.cell(79, 5, "NEOLIA Cosmetiques Paris")
    pdf.ln(5)
    
    pdf.set_x(18)
    pdf.set_font("Helvetica", "", 8.5)
    pdf.set_text_color(80, 75, 95)
    pdf.cell(79, 4, "12 Rue de la Paix")
    pdf.ln(4)
    pdf.set_x(18)
    pdf.cell(79, 4, "75002 Paris, France")
    pdf.ln(4)
    pdf.set_x(18)
    pdf.cell(79, 4, "RCS Paris B 894 123 456")
    
    # Carte Droite : Destinataire
    pdf.set_xy(105, 54)
    pdf.set_fill_color(248, 246, 252)
    pdf.set_draw_color(210, 205, 225)
    pdf.rect(105, 54, 90, 30, "FD")
    
    pdf.set_xy(108, 56)
    pdf.set_font("Helvetica", "B", 8)
    pdf.set_text_color(109, 74, 232) # Violet Neolia
    pdf.cell(84, 4, "DESTINATAIRE & ADRESSE DE LIVRAISON")
    pdf.ln(4)
    
    pdf.set_x(108)
    pdf.set_font("Helvetica", "B", 10)
    pdf.set_text_color(37, 33, 59)
