    pdf.ln(4)
    
    pdf.set_x(18)
    pdf.set_font("Helvetica", "", 8.5)
    pdf.set_text_color(80, 75, 95)
    pdf.cell(42, 4.5, "Transporteur :")
    pdf.set_font("Helvetica", "B", 8.5)
    pdf.set_text_color(37, 33, 59)
    pdf.cell(47, 4.5, f"Colissimo ({packing_info.get('box_label', 'Standard')})")
