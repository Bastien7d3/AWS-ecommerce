#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
Worker Batch EC2 Spot A La Demande / Periodique - CloudShop FISA 2026
Fonctionnement :
1. L'instance EC2 Spot est creee a la demande (par l'Admin ou par le Cron periodique EventBridge).
2. Au demarrage, elle depile TOUTES les commandes en attente dans la file SQS.
3. Pour chaque commande :
   - Calcule le carton transporteur optimal (S, M, L, XL)
   - Genere la facture PDF officielle (fpdf2) et l'archive sur Amazon S3
   - Met a jour la commande au statut SHIPPED dans DynamoDB
   - Envoie le mail SNS d'expedition avec le Numero de Suivi (filtre sur l'email du client)
4. Une fois la file SQS vide, l'instance Spot s'auto-detruit (shutdown -h now -> terminated)
   pour garantir un cout de 0,00 EUR au repos !
"""

import json
import os
import time
import uuid
import urllib.parse
import urllib.request
from datetime import datetime, timezone
import boto3
from botocore.config import Config
from fpdf import FPDF

REGION = "${region}"
SQS_QUEUE_URL = "${sqs_queue_url}"
S3_BUCKET = "${s3_bucket}"
DDB_ORDERS_TABLE = "${orders_table}"
SNS_SHIPPING_ARN = "${sns_shipping_arn}"
SNS_CONFIRM_ARN = "${sns_confirm_arn}"

CARRIER_BOXES = [
    {"code": "COLIS_S",  "label": "Colis S (Petit)",      "dims": (20, 15, 10),  "max_vol": 3000,   "max_weight": 2.0,   "shipping_cost": 4.90},
    {"code": "COLIS_M",  "label": "Colis M (Standard)",   "dims": (40, 30, 20),  "max_vol": 24000,  "max_weight": 10.0,  "shipping_cost": 8.90},
    {"code": "COLIS_L",  "label": "Colis L (Volumineux)", "dims": (60, 40, 40),  "max_vol": 96000,  "max_weight": 25.0,  "shipping_cost": 14.90},
    {"code": "COLIS_XL", "label": "Colis XL (Palette)",   "dims": (100, 60, 60), "max_vol": 360000, "max_weight": 100.0, "shipping_cost": 29.90},
]


def select_carrier_box(items):
    raw_volume_cm3 = 0.0
    total_weight_kg = 0.0
    max_single_dim = 0.0

    for item in items:
        qty = int(item.get("qty", 1))
        l, w, h = item.get("dims_cm", [10, 10, 5])
        weight = float(item.get("weight_kg", 0.5))
        raw_volume_cm3 += (l * w * h) * qty
        total_weight_kg += weight * qty
        max_single_dim = max(max_single_dim, max(l, w, h))

    padded_volume_cm3 = raw_volume_cm3 * 1.15

    selected = CARRIER_BOXES[-1]
    for box in CARRIER_BOXES:
        if (padded_volume_cm3 <= box["max_vol"]
                and total_weight_kg <= box["max_weight"]
                and max_single_dim <= max(box["dims"])):
            selected = box
            break

    fill_rate = min(100.0, round((padded_volume_cm3 / selected["max_vol"]) * 100, 1))
    return {
        "box_code": selected["code"],
        "box_label": selected["label"],
        "box_dimensions_cm": f"{selected['dims'][0]}x{selected['dims'][1]}x{selected['dims'][2]} cm",
        "padded_volume_cm3": round(padded_volume_cm3, 1),
        "fill_rate_percent": fill_rate,
        "total_weight_kg": round(total_weight_kg, 2),
        "shipping_cost_eur": selected["shipping_cost"],
    }


class NeoliaInvoice(FPDF):
    def __init__(self):
        super().__init__(orientation="P", unit="mm", format="A4")
        self.set_auto_page_break(auto=True, margin=20)

    def header(self):
        # Bandeau superieur aubergine #25213B
        self.set_fill_color(37, 33, 59)
        self.rect(0, 0, 210, 4, "F")

    def footer(self):
        self.set_y(-22)
        self.set_draw_color(226, 222, 236)
        self.set_line_width(0.3)
        self.line(15, self.get_y(), 195, self.get_y())
        
        self.set_y(-18)
        self.set_font("Helvetica", "I", 7.5)
        self.set_text_color(120, 115, 135)
        self.cell(0, 4, "Merci pour votre confiance. NEOLIA - La couleur et l'elegance du soin.", align="C")
        self.ln(4)
        self.cell(0, 4, f"NEOLIA SAS au capital de 50 000 EUR - 12 Rue de la Paix, 75002 Paris - RCS Paris 894 123 456 - Page {self.page_no()}", align="C")


def generate_invoice_pdf(order, packing_info, tracking_number, instance_id, output_path):
    pdf = NeoliaInvoice()
    pdf.add_page()
    
    # 1. EN-TETE NEOLIA HAUT DE GAMME
    pdf.set_xy(15, 12)
    pdf.set_font("Helvetica", "B", 22)
    pdf.set_text_color(37, 33, 59) # Aubergine #25213B
    pdf.cell(100, 9, "N E O L I A")
    pdf.ln(9)
    
    pdf.set_x(15)
    pdf.set_font("Helvetica", "B", 7)
    pdf.set_text_color(140, 132, 160)
    pdf.cell(100, 4, "H A U T E   C O S M E T I Q U E   -   P A R I S")
    pdf.ln(4)
    
    pdf.set_x(15)
    pdf.set_font("Helvetica", "", 8)
    pdf.set_text_color(90, 85, 105)
    pdf.cell(100, 4, "12 Rue de la Paix, 75002 Paris, France")
    pdf.ln(4)
    pdf.set_x(15)
    pdf.cell(100, 4, "contact@neolia-paris.com | www.neolia.fr")
    pdf.ln(4)
    pdf.set_x(15)
    pdf.cell(100, 4, "TVA Intracommunautaire : FR 84 894123456")
    
    # Bloc Facture a droite
    pdf.set_xy(125, 12)
    pdf.set_fill_color(248, 246, 252) # Fond lavande doux
    pdf.set_draw_color(226, 222, 236)
    pdf.set_line_width(0.4)
