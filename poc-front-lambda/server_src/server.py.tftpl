#!/usr/bin/env python3
import json
import time
import urllib.request
from http.server import HTTPServer, BaseHTTPRequestHandler
import boto3

REGION = "${region}"
LAMBDA_NAME = "${lambda_name}"

def get_instance_id():
    try:
        req = urllib.request.Request(
            "http://169.254.169.254/latest/api/token",
            headers={"X-aws-ec2-metadata-token-ttl-seconds": "60"},
            method="PUT"
        )
        token = urllib.request.urlopen(req, timeout=1).read().decode()
        req2 = urllib.request.Request(
            "http://169.254.169.254/latest/meta-data/instance-id",
            headers={"X-aws-ec2-metadata-token": token}
        )
        return urllib.request.urlopen(req2, timeout=1).read().decode()
    except Exception:
        return "ec2-front-local"

INSTANCE_ID = get_instance_id()

HTML_PAGE = """<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CloudShop AWS — Test Front EC2 & Lambda</title>
  <style>
    :root {
      --aws-navy: #232f3e;
      --aws-orange: #ff9900;
      --bg: #f8fafc;
      --card-bg: #ffffff;
      --text: #0f172a;
      --muted: #64748b;
      --success: #16a34a;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.6;
      padding-bottom: 2rem;
    }
    header {
      background: var(--aws-navy);
      color: white;
      padding: 1.5rem 2rem;
      border-bottom: 4px solid var(--aws-orange);
    }
    .header-content {
      max-width: 900px;
      margin: 0 auto;
    }
    .badge {
      display: inline-block;
      background: var(--aws-orange);
      color: #111;
      font-size: 0.8rem;
      font-weight: 700;
      padding: 0.2rem 0.6rem;
      border-radius: 9999px;
      margin-bottom: 0.5rem;
    }
    h1 { font-size: 1.8rem; }
    p.sub { color: #94a3b8; font-size: 0.95rem; }
    .container {
      max-width: 900px;
      margin: 2rem auto;
      padding: 0 1rem;
    }
    .grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .card {
      background: var(--card-bg);
      border-radius: 12px;
      padding: 1.5rem;
      box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05), 0 2px 4px -2px rgba(0,0,0,0.05);
      border: 1px solid #e2e8f0;
    }
    h2 {
      font-size: 1.25rem;
      color: var(--aws-navy);
      margin-bottom: 1rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .info-row {
      display: flex;
      justify-content: space-between;
      padding: 0.5rem 0;
      border-bottom: 1px solid #f1f5f9;
      font-size: 0.95rem;
    }
    .info-label { color: var(--muted); }
    .info-val { font-weight: 600; font-family: monospace; }
    button {
      background: var(--aws-orange);
      color: #111;
      border: none;
      font-size: 1.05rem;
      font-weight: 700;
      padding: 0.85rem 1.8rem;
      border-radius: 8px;
      cursor: pointer;
      transition: all 0.2s;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }
    button:hover { background: #f08c00; transform: translateY(-1px); }
    button:disabled { opacity: 0.6; cursor: not-allowed; }
    #result-box {
      margin-top: 1.5rem;
      display: none;
      background: #f8fafc;
      border: 1px solid #cbd5e1;
      border-radius: 8px;
      padding: 1rem;
    }
    #result-box.success {
      border-color: var(--success);
      background: #f0fdf4;
    }
    pre {
      background: #0f172a;
      color: #38bdf8;
      padding: 1rem;
      border-radius: 6px;
      overflow-x: auto;
      font-size: 0.85rem;
      margin-top: 0.5rem;
    }
  </style>
</head>
<body>
  <header>
    <div class="header-content">
      <span class="badge">FISA 2026 — Mode Itératif</span>
      <h1>Test d'Intégration Front-End EC2 & AWS Lambda</h1>
      <p class="sub">Vérification de la communication IaaS vers Serverless via IAM</p>
    </div>
  </header>

  <div class="container">
    <div class="grid">
      <div class="card">
        <h2>🖥️ Serveur Web Front-End (EC2)</h2>
        <div class="info-row">
          <span class="info-label">Instance EC2 ID :</span>
          <span class="info-val">""" + INSTANCE_ID + """</span>
        </div>
        <div class="info-row">
          <span class="info-label">Région AWS :</span>
          <span class="info-val">""" + REGION + """</span>
        </div>
        <div class="info-row">
          <span class="info-label">Type d'instance :</span>
          <span class="info-val">t3.micro (Free Tier)</span>
        </div>
        <div class="info-row">
          <span class="info-label">Cible Serverless configurée :</span>
          <span class="info-val">""" + LAMBDA_NAME + """</span>
        </div>
      </div>

      <div class="card">
        <h2>⚡ Appel Serverless (AWS Lambda)</h2>
        <p style="color: var(--muted); margin-bottom: 1.2rem;">
          Clique sur le bouton ci-dessous : le serveur Python sur cette machine EC2 va invoquer directement la fonction Lambda via le SDK AWS (Boto3) en utilisant le profil d'instance IAM (sans aucun identifiant codé en dur).
        </p>
        <button id="btn-invoke" onclick="invokeLambda()">
          <span>Exécuter la Lambda de test</span>
        </button>

        <div id="result-box">
          <p id="result-status" style="font-weight: 700; color: var(--success);"></p>
          <p id="result-perf" style="font-size: 0.9rem; color: var(--muted); margin-top: 0.2rem;"></p>
          <pre><code id="result-json"></code></pre>
        </div>
      </div>
    </div>
  </div>

  <script>
    async function invokeLambda() {
      const btn = document.getElementById('btn-invoke');
      const box = document.getElementById('result-box');
      const statusP = document.getElementById('result-status');
      const perfP = document.getElementById('result-perf');
      const jsonCode = document.getElementById('result-json');

      btn.disabled = true;
      btn.innerHTML = '<span>⏳ Invocation en cours...</span>';

      const startTime = performance.now();
      try {
        const res = await fetch('/api/invoke', { method: 'POST' });
        const data = await res.json();
        const duration = Math.round(performance.now() - startTime);

        box.style.display = 'block';
        box.className = 'success';
        statusP.textContent = '✅ Lambda exécutée avec succès ! (Code HTTP 200)';
        perfP.textContent = 'Durée totale aller-retour (EC2 -> Lambda -> EC2 -> Navigateur) : ' + duration + ' ms';
        jsonCode.textContent = JSON.stringify(data, null, 2);
      } catch (err) {
        box.style.display = 'block';
        box.className = '';
        statusP.textContent = '❌ Erreur lors de l invocation de la Lambda : ' + err.message;
        perfP.textContent = '';
        jsonCode.textContent = '';
      } finally {
        btn.disabled = false;
        btn.innerHTML = '<span>Exécuter à nouveau la Lambda</span>';
      }
    }
  </script>
</body>
</html>
"""

class RequestHandler(BaseHTTPRequestHandler):
    def do_GET(self):
        if self.path == "/" or self.path == "/index.html":
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.end_headers()
            self.wfile.write(HTML_PAGE.encode("utf-8"))
        elif self.path == "/health":
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            self.wfile.write(json.dumps({"status": "healthy"}).encode("utf-8"))
        else:
            self.send_response(404)
            self.end_headers()

    def do_POST(self):
        if self.path == "/api/invoke":
            try:
                lambda_client = boto3.client("lambda", region_name=REGION)
                response = lambda_client.invoke(
                    FunctionName=LAMBDA_NAME,
                    InvocationType="RequestResponse",
                    Payload=json.dumps({"invoked_by": INSTANCE_ID, "timestamp": time.time()})
                )
                payload_raw = response["Payload"].read().decode("utf-8")
                payload_json = json.loads(payload_raw)

                self.send_response(200)
                self.send_header("Content-Type", "application/json")
                self.end_headers()
                self.wfile.write(json.dumps(payload_json).encode("utf-8"))
            except Exception as e:
                self.send_response(500)
                self.send_header("Content-Type", "application/json")
                self.end_headers()
                self.wfile.write(json.dumps({"error": str(e)}).encode("utf-8"))
        else:
            self.send_response(404)
            self.end_headers()

if __name__ == "__main__":
    server = HTTPServer(("0.0.0.0", 80), RequestHandler)
    print("Serveur Web demarre sur le port 80...")
    server.serve_forever()
