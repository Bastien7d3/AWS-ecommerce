#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
PoC Worker Batch EC2 Spot - CloudShop FISA 2026
Taches executees :
1. Lecture des commandes en attente depuis Amazon SQS
2. Calcul de dimensionnement du colis avec tailles predefinies transporteur (S, M, L, XL)
3. Generation de la facture PDF officielle (fpdf2) + televersement sur Amazon S3
4. Mise a jour de l'etat de la commande dans DynamoDB (PENDING -> PACKAGED -> SHIPPED)
5. Publication de la confirmation d'expedition + Numero de suivi + Lien PDF sur Amazon SNS
"""

import json
import math
import time
import uuid
from datetime import datetime, timezone
import boto3
from fpdf import FPDF

REGION = "${region}"
SQS_QUEUE_URL = "${sqs_queue_url}"
S3_BUCKET = "${s3_bucket}"
DDB_TABLE = "${ddb_table}"
SNS_TOPIC_ARN = "${sns_topic_arn}"

# Tailles de cartons predefinies par le transporteur
CARRIER_BOXES = [
    {"code": "COLIS_S",  "label": "Colis S (Petit)",      "dims": (20, 15, 10),  "max_vol": 3000,   "max_weight": 2.0,   "shipping_cost": 4.90},
    {"code": "COLIS_M",  "label": "Colis M (Standard)",   "dims": (40, 30, 20),  "max_vol": 24000,  "max_weight": 10.0,  "shipping_cost": 8.90},
    {"code": "COLIS_L",  "label": "Colis L (Volumineux)", "dims": (60, 40, 40),  "max_vol": 96000,  "max_weight": 25.0,  "shipping_cost": 14.90},
    {"code": "COLIS_XL", "label": "Colis XL (Palette)",   "dims": (100, 60, 60), "max_vol": 360000, "max_weight": 100.0, "shipping_cost": 29.90},
]


def select_carrier_box(items):
    """Calcule le volume (avec 15% de marge de calage) et le poids total pour choisir le carton."""
    raw_volume_cm3 = 0.0
    total_weight_kg = 0.0
    max_single_dim = 0.0

    for item in items:
        qty = int(item.get("qty", 1))
        l, w, h = item.get("dims_cm", [10, 10, 5])
        weight = float(item.get("weight_kg", 0.5))
        raw_volume_cm3 += (l * w * h) * qty
        total_weight_kg += weight * qty
        max_single_dim = max(max_single_dim, max(l, w, h))

    padded_volume_cm3 = raw_volume_cm3 * 1.15  # +15% calage protection

    selected = CARRIER_BOXES[-1]
    for box in CARRIER_BOXES:
        box_max_dim = max(box["dims"])
        if (padded_volume_cm3 <= box["max_vol"]
                and total_weight_kg <= box["max_weight"]
                and max_single_dim <= box_max_dim):
            selected = box
            break

    fill_rate = min(100.0, round((padded_volume_cm3 / selected["max_vol"]) * 100, 1))
    return {
        "box_code": selected["code"],
        "box_label": selected["label"],
        "box_dimensions_cm": f"{selected['dims'][0]}x{selected['dims'][1]}x{selected['dims'][2]} cm",
        "raw_volume_cm3": round(raw_volume_cm3, 1),
        "padded_volume_cm3": round(padded_volume_cm3, 1),
        "box_max_volume_cm3": selected["max_vol"],
        "fill_rate_percent": fill_rate,
        "total_weight_kg": round(total_weight_kg, 2),
        "shipping_cost_eur": selected["shipping_cost"],
    }


class InvoicePDF(FPDF):
    def header(self):
        self.set_fill_color(35, 47, 62)  # Couleur AWS Dark Navy
        self.rect(0, 0, 210, 32, "F")
        self.set_text_color(255, 255, 255)
        self.set_font("Helvetica", "B", 18)
        self.set_xy(12, 8)
        self.cell(120, 10, "CLOUDSHOP AWS - FACTURE & COLISAGE", border=0)
        self.set_font("Helvetica", "", 10)
        self.set_xy(12, 18)
        self.cell(120, 8, "Projet FISA 2026 - Genere par Worker Batch EC2 Spot (eu-west-3)", border=0)
        self.ln(22)

    def footer(self):
        self.set_y(-18)
        self.set_font("Helvetica", "I", 8)
        self.set_text_color(110, 110, 110)
        self.cell(0, 10, f"CloudShop AWS Free Tier PoC - Compte 689505268069 - Page {self.page_no()}", align="C")


def generate_invoice_pdf(order, packing_info, tracking_number, instance_id, output_path):
    pdf = InvoicePDF()
    pdf.add_page()
    pdf.set_text_color(30, 30, 30)

    # Bloc Informations Commande & Client
    pdf.set_font("Helvetica", "B", 12)
    pdf.cell(100, 8, f"Commande N° : {order['order_id']}")
    pdf.cell(90, 8, f"Date : {datetime.now(timezone.utc).strftime('%d/%m/%Y %H:%M UTC')}", ln=True, align="R")

    pdf.set_font("Helvetica", "", 10)
    pdf.cell(100, 6, f"Client : {order.get('customer_name', 'Client CloudShop')}")
    pdf.cell(90, 6, f"Instance EC2 Spot : {instance_id}", ln=True, align="R")
    pdf.cell(100, 6, f"Destination : {order.get('shipping_address', 'Paris, France')}", ln=True)
    pdf.ln(6)

    # Tableau des produits commandes
    pdf.set_fill_color(255, 153, 0)  # Orange AWS
    pdf.set_text_color(255, 255, 255)
    pdf.set_font("Helvetica", "B", 10)
    pdf.cell(68, 8, " Article", border=1, fill=True)
    pdf.cell(32, 8, "Dims (cm)", border=1, fill=True, align="C")
    pdf.cell(22, 8, "Poids u.", border=1, fill=True, align="C")
    pdf.cell(16, 8, "Qte", border=1, fill=True, align="C")
    pdf.cell(26, 8, "Prix HT", border=1, fill=True, align="R")
    pdf.cell(26, 8, "Total HT", border=1, fill=True, align="R", ln=True)

    pdf.set_text_color(30, 30, 30)
    pdf.set_font("Helvetica", "", 9)
    total_ht = 0.0

    for item in order.get("items", []):
        qty = int(item.get("qty", 1))
        unit_price = float(item.get("price_eur", 0.0))
        line_ht = qty * unit_price
        total_ht += line_ht
        dims = item.get("dims_cm", [10, 10, 5])
        dims_str = f"{dims[0]}x{dims[1]}x{dims[2]}"
        weight_str = f"{item.get('weight_kg', 0.5)} kg"

        pdf.cell(68, 8, f" {item.get('name', 'Produit')}", border=1)
        pdf.cell(32, 8, dims_str, border=1, align="C")
        pdf.cell(22, 8, weight_str, border=1, align="C")
        pdf.cell(16, 8, str(qty), border=1, align="C")
        pdf.cell(26, 8, f"{unit_price:.2f} EUR", border=1, align="R")
        pdf.cell(26, 8, f"{line_ht:.2f} EUR", border=1, align="R", ln=True)

    shipping_ht = packing_info["shipping_cost_eur"]
    grand_ht = total_ht + shipping_ht
    tva = grand_ht * 0.20
    ttc = grand_ht + tva

    pdf.ln(3)
    pdf.set_font("Helvetica", "", 10)
    pdf.cell(138, 7, "Sous-total articles HT :", align="R")
    pdf.cell(52, 7, f"{total_ht:.2f} EUR", border=1, align="R", ln=True)
    pdf.cell(138, 7, f"Frais de port ({packing_info['box_label']}) HT :", align="R")
    pdf.cell(52, 7, f"{shipping_ht:.2f} EUR", border=1, align="R", ln=True)
    pdf.cell(138, 7, "TVA (20%) :", align="R")
    pdf.cell(52, 7, f"{tva:.2f} EUR", border=1, align="R", ln=True)

    pdf.set_font("Helvetica", "B", 11)
    pdf.set_fill_color(240, 244, 248)
    pdf.cell(138, 9, "TOTAL TTC A PAYER :", align="R")
    pdf.cell(52, 9, f"{ttc:.2f} EUR", border=1, fill=True, align="R", ln=True)

    # Encadre Logistique & Dimensionnement Colis Transporteur
    pdf.ln(8)
    pdf.set_fill_color(235, 245, 251)
    pdf.set_draw_color(41, 128, 185)
    pdf.set_font("Helvetica", "B", 11)
    pdf.cell(190, 9, "  FICHE LOGISTIQUE TRANSPORTEUR & SUIVI D'EXPEDITION (CALCUL EC2 SPOT)", border=1, fill=True, ln=True)

    pdf.set_font("Helvetica", "", 10)
    pdf.cell(95, 7, f"  Format de carton retenu : {packing_info['box_label']}", border="L")
    pdf.cell(95, 7, f"Dimensions carton : {packing_info['box_dimensions_cm']}", border="R", ln=True)
    pdf.cell(95, 7, f"  Volume articles (+15% calage) : {packing_info['padded_volume_cm3']} cm3", border="L")
    pdf.cell(95, 7, f"Taux de remplissage du carton : {packing_info['fill_rate_percent']} %", border="R", ln=True)
    pdf.cell(95, 7, f"  Poids total du colis : {packing_info['total_weight_kg']} kg", border="L")
    pdf.cell(95, 7, f"Statut de la commande : SHIPPED (Expediee)", border="R", ln=True)

    pdf.set_font("Helvetica", "B", 11)
    pdf.cell(190, 9, f"  NUMERO DE SUIVI TRANSPORTEUR : {tracking_number}", border="LBR", fill=True, ln=True)

    pdf.output(output_path)
    return round(ttc, 2)


def main():
    sqs = boto3.client("sqs", region_name=REGION)
    s3 = boto3.client("s3", region_name=REGION)
    ddb = boto3.resource("dynamodb", region_name=REGION).Table(DDB_TABLE)
    sns = boto3.client("sns", region_name=REGION)

    # Recuperation de l'ID de l'instance EC2 Spot via IMDSv2
    instance_id = "ec2-spot-worker"
    try:
        import urllib.request
        req_tok = urllib.request.Request(
            "http://169.254.169.254/latest/api/token",
            headers={"X-aws-ec2-metadata-token-ttl-seconds": "60"},
            method="PUT",
        )
        token = urllib.request.urlopen(req_tok, timeout=2).read().decode()
        req_id = urllib.request.Request(
            "http://169.254.169.254/latest/meta-data/instance-id",
            headers={"X-aws-ec2-metadata-token": token},
        )
        instance_id = urllib.request.urlopen(req_id, timeout=2).read().decode()
    except Exception:
        pass

    print(f"[Spot Worker {instance_id}] Demarrage du traitement batch SQS...")

    for _ in range(12):
        resp = sqs.receive_message(
            QueueUrl=SQS_QUEUE_URL,
            MaxNumberOfMessages=5,
            WaitTimeSeconds=5,
        )
        messages = resp.get("Messages", [])
        if not messages:
            time.sleep(2)
            continue

        for msg in messages:
            order = json.loads(msg["Body"])
            order_id = order["order_id"]
            print(f"[Spot Worker] Traitement de la commande {order_id}...")

            # 1. Calcul du colis optimal parmi les tailles predefinies
            packing = select_carrier_box(order.get("items", []))
            tracking_number = f"TRK-EUW3-2026-{uuid.uuid4().hex[:6].upper()}"

            # 2. Passage du statut a PACKAGED dans DynamoDB
            ddb.update_item(
                Key={"order_id": order_id},
                UpdateExpression="SET #s = :s, carrier_box = :b, box_dimensions = :d, total_weight_kg = :w",
                ExpressionAttributeNames={"#s": "status"},
                ExpressionAttributeValues={
                    ":s": "PACKAGED",
                    ":b": packing["box_label"],
                    ":d": packing["box_dimensions_cm"],
                    ":w": str(packing["total_weight_kg"]),
                },
            )

            # 3. Generation de la facture PDF sur l'EC2 Spot
            local_pdf = f"/tmp/facture_{order_id}.pdf"
            total_ttc = generate_invoice_pdf(order, packing, tracking_number, instance_id, local_pdf)

            # 4. Upload du PDF vers Amazon S3
            s3_key = f"invoices/facture_{order_id}.pdf"
            s3.upload_file(
                local_pdf,
                S3_BUCKET,
                s3_key,
                ExtraArgs={"ContentType": "application/pdf"},
            )

            presigned_url = s3.generate_presigned_url(
                "get_object",
                Params={"Bucket": S3_BUCKET, "Key": s3_key},
                ExpiresIn=86400,
            )

            # 5. Mise a jour finale du statut -> SHIPPED dans DynamoDB
            processed_at = datetime.now(timezone.utc).isoformat()
            ddb.update_item(
                Key={"order_id": order_id},
                UpdateExpression="SET #s = :s, tracking_number = :t, invoice_s3_key = :k, processed_by_spot = :i, processed_at = :p, fill_rate_percent = :f",
                ExpressionAttributeNames={"#s": "status"},
                ExpressionAttributeValues={
                    ":s": "SHIPPED",
                    ":t": tracking_number,
                    ":k": s3_key,
                    ":i": instance_id,
                    ":p": processed_at,
                    ":f": str(packing["fill_rate_percent"]),
                },
            )

            # 6. Publication de la notification d'expedition + Numero de suivi sur SNS
            sns_message = (
                f"Bonjour {order.get('customer_name', 'Client')},\n\n"
                f"Votre commande {order_id} a ete traitee par notre batch logistique (Instance EC2 Spot : {instance_id}).\n\n"
                f"--- DETAILS D'EXPEDITION ---\n"
                f"- Statut : SHIPPED (Expediee)\n"
                f"- Numero de suivi transporteur : {tracking_number}\n"
                f"- Format de colis retenu : {packing['box_label']} ({packing['box_dimensions_cm']})\n"
                f"- Poids total : {packing['total_weight_kg']} kg (Remplissage : {packing['fill_rate_percent']}%)\n"
                f"- Total TTC : {total_ttc:.2f} EUR\n\n"
                f"Telechargez votre facture PDF officielle :\n{presigned_url}\n"
            )
            sns.publish(
                TopicArn=SNS_TOPIC_ARN,
                Subject=f"[CloudShop] Commande {order_id} expediee ! Suivi : {tracking_number}",
                Message=sns_message,
            )

            # 7. Enregistrement d'un rapport JSON sur S3 pour verification
            report = {
                "order_id": order_id,
                "status": "SHIPPED",
                "tracking_number": tracking_number,
                "packing": packing,
                "total_ttc_eur": total_ttc,
                "invoice_s3_key": s3_key,
                "spot_instance_id": instance_id,
                "processed_at": processed_at,
            }
            s3.put_object(
                Bucket=S3_BUCKET,
                Key=f"reports/report_{order_id}.json",
                Body=json.dumps(report, indent=2).encode("utf-8"),
                ContentType="application/json",
            )

            # 8. Suppression du message de la file SQS
            sqs.delete_message(
                QueueUrl=SQS_QUEUE_URL,
                ReceiptHandle=msg["ReceiptHandle"],
            )
            print(f"[Spot Worker] Commande {order_id} SHIPPED avec succes ({tracking_number}).")
            return


if __name__ == "__main__":
    main()
